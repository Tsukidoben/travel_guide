<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>
    <property name="LOG_PATH" value="${LOG_ROOT:-./logs}/${APP_NAME}"/>
    <property name="ENCODING" value="UTF-8"/>
    <property name="MAX_HISTORY" value="30"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />



    <!-- 控制台 appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%t]){faint} %clr(%replace(%logger){'([a-z])[^.]*\.', '$1.'}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}
            </pattern>
            <charset>${ENCODING}</charset>
        </encoder>
    </appender>

    <!-- 定义异步输出的 Appender，包装控制台输出 -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 设置队列的深度，默认值为256，可根据需要调整 -->
        <queueSize>512</queueSize>
        <!-- 添加需要异步输出的 Appender -->
        <appender-ref ref="CONSOLE" />
    </appender>


    <!--info级别的日志打印配置-->
    <appender name="INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
            <level>DEBUG</level>
        </filter>
        <File>${LOG_PATH}/${APP_NAME}-info.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-all-%d{yyyyMMdd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS, UTC} %p [%logger{36}.%M\(\):%L] - %m%n</pattern>
            <charset>${ENCODING}</charset>
        </encoder>
    </appender>

    <!--error级别的日志打印配置-->
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <File>${LOG_PATH}/${APP_NAME}-error.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error-%d{yyyyMMdd}.log</fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS, UTC} %p [%logger{36}.%M\(\):%L] - %m%n</pattern>
            <charset>${ENCODING}</charset>
        </encoder>
    </appender>


    <!--开发环境:打印控制台和输出到文件-->
    <springProfile name="dev">
        <!--过滤掉spring和mybatis的一些无用的DEBUG信息-->
        <logger name="org.springframework" level="INFO"/>
        <logger name="com.own.mappers" level="DEBUG"/>
        <logger name="com.own" level="TRACE"/>
        <logger name="com.baomidou.mybatisplus" level="DEBUG"/>
        <logger name="com.baomidou.mybatisplus.core.MybatisConfiguration" level="ERROR"/>
        <logger name="com.baomidou.mybatisplus.core.MybatisConfiguration" level="ERROR"/>
        <logger name="com.baomidou.mybatisplus.extension.spring" level="ERROR"/>
        <logger name="com.own.mappers.SysLogsMapper" level="ERROR"/>
        <!-- 根据需要关闭不必要的日志输出 -->
        <root level="info">
            <appender-ref ref="ASYNC_CONSOLE"/>
        </root>
    </springProfile>

</configuration>


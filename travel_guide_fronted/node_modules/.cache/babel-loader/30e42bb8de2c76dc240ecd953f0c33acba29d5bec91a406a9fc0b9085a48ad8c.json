   v-model=\"formData.status\"\r\n                active-text=\"正常\"\r\n                active-value=\"1\"\r\n                inactive-value=\"2\"\r\n                inactive-text=\"下架\">\r\n            </el-switch>\r\n<!--            <el-select style=\"width: 100%;\" clearable v-model=\"formData.status\"  placeholder=\"请选择门票状态\">-->\r\n<!--              <el-option v-for=\"item in statusOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\"></el-option>-->\r\n<!--            </el-select>-->\r\n          </el-form-item>\r\n        </el-form>\r\n      </template>\r\n      <template #footer>\r\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\r\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\r\n      </template>\r\n    </own-sidebar-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport FormUtils from '@/utils/formUtils'\r\nimport request from \"@/utils/request\";\r\nimport config from \"@/config/config\";\r\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\r\n\r\nexport default {\r\n  name: \"TicketInfoForm\",\r\n  mixins: [FormUtils],\r\n  components: {OwnSidebarDialog },\r\n  data() {\r\n    return {\r\n      formData: {\r\n          attractionId: '',\r\n          ticketName: '',\r\n          ticketPrice: '',\r\n          useScope: '',\r\n          status: \"1\",\r\n      },\r\n      addUrl: '/ticketInfo/saveOrUpdate',\r\n      editUrl: '/ticketInfo/saveOrUpdate',\r\n      attractionIdOptions: [],\r\n      statusOptions: [{\"value\":\"1\",\"label\":\"正常\"},{\"value\":\"2\",\"label\":\"下架\"}],\r\n\r\n    };\r\n  },\r\n  methods: {\r\n    onInput(value,type) {\r\n      if (!value) {\r\n        this.$nextTick(()=>{\r\n          this.$set(this.formData, type, undefined);\r\n          setTimeout(()=>{\r\n            this.$set(this.formData, type, 1);\r\n          },10)\r\n        })\r\n      }\r\n    },\r\n    initForm(){\r\n        request({\r\n          url: config.backHost + \"/attractionInfo/listPage\",\r\n          data: {}\r\n        }).then(res => {\r\n          this.attractionIdOptions = res.data;\r\n        });\r\n\r\n    },\r\n    clearData(){\r\n      this.formData = {\r\n        attractionId: '',\r\n        ticketName: '',\r\n        ticketPrice: '',\r\n        useScope: '',\r\n        status: \"1\",\r\n      };\r\n    },\r\n    beforeSave() {\r\n      let message = '';\r\n      if (!this.formData.attractionId) {\r\n        message += \"所属景点不能为空<br>\";\r\n      }\r\n      if (!this.formData.ticketName) {\r\n        message += \"门票名称不能为空<br>\";\r\n      }\r\n      if (!this.formData.ticketPrice) {\r\n        message += \"门票价格不能为空<br>\";\r\n      }\r\n      if (!this.formData.useScope) {\r\n        message += \"使用范围不能为空<br>\";\r\n      }\r\n      if (!this.formData.status) {\r\n        message += \"门票状态不能为空<br>\";\r\n      }\r\n      return message;\r\n    },\r\n  }\r\n};\r\n</script>\r\n<style scoped lang=\"scss\">\r\n</style>\r\n"],"mappings":"AA0CA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAL,SAAA;EACAM,UAAA;IAAAH;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,YAAA;QACAC,UAAA;QACAC,WAAA;QACAC,QAAA;QACAC,MAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,mBAAA;MACAC,aAAA;QAAA;QAAA;MAAA;QAAA;QAAA;MAAA;IAEA;EACA;EACAC,OAAA;IACAC,QAAAC,KAAA,EAAAC,IAAA;MACA,KAAAD,KAAA;QACA,KAAAE,SAAA;UACA,KAAAC,IAAA,MAAAf,QAAA,EAAAa,IAAA,EAAAG,SAAA;UACAC,UAAA;YACA,KAAAF,IAAA,MAAAf,QAAA,EAAAa,IAAA;UACA;QACA;MACA;IACA;IACAK,SAAA;MACAzB,OAAA;QACA0B,GAAA,EAAAzB,MAAA,CAAA0B,QAAA;QACArB,IAAA;MACA,GAAAsB,IAAA,CAAAC,GAAA;QACA,KAAAd,mBAAA,GAAAc,GAAA,CAAAvB,IAAA;MACA;IAEA;IACAwB,UAAA;MACA,KAAAvB,QAAA;QACAC,YAAA;QACAC,UAAA;QACAC,WAAA;QACAC,QAAA;QACAC,MAAA;MACA;IACA;IACAmB,WAAA;MACA,IAAAC,OAAA;MACA,UAAAzB,QAAA,CAAAC,YAAA;QACAwB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAE,UAAA;QACAuB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAG,WAAA;QACAsB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAI,QAAA;QACAqB,OAAA;MACA;MACA,UAAAzB,QA
{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport FormUtils from '@/utils/formUtils';\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\nexport default {\n  name: \"FoodCategoryForm\",\n  mixins: [FormUtils],\n  components: {\n    OwnSidebarDialog\n  },\n  data() {\n    return {\n      formData: {\n        id: null,\n        name: ''\n      },\n      addUrl: '/api/food/category/saveOrUpdate',\n      editUrl: '/api/food/category/saveOrUpdate',\n      allCategoryList: [] // 所有分类列表，用于唯一性验证\n    };\n  },\n  methods: {\n    initForm() {\n      // 获取所有分类列表，用于唯一性验证\n      this.getAllCategories();\n    },\n    getAllCategories() {\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          this.allCategoryList = res.data || [];\n        }\n      });\n    },\n    clearData() {\n      this.formData = {\n        id: null,\n        name: ''\n      };\n      this.getAllCategories(); // 重新加载分类列表\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.name) {\n        message += \"分类名称不能为空<br>\";\n      }\n      // 验证分类名称是否重复\n      if (this.formData.name) {\n        const isDuplicate = this.allCategoryList.some(item => item.name === this.formData.name && item.id !== this.formData.id);\n        if (isDuplicate) {\n          message += \"分类名称已存在,请使用其他名称<br>\";\n        }\n      }\n      return message;\n    }\n  }\n};","map":{"version":3,"names":["FormUtils","request","config","OwnSidebarDialog","name","mixins","components","data","formData","id","addUrl","editUrl","allCategoryList","methods","initForm","getAllCategories","url","backHost","method","then","res","code","clearData","beforeSave","message","isDuplicate","some","item"],"sources":["src/views/manage/foodInfo/FoodCategoryForm.vue"],"sourcesContent":["<template>\n  <div class=\"form-box\">\n    <el-dialog top=\"10vh\" width=\"500px\" :title=\"title\" :visible.sync=\"visible\" :before-close=\"closeDialog\" :modal=\"true\" :close-on-click-modal=\"false\">\n      <template #default>\n        <el-form :model=\"formData\" ref=\"form\" label-width=\"auto\" style=\"padding: 0 20px\">\n          <el-form-item prop=\"name\" label=\"分类名称\">\n            <el-input type=\"text\" v-model=\"formData.name\" style=\"width: 100%\"  placeholder=\"请输入分类名称\"/>\n          </el-form-item>\n        </el-form>\n      </template>\n      <template #footer>\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport FormUtils from '@/utils/formUtils'\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\n\nexport default {\n  name: \"FoodCategoryForm\",\n  mixins: [FormUtils],\n  components: {OwnSidebarDialog },\n  data() {\n    return {\n      formData: {\n          id: null,\n          name: '',\n      },\n      addUrl: '/api/food/category/saveOrUpdate',\n      editUrl: '/api/food/category/saveOrUpdate',\n      allCategoryList: [], // 所有分类列表，用于唯一性验证\n\n    };\n  },\n  methods: {\n    initForm(){\n      // 获取所有分类列表，用于唯一性验证\n      this.getAllCategories();\n    },\n    getAllCategories() {\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          this.allCategoryList = res.data || [];\n        }\n      });\n    },\n    clearData(){\n      this.formData = {\n        id: null,\n        name: '',\n      };\n      this.getAllCategories(); // 重新加载分类列表\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.name) {\n        message += \"分类名称不能为空<br>\";\n      }\n      // 验证分类名称是否重复\n      if (this.formData.name) {\n        const isDuplicate = this.allCategoryList.some(item => \n          item.name === this.formData.name && item.id !== this.formData.id\n        );\n        if (isDuplicate) {\n          message += \"分类名称已存在,请使用其他名称<br>\";\n        }\n      }\n      return message;\n    },\n  }\n};\n</script>\n<style scoped lang=\"scss\">\n  ::v-deep .el-dialog__body{\n    max-height: 60vh;\n    overflow-x: hidden;\n    overflow-y: auto;\n  }\n</style>\n"],"mappings":";;AAmBA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAL,SAAA;EACAM,UAAA;IAAAH;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,EAAA;QACAL,IAAA;MACA;MACAM,MAAA;MACAC,OAAA;MACAC,eAAA;IAEA;EACA;EACAC,OAAA;IACAC,SAAA;MACA;MACA,KAAAC,gBAAA;IACA;IACAA,iBAAA;MACAd,OAAA;QACAe,GAAA,EAAAd,MAAA,CAAAe,QAAA;QACAC,MAAA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAT,eAAA,GAAAQ,GAAA,CAAAb,IAAA;QACA;MACA;IACA;IACAe,UAAA;MACA,KAAAd,QAAA;QACAC,EAAA;QACAL,IAAA;MACA;MACA,KAAAW,gBAAA;IACA;IACAQ,WAAA;MACA,IAAAC,OAAA;MACA,UAAAhB,QAAA,CAAAJ,IAAA;QACAoB,OAAA;MACA;MACA;MACA,SAAAhB,QAAA,CAAAJ,IAAA;QACA,MAAAqB,WAAA,QAAAb,eAAA,CAAAc,IAAA,CAAAC,IAAA,IACAA,IAAA,CAAAvB,IAAA,UAAAI,QAAA,CAAAJ,IAAA,IAAAuB,IAAA,CAAAlB,EAAA,UAAAD,QAAA,CAAAC,EACA;QACA,IAAAgB,WAAA;UACAD,OAAA;QACA;MACA;MACA,OAAAA,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
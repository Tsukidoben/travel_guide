{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodInfoForm from \"@/views/manage/foodInfo/FoodInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\nexport default {\n  name: \"FoodInfoList\",\n  components: {\n    FoodInfoForm,\n    SearchTop\n  },\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/info/delById/\",\n      delBatchUrl: \"/api/food/info/delBatch\",\n      searchList: [{\n        type: 'input',\n        name: '关键字',\n        placeholder: '小吃名称、店铺名',\n        value: 'keyword'\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/info/listPage\",\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    toggleStatus(row) {\n      const newStatus = row.status === 1 ? 0 : 1;\n      request({\n        url: config.backHost + \"/api/food/info/updateStatus\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          status: newStatus\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newStatus === 1 ? '上架成功' : '下架成功');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    },\n    toggleRecommend(row) {\n      const newRecommend = !row.isRecommend;\n      request({\n        url: config.backHost + \"/api/food/info/updateRecommend\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          isRecommend: newRecommend\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newRecommend ? '已设为首页推荐' : '已取消推荐');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","FoodInfoForm","SearchTop","common","name","components","mixins","data","delUrl","delBatchUrl","searchList","type","placeholder","value","computed","userRole","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","url","backHost","params","then","res","code","tableData","toggleStatus","row","newStatus","status","method","id","$message","success","toggleRecommend","newRecommend","isRecommend"],"sources":["src/views/manage/foodInfo/FoodInfoList.vue"],"sourcesContent":["<template>\n  <div class=\"own-mvue-list-box\">\n    <!--搜索区域-->\n    <div class=\"own-list-search-box\">\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\n    </div>\n    <div class=\"newTableStyle\">\n      <!--列表操作区域-->\n      <div v-if=\"userRole == '1'\" class=\"own-list-action-box\" style=\"display:block;\">\n        <el-button plain v-if=\"userRole == '1'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增小吃',null)\">新增</el-button>\n        <el-button plain v-if=\"userRole == '1'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\n      </div>\n      <!--列表数据区域-->\n      <div class=\"own-list-table-box\">\n        <!-- 表格内容 -->\n        <div class=\"own-list-table-data-box\">\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\n            <el-table-column type=\"selection\" width=\"55\" />\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\n            <el-table-column prop=\"foodPic\" label=\"小吃图片\" width=\"120\">\n              <template #default=\"{row}\">\n                <el-image :src=\"getPicUrlByJson(row.foodPic, 0)\" style=\"width: 80px; height: 60px\" fit=\"cover\"></el-image>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"foodName\" label=\"小吃名称\" width=\"150\"/>\n            <el-table-column prop=\"categoryName\" label=\"分类\" width=\"100\"/>\n            <el-table-column prop=\"shopName\" label=\"店铺\" width=\"150\"/>\n            <el-table-column prop=\"score\" label=\"评分\" width=\"100\">\n              <template #default=\"{row}\">\n                <el-rate v-model=\"row.score\" disabled show-score text-color=\"#ff9900\"></el-rate>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"avgPrice\" label=\"人均\" width=\"80\">\n              <template #default=\"{row}\">\n                ¥{{ row.avgPrice }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"isRecommend\" label=\"推荐\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-tag :type=\"row.isRecommend ? 'success' : 'info'\" size=\"mini\">\n                  {{ row.isRecommend ? '是' : '否' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"status\" label=\"状态\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-tag :type=\"row.status === 1 ? 'success' : 'danger'\" size=\"mini\">\n                  {{ row.status === 1 ? '上架' : '下架' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"250\">\n              <template #default=\"{ row }\">\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"openForm('edit', '编辑小吃', row)\">编辑</span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"toggleStatus(row)\">\n                  {{ row.status === 1 ? '下架' : '上架' }}\n                </span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"toggleRecommend(row)\">\n                  {{ row.isRecommend ? '取消推荐' : '设为首页推荐' }}\n                </span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;border-color: red\" @click=\"delById(row, delUrl)\">删除</span>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n\n        <!--分页区域-->\n        <el-pagination\n                :current-page=\"pageBean.page\"\n                :page-sizes=\"[10, 20, 50, 100]\"\n                :page-size=\"pageBean.pageSize\"\n                layout=\"total, sizes, prev, pager, next\"\n                :total=\"pageBean.total\"\n                @current-change=\"currPageChange\"\n                @size-change=\"handleSizeChange\" />\n      </div>\n    </div>\n    <!--表单-->\n    <FoodInfoForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\n  </div>\n</template>\n\n<script>\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodInfoForm from \"@/views/manage/foodInfo/FoodInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\n\nexport default {\n  name: \"FoodInfoList\",\n  components: { FoodInfoForm, SearchTop},\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/info/delById/\",\n      delBatchUrl: \"/api/food/info/delBatch\",\n      searchList: [\n        {type:'input',name:'关键字',placeholder:'小吃名称、店铺名',value:'keyword'},\n      ]\n    }\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    },\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData(){\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/info/listPage\",\n        data: { params: searchForm, pageBean: pageBean }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    toggleStatus(row) {\n      const newStatus = row.status === 1 ? 0 : 1;\n      request({\n        url: config.backHost + \"/api/food/info/updateStatus\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          status: newStatus\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newStatus === 1 ? '上架成功' : '下架成功');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    },\n    toggleRecommend(row) {\n      const newRecommend = !row.isRecommend;\n      request({\n        url: config.backHost + \"/api/food/info/updateRecommend\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          isRecommend: newRecommend\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newRecommend ? '已设为首页推荐' : '已取消推荐');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n@use \"@/assets/css/table.scss\";\n</style>\n"],"mappings":"AAmFA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,YAAA;AACA,OAAAC,SAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAJ,YAAA;IAAAC;EAAA;EACAI,MAAA,GAAAR,UAAA,EAAAK,MAAA;EACAI,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAP,IAAA;QAAAQ,WAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA,CAAAH,QAAA;IACA;EACA;EACAI,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAJ,SAAA,GACA;IACAC,MAAAC,UAAA,EAAAC,QAAA;MACAxB,OAAA;QACA0B,GAAA,EAAAzB,MAAA,CAAA0B,QAAA;QACAnB,IAAA;UAAAoB,MAAA,EAAAL,UAAA;UAAAC,QAAA,EAAAA;QAAA;MACA,GAAAK,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAAtB,IAAA;UACA,KAAAgB,QAAA,GAAAM,GAAA,CAAAN,QAAA;QACA;MACA;IACA;IACAS,aAAAC,GAAA;MACA,MAAAC,SAAA,GAAAD,GAAA,CAAAE,MAAA;MACApC,OAAA;QACA0B,GAAA,EAAAzB,MAAA,CAAA0B,QAAA;QACAU,MAAA;QACA7B,IAAA;UACA8B,EAAA,EAAAJ,GAAA,CAAAI,EAAA;UACAF,MAAA,EAAAD;QACA;MACA,GAAAN,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAQ,QAAA,CAAAC,OAAA,CAAAL,SAAA;UACA,KAAAb,KAAA,MAAAC,UAAA,OAAAC,QAAA;QACA;MACA;IACA;IACAiB,gBAAAP,GAAA;MACA,MAAAQ,YAAA,IAAAR,GAAA,CAAAS,WAAA;MACA3C,OAAA;QACA0B,GAAA,EAAAzB,MAAA,CAAA0B,QAAA;QACAU,MAAA;QACA7B,IAAA;UACA8B,EAAA,EAAAJ,GAAA,CAAAI,EAAA;UACAK,WAAA,EAAAD;QACA;MACA,GAAAb,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAQ,QAAA,CAAAC,OAAA,CAAAE,YAAA;UACA,KAAApB,KAAA,MAAAC,UAAA,OAAAC,QAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
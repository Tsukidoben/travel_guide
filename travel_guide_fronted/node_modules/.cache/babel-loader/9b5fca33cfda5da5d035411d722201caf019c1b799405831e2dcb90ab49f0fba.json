{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport SearchTop from \"@/components/searchTop.vue\";\nexport default {\n  name: \"AttractionOrderList\",\n  components: {\n    SearchTop\n  },\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/attractionOrder/delById/\",\n      attractionIdOptions: [],\n      orderStateOptions: [{\n        \"value\": \"10\",\n        \"label\": \"待付款\"\n      }, {\n        \"value\": \"20\",\n        \"label\": \"待核销\"\n      }, {\n        \"value\": \"80\",\n        \"label\": \"已核销\"\n      }, {\n        \"value\": \"-1\",\n        \"label\": \"已取消\"\n      }],\n      ticketIdOptions: [],\n      ticketVisible: false,\n      activeTicket: null,\n      searchList: [{\n        type: 'select',\n        name: '景点',\n        placeholder: '选择景点',\n        value: 'attractionId',\n        isApiData: true,\n        apiConfig: {\n          url: '/attractionInfo/listPage',\n          data: {}\n        },\n        key: 'id',\n        label: 'attractionName'\n      }, {\n        type: 'input',\n        name: '订单号',\n        placeholder: '输入订单编码',\n        value: 'orderCode'\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      const user = this.$store.getters.getUser;\n      return user ? user.userRole : null;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    showTicketCode(row) {\n      this.activeTicket = row;\n      this.ticketVisible = true;\n    },\n    handlePay(row) {\n      this.$confirm('确认支付该门票订单吗？', '提示', {\n        type: 'success'\n      }).then(() => {\n        request({\n          url: config.backHost + \"/attractionOrder/payById/\" + row.id\n        }).then(res => {\n          if (res.code === 200) {\n            document.querySelector(\"body\").innerHTML = res.data;\n            document.forms[0].submit();\n          }\n        });\n      });\n    },\n    handleCancel(row) {\n      this.$confirm('确定取消该订单吗？', '警告', {\n        type: 'warning'\n      }).then(() => {\n        request({\n          url: config.backHost + \"/attractionOrder/cancel/\" + row.id\n        }).then(res => {\n          if (res.code === 200) {\n            this.$message.success(\"订单已取消\");\n            this.query(this.searchForm, this.pageBean);\n          }\n        });\n      });\n    },\n    getStateTag(state) {\n      const map = {\n        \"10\": \"danger\",\n        \"20\": \"warning\",\n        \"80\": \"success\",\n        \"-1\": \"info\"\n      };\n      return map[state] || \"info\";\n    },\n    initData() {\n      request({\n        url: config.backHost + \"/attractionInfo/listPage\",\n        data: {}\n      }).then(res => {\n        this.attractionIdOptions = res.data;\n      });\n      request({\n        url: config.backHost + \"/ticketInfo/listPage\",\n        data: {}\n      }).then(res => {\n        this.ticketIdOptions = res.data;\n      });\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/attractionOrder/listPage\",\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","SearchTop","name","components","mixins","data","delUrl","attractionIdOptions","orderStateOptions","ticketIdOptions","ticketVisible","activeTicket","searchList","type","placeholder","value","isApiData","apiConfig","url","key","label","computed","userRole","user","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","showTicketCode","row","handlePay","$confirm","then","backHost","id","res","code","document","querySelector","innerHTML","forms","submit","handleCancel","$message","success","getStateTag","state","map","params","tableData"],"sources":["src/views/front/ticketOrder/ticketOrder.vue"],"sourcesContent":["<template>\r\n  <div class=\"own-mvue-list-box\">\r\n    <div class=\"own-list-search-box\">\r\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\r\n    </div>\r\n\r\n    <div class=\"newTableStyle\">\r\n      <div class=\"own-list-table-box\">\r\n        <div class=\"own-list-table-data-box\">\r\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\r\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\r\n            <el-table-column prop=\"orderCode\" label=\"订单编码\" width=\"180\"/>\r\n            <el-table-column prop=\"attractionId\" label=\"景点名称\">\r\n              <template #default=\"{row}\">\r\n                <span style=\"font-weight: bold; color: #303133;\">{{ attractionIdOptions?.find(i=>i.id == row.attractionId)?.attractionName || '未知景点' }}</span>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"ticketId\" label=\"门票类型\">\r\n              <template #default=\"{row}\">\r\n                <el-tag size=\"small\" type=\"info\">{{ ticketIdOptions?.find(i=>i.id == row.ticketId)?.ticketName || '普通票' }}</el-tag>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"buyCount\" label=\"张数\" width=\"80\"/>\r\n            <el-table-column prop=\"totalPrice\" label=\"支付金额\">\r\n              <template #default=\"{row}\">\r\n                <span style=\"color: #f56c6c; font-weight: bold; font-size: 16px;\">￥{{ row.totalPrice }}</span>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"orderState\" label=\"订单状态\">\r\n              <template #default=\"{row}\">\r\n                <el-tag :type=\"getStateTag(row.orderState)\" effect=\"dark\">\r\n                  {{ orderStateOptions?.find(i=>i.value == row.orderState)?.label }}\r\n                </el-tag>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"createTime\" label=\"预约时间\" width=\"160\"/>\r\n\r\n            <el-table-column fixed=\"right\" label=\"操作\" width=\"200\">\r\n              <template #default=\"{ row }\">\r\n                <template v-if=\"row.orderState == '10'\">\r\n                  <el-button type=\"text\" size=\"small\" icon=\"el-icon-wallet\" @click=\"handlePay(row)\">去支付</el-button>\r\n                  <el-button type=\"text\" size=\"small\" style=\"color: #909399\" icon=\"el-icon-close\" @click=\"handleCancel(row)\">取消订单</el-button>\r\n                </template>\r\n\r\n                <template v-if=\"row.orderState == '-1'\">\r\n                  <el-button type=\"text\" size=\"small\" style=\"color: #f56c6c\" icon=\"el-icon-delete\" @click=\"delById(row, delUrl)\">删除</el-button>\r\n                </template>\r\n\r\n                <template v-if=\"row.orderState == '20' && userRole == '2'\">\r\n                  <el-button type=\"text\" size=\"small\" icon=\"el-icon-view\" style=\"color: #E6A23C\" @click=\"showTicketCode(row)\">查看码</el-button>\r\n                </template>\r\n              </template>\r\n            </el-table-column>\r\n          </el-table>\r\n        </div>\r\n\r\n        <el-pagination :current-page=\"pageBean.page\" :page-sizes=\"[10, 20, 50, 100]\" :page-size=\"pageBean.pageSize\" layout=\"total, sizes, prev, pager, next\" :total=\"pageBean.total\" @current-change=\"currPageChange\" @size-change=\"handleSizeChange\" />\r\n      </div>\r\n    </div>\r\n\r\n    <el-dialog title=\"门票入园凭证\" :visible.sync=\"ticketVisible\" width=\"400px\" center>\r\n      <div class=\"ticket-display-card\" v-if=\"activeTicket\" style=\"padding-bottom: 30px\">\r\n        <p class=\"tip\">请向景区工作人员出示此 8 位核销码</p>\r\n        <div class=\"code-number\">{{ activeTicket.captcha }}</div>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport TableUtils from \"@/utils/tableUtils\";\r\nimport request from \"@/utils/request\";\r\nimport config from \"@/config/config\";\r\nimport SearchTop from \"@/components/searchTop.vue\";\r\n\r\nexport default {\r\n  name: \"AttractionOrderList\",\r\n  components: { SearchTop },\r\n  mixins: [TableUtils],\r\n  data() {\r\n    return {\r\n      delUrl: \"/attractionOrder/delById/\",\r\n      attractionIdOptions: [],\r\n      orderStateOptions: [\r\n        {\"value\":\"10\",\"label\":\"待付款\"},\r\n        {\"value\":\"20\",\"label\":\"待核销\"},\r\n        {\"value\":\"80\",\"label\":\"已核销\"},\r\n        {\"value\":\"-1\",\"label\":\"已取消\"}\r\n      ],\r\n      ticketIdOptions: [],\r\n      ticketVisible: false,\r\n      activeTicket: null,\r\n      searchList: [\r\n        {type:'select',name:'景点',placeholder:'选择景点',value:'attractionId', isApiData: true, apiConfig:{url: '/attractionInfo/listPage', data: {}}, key: 'id' ,label: 'attractionName'},\r\n        {type:'input',name:'订单号',placeholder:'输入订单编码',value:'orderCode'},\r\n      ],\r\n    }\r\n  },\r\n  computed: {\r\n    userRole() { \r\n      const user = this.$store.getters.getUser;\r\n      return user ? user.userRole : null;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.initData();\r\n    this.query(this.searchForm, this.pageBean);\r\n  },\r\n  methods: {\r\n    showTicketCode(row) {\r\n      this.activeTicket = row;\r\n      this.ticketVisible = true;\r\n    },\r\n    handlePay(row) {\r\n      this.$confirm('确认支付该门票订单吗？', '提示', { type: 'success' }).then(() => {\r\n        request({ url: config.backHost + \"/attractionOrder/payById/\"+row.id }).then(res => {\r\n          if (res.code === 200) {\r\n            document.querySelector(\"body\").innerHTML = res.data;\r\n            document.forms[0].submit();\r\n          }\r\n        });\r\n      });\r\n    },\r\n    handleCancel(row) {\r\n      this.$confirm('确定取消该订单吗？', '警告', { type: 'warning' }).then(() => {\r\n        request({ url: config.backHost + \"/attractionOrder/cancel/\"+row.id }).then(res => {\r\n          if (res.code === 200) {\r\n            this.$message.success(\"订单已取消\");\r\n            this.query(this.searchForm, this.pageBean);\r\n          }\r\n        });\r\n      });\r\n    },\r\n    getStateTag(state) {\r\n      const map = { \"10\": \"danger\", \"20\": \"warning\", \"80\": \"success\", \"-1\": \"info\" };\r\n      return map[state] || \"info\";\r\n    },\r\n    initData(){\r\n      request({ url: config.backHost + \"/attractionInfo/listPage\", data: {} }).then(res => { this.attractionIdOptions = res.data; });\r\n      request({ url: config.backHost + \"/ticketInfo/listPage\", data: {} }).then(res => { this.ticketIdOptions = res.data; });\r\n    },\r\n    query(searchForm, pageBean) {\r\n      request({\r\n        url: config.backHost + \"/attractionOrder/listPage\",\r\n        data: { params: searchForm, pageBean: pageBean }\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.tableData = res.data;\r\n          this.pageBean = res.pageBean;\r\n        }\r\n      });\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n@use \"@/assets/css/table.scss\";\r\n.own-mvue-list-box{\r\n  max-width: 1220px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n/* 统一的卡片样式 */\r\n.ticket-display-card {\r\n  text-align: center;\r\n  padding: 10px 0;\r\n  .tip { color: #909399; font-size: 14px; margin-bottom: 20px; }\r\n  .code-number {\r\n    font-size: 32px;\r\n    font-weight: bold;\r\n    color: #409EFF;\r\n    letter-spacing: 4px;\r\n    background: #f0f7ff;\r\n    padding: 15px 25px;\r\n    border-radius: 8px;\r\n    border: 2px dashed #409EFF;\r\n    display: inline-block;\r\n  }\r\n  .ticket-info {\r\n    margin-top: 25px;\r\n    padding: 15px;\r\n    background: #fdfdfd;\r\n    border-radius: 4px;\r\n    text-align: left;\r\n    border: 1px solid #eee;\r\n    p { margin: 8px 0; font-size: 14px; color: #606266; }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAsEA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,MAAA,GAAAN,UAAA;EACAO,KAAA;IACA;MACAC,MAAA;MACAC,mBAAA;MACAC,iBAAA,GACA;QAAA;QAAA;MAAA,GACA;QAAA;QAAA;MAAA,GACA;QAAA;QAAA;MAAA,GACA;QAAA;QAAA;MAAA,EACA;MACAC,eAAA;MACAC,aAAA;MACAC,YAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAX,IAAA;QAAAY,WAAA;QAAAC,KAAA;QAAAC,SAAA;QAAAC,SAAA;UAAAC,GAAA;UAAAb,IAAA;QAAA;QAAAc,GAAA;QAAAC,KAAA;MAAA,GACA;QAAAP,IAAA;QAAAX,IAAA;QAAAY,WAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAM,QAAA;IACAC,SAAA;MACA,MAAAC,IAAA,QAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA;MACA,OAAAH,IAAA,GAAAA,IAAA,CAAAD,QAAA;IACA;EACA;EACAK,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAC,eAAAC,GAAA;MACA,KAAAvB,YAAA,GAAAuB,GAAA;MACA,KAAAxB,aAAA;IACA;IACAyB,UAAAD,GAAA;MACA,KAAAE,QAAA;QAAAvB,IAAA;MAAA,GAAAwB,IAAA;QACAtC,OAAA;UAAAmB,GAAA,EAAAlB,MAAA,CAAAsC,QAAA,iCAAAJ,GAAA,CAAAK;QAAA,GAAAF,IAAA,CAAAG,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACAC,QAAA,CAAAC,aAAA,SAAAC,SAAA,GAAAJ,GAAA,CAAAnC,IAAA;YACAqC,QAAA,CAAAG,KAAA,IAAAC,MAAA;UACA;QACA;MACA;IACA;IACAC,aAAAb,GAAA;MACA,KAAAE,QAAA;QAAAvB,IAAA;MAAA,GAAAwB,IAAA;QACAtC,OAAA;UAAAmB,GAAA,EAAAlB,MAAA,CAAAsC,QAAA,gCAAAJ,GAAA,CAAAK;QAAA,GAAAF,IAAA,CAAAG,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAO,QAAA,CAAAC,OAAA;YACA,KAAApB,KAAA,MAAAC,UAAA,OAAAC,QAAA;UACA;QACA;MACA;IACA;IACAmB,YAAAC,KAAA;MACA,MAAAC,GAAA;QAAA;QAAA;QAAA;QAAA;MAAA;MACA,OAAAA,GAAA,CAAAD,KAAA;IACA;IACAvB,SAAA;MACA7B,OAAA;QAAAmB,GAAA,EAAAlB,MAAA,CAAAsC,QAAA;QAAAjC,IAAA;MAAA,GAAAgC,IAAA,CAAAG,GAAA;QAAA,KAAAjC,mBAAA,GAAAiC,GAAA,CAAAnC,IAAA;MAAA;MACAN,OAAA;QAAAmB,GAAA,EAAAlB,MAAA,CAAAsC,QAAA;QAAAjC,IAAA;MAAA,GAAAgC,IAAA,CAAAG,GAAA;QAAA,KAAA/B,eAAA,GAAA+B,GAAA,CAAAnC,IAAA;MAAA;IACA;IACAwB,MAAAC,UAAA,EAAAC,QAAA;MACAhC,OAAA;QACAmB,GAAA,EAAAlB,MAAA,CAAAsC,QAAA;QACAjC,IAAA;UAAAgD,MAAA,EAAAvB,UAAA;UAAAC,
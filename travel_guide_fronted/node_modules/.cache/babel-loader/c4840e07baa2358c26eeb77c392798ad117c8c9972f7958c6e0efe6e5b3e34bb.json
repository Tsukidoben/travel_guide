{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodInfoForm from \"@/views/manage/foodInfo/FoodInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\nexport default {\n  name: \"FoodInfoList\",\n  components: {\n    FoodInfoForm,\n    SearchTop\n  },\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/info/delete/\",\n      delBatchUrl: \"/api/food/info/delBatch\",\n      searchList: [{\n        type: 'input',\n        name: '关键字',\n        placeholder: '小吃名称、店铺名',\n        value: 'keyword'\n      }],\n      categoryMap: {} // 分类ID到名称的映射\n    };\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.loadCategoryMap();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    // 加载分类映射\n    loadCategoryMap() {\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          const map = {};\n          (res.data || []).forEach(item => {\n            map[item.id] = item.name;\n          });\n          this.categoryMap = map;\n        }\n      });\n    },\n    // 获取分类名称\n    getCategoryName(categoryId) {\n      return this.categoryMap[categoryId] || '-';\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/info/listPage\",\n        method: 'POST',\n        data: {\n          current: pageBean.page,\n          size: pageBean.pageSize,\n          params: searchForm\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    toggleStatus(row) {\n      const newStatus = row.status === 1 ? 0 : 1;\n      request({\n        url: config.backHost + \"/api/food/info/updateStatus\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          status: newStatus\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newStatus === 1 ? '上架成功' : '下架成功');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    },\n    toggleRecommend(row) {\n      const newRecommend = !row.isRecommend;\n      request({\n        url: config.backHost + \"/api/food/info/updateRecommend\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          isRecommend: newRecommend\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newRecommend ? '已设为首页推荐' : '已取消推荐');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","FoodInfoForm","SearchTop","common","name","components","mixins","data","delUrl","delBatchUrl","searchList","type","placeholder","value","categoryMap","computed","userRole","$store","getters","getUser","mounted","initData","loadCategoryMap","query","searchForm","pageBean","methods","url","backHost","method","then","res","code","map","forEach","item","id","getCategoryName","categoryId","current","page","size","pageSize","params","tableData","toggleStatus","row","newStatus","status","$message","success","toggleRecommend","newRecommend","isRecommend"],"sources":["src/views/manage/foodInfo/FoodInfoList.vue"],"sourcesContent":["<template>\n  <div class=\"own-mvue-list-box\">\n    <!--搜索区域-->\n    <div class=\"own-list-search-box\">\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\n    </div>\n    <div class=\"newTableStyle\">\n      <!--列表操作区域-->\n      <div v-if=\"userRole == '1'\" class=\"own-list-action-box\" style=\"display:block;\">\n        <el-button plain v-if=\"userRole == '1'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增小吃',null)\">新增</el-button>\n        <el-button plain v-if=\"userRole == '1'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\n      </div>\n      <!--列表数据区域-->\n      <div class=\"own-list-table-box\">\n        <!-- 表格内容 -->\n        <div class=\"own-list-table-data-box\">\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\n            <el-table-column type=\"selection\" width=\"55\" />\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\n            <el-table-column prop=\"images\" label=\"小吃图片\" width=\"120\">\n              <template #default=\"{row}\">\n                <el-image :src=\"getPicUrlByJson(row.images, 0)\" style=\"width: 80px; height: 60px\" fit=\"cover\"></el-image>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"name\" label=\"小吃名称\" width=\"150\"/>\n            <el-table-column prop=\"categoryName\" label=\"分类\" width=\"100\"/>\n            <el-table-column prop=\"shopName\" label=\"店铺\" width=\"150\"/>\n            <el-table-column prop=\"score\" label=\"评分\" width=\"100\">\n              <template #default=\"{row}\">\n                <el-rate v-model=\"row.score\" disabled show-score text-color=\"#ff9900\"></el-rate>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"avgPrice\" label=\"人均\" width=\"80\">\n              <template #default=\"{row}\">\n                ¥{{ row.avgPrice }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"isRecommend\" label=\"推荐\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-tag :type=\"row.isRecommend ? 'success' : 'info'\" size=\"mini\">\n                  {{ row.isRecommend ? '是' : '否' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"status\" label=\"状态\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-tag :type=\"row.status === 1 ? 'success' : 'danger'\" size=\"mini\">\n                  {{ row.status === 1 ? '上架' : '下架' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"250\">\n              <template #default=\"{ row }\">\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"openForm('edit', '编辑小吃', row)\">编辑</span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"toggleStatus(row)\">\n                  {{ row.status === 1 ? '下架' : '上架' }}\n                </span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"toggleRecommend(row)\">\n                  {{ row.isRecommend ? '取消推荐' : '设为首页推荐' }}\n                </span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;border-color: red\" @click=\"delById(row, delUrl)\">删除</span>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n\n        <!--分页区域-->\n        <el-pagination\n                :current-page=\"pageBean.page\"\n                :page-sizes=\"[10, 20, 50, 100]\"\n                :page-size=\"pageBean.pageSize\"\n                layout=\"total, sizes, prev, pager, next\"\n                :total=\"pageBean.total\"\n                @current-change=\"currPageChange\"\n                @size-change=\"handleSizeChange\" />\n      </div>\n    </div>\n    <!--表单-->\n    <FoodInfoForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\n  </div>\n</template>\n\n<script>\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodInfoForm from \"@/views/manage/foodInfo/FoodInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\n\nexport default {\n  name: \"FoodInfoList\",\n  components: { FoodInfoForm, SearchTop},\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/info/delete/\",\n      delBatchUrl: \"/api/food/info/delBatch\",\n      searchList: [\n        {type:'input',name:'关键字',placeholder:'小吃名称、店铺名',value:'keyword'},\n      ],\n      categoryMap: {} // 分类ID到名称的映射\n    }\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    },\n  },\n  mounted() {\n    this.initData();\n    this.loadCategoryMap();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData(){\n    },\n    // 加载分类映射\n    loadCategoryMap() {\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          const map = {};\n          (res.data || []).forEach(item => {\n            map[item.id] = item.name;\n          });\n          this.categoryMap = map;\n        }\n      });\n    },\n    // 获取分类名称\n    getCategoryName(categoryId) {\n      return this.categoryMap[categoryId] || '-';\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/info/listPage\",\n        method: 'POST',\n        data: { \n          current: pageBean.page,\n          size: pageBean.pageSize,\n          params: searchForm \n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    toggleStatus(row) {\n      const newStatus = row.status === 1 ? 0 : 1;\n      request({\n        url: config.backHost + \"/api/food/info/updateStatus\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          status: newStatus\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newStatus === 1 ? '上架成功' : '下架成功');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    },\n    toggleRecommend(row) {\n      const newRecommend = !row.isRecommend;\n      request({\n        url: config.backHost + \"/api/food/info/updateRecommend\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          isRecommend: newRecommend\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newRecommend ? '已设为首页推荐' : '已取消推荐');\n          this.query(this.searchForm, this.pageBean);\n        }\n      });\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n@use \"@/assets/css/table.scss\";\n</style>\n"],"mappings":";;AAmFA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,YAAA;AACA,OAAAC,SAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAJ,YAAA;IAAAC;EAAA;EACAI,MAAA,GAAAR,UAAA,EAAAK,MAAA;EACAI,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAP,IAAA;QAAAQ,WAAA;QAAAC,KAAA;MAAA,EACA;MACAC,WAAA;IACA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA,CAAAH,QAAA;IACA;EACA;EACAI,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,eAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAL,SAAA,GACA;IACA;IACAC,gBAAA;MACAvB,OAAA;QACA4B,GAAA,EAAA3B,MAAA,CAAA4B,QAAA;QACAC,MAAA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,MAAAC,GAAA;UACA,CAAAF,GAAA,CAAAxB,IAAA,QAAA2B,OAAA,CAAAC,IAAA;YACAF,GAAA,CAAAE,IAAA,CAAAC,EAAA,IAAAD,IAAA,CAAA/B,IAAA;UACA;UACA,KAAAU,WAAA,GAAAmB,GAAA;QACA;MACA;IACA;IACA;IACAI,gBAAAC,UAAA;MACA,YAAAxB,WAAA,CAAAwB,UAAA;IACA;IACAf,MAAAC,UAAA,EA
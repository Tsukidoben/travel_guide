{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport common from \"@/utils/common\";\nimport UploadImageMore from \"@/components/UploadImageMore.vue\";\nexport default {\n  name: \"FoodDetail\",\n  mixins: [common],\n  components: {\n    UploadImageMore\n  },\n  data() {\n    return {\n      foodId: null,\n      foodDetail: {},\n      shopInfo: {},\n      commentList: [],\n      commentPageNum: 1,\n      commentPageSize: 10,\n      commentTotal: 0,\n      isFavorited: false,\n      showCommentDialog: false,\n      submitLoading: false,\n      commentForm: {\n        score: 5,\n        content: '',\n        images: ''\n      },\n      commentRules: {\n        score: [{\n          required: true,\n          message: '请选择评分',\n          trigger: 'change'\n        }],\n        content: [{\n          required: true,\n          message: '请输入评价内容',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  mounted() {\n    this.foodId = this.$route.query.id;\n    if (this.foodId) {\n      this.getFoodDetail();\n      this.getShopInfo();\n      this.getComments();\n      this.checkFavorite();\n    }\n  },\n  methods: {\n    // 添加 getPicUrl 方法\n    getPicUrl(pic) {\n      if (!pic) return '';\n      // 直接使用 getPicUrlByJson,它已经能处理 JSON 字符串\n      return this.getPicUrlByJson(pic, 0);\n    },\n    // 将图片 JSON 字符串转为数组\n    getPicArray(picJson) {\n      if (!picJson) return [];\n      try {\n        // 如果已经是数组,直接返回\n        if (Array.isArray(picJson)) {\n          return picJson;\n        }\n        // 如果是字符串且包含 JSON 数组格式,解析它\n        if (typeof picJson === 'string') {\n          const trimmed = picJson.trim();\n          if (trimmed.startsWith('[') && trimmed.endsWith(']')) {\n            return JSON.parse(trimmed);\n          }\n          // 单个 URL 字符串\n          return [picJson];\n        }\n        return [picJson];\n      } catch (e) {\n        console.error('解析图片数据失败:', e);\n        return [picJson];\n      }\n    },\n    getFoodDetail() {\n      request({\n        url: config.backHost + `/api/food/info/detail/${this.foodId}`,\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          const data = res.data;\n          // 映射后端字段\n          this.foodDetail = {\n            id: data.id,\n            foodName: data.name,\n            foodPic: data.images,\n            categoryId: data.categoryId,\n            shopId: data.shopId,\n            avgPrice: data.avgPrice,\n            score: data.score,\n            tags: data.tags,\n            status: data.status,\n            isRecommend: data.isRecommend,\n            introduction: data.description,\n            tasteFeature: data.tasteFeature,\n            recommendReason: data.recommendReason,\n            categoryName: data.categoryName,\n            shopName: data.shopName\n          };\n        }\n      });\n    },\n    getShopInfo() {\n      if (!this.foodDetail.shopId) return;\n      request({\n        url: config.backHost + `/api/food/shop/detail/${this.foodDetail.shopId}`,\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          const data = res.data;\n          // 如果小吃详情中已经包含 foodShop，直接使用\n          if (this.foodDetail.foodShop) {\n            this.shopInfo = {\n              id: this.foodDetail.foodShop.id,\n              shopName: this.foodDetail.foodShop.name,\n              shopPic: this.foodDetail.foodShop.images || '',\n              address: this.foodDetail.foodShop.address,\n              phone: this.foodDetail.foodShop.phone,\n              avgPrice: this.foodDetail.foodShop.avgPrice,\n              businessHours: this.foodDetail.foodShop.businessHours\n            };\n          } else {\n            // 否则使用单独查询的结果\n            this.shopInfo = {\n              id: data.id,\n              shopName: data.name,\n              shopPic: data.images || '',\n              address: data.address,\n              phone: data.phone,\n              avgPrice: data.avgPrice,\n              businessHours: data.businessHours\n            };\n          }\n        }\n      });\n    },\n    getComments() {\n      request({\n        url: config.backHost + \"/api/food/comment/listPage\",\n        method: 'POST',\n        data: {\n          params: {\n            foodId: this.foodId\n          },\n          pageBean: {\n            page: this.commentPageNum,\n            pageSize: this.commentPageSize\n          }\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          const data = res.data;\n          this.commentList = (data.records || []).map(item => ({\n            id: item.id,\n            foodId: item.foodId,\n            userId: item.userId,\n            userName: item.userName,\n            userHeadPic: item.userHeadPicUrl,\n            score: item.score,\n            content: item.content,\n            images: item.images,\n            createTime: item.createTime\n          }));\n          this.commentTotal = data.total || 0;\n        }\n      });\n    },\n    checkFavorite() {\n      if (!this.userInfo || !this.userInfo.id) return;\n      request({\n        url: config.backHost + \"/api/food/favorite/listPage\",\n        method: 'POST',\n        data: {\n          pageBean: {\n            page: 1,\n            pageSize: 100\n          }\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          const favorites = (res.data.records || []).map(item => item.foodId);\n          this.isFavorited = favorites.includes(this.foodId);\n        }\n      });\n    },\n    toggleFavorite() {\n      if (!this.userInfo || !this.userInfo.id) {\n        this.$message.warning('请先登录');\n        this.$router.push({\n          name: 'login'\n        });\n        return;\n      }\n      request({\n        url: config.backHost + \"/api/food/favorite\",\n        method: 'POST',\n        data: {\n          foodId: this.foodId\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.isFavorited = !this.isFavorited;\n          this.$message.success(this.isFavorited ? '收藏成功' : '取消收藏成功');\n        }\n      });\n    },\n    shareFood() {\n      this.$message.info('分享功能开发中...');\n    },\n    submitComment() {\n      this.$refs.commentForm.validate(valid => {\n        if (valid) {\n          this.submitLoading = true;\n          request({\n            url: config.backHost + \"/api/food/comment/add\",\n            method: 'POST',\n            data: {\n              foodId: this.foodId,\n              score: this.commentForm.score,\n              content: this.commentForm.content,\n              images: this.commentForm.images\n            }\n          }).then(res => {\n            if (res.code === 200) {\n              this.$message.success('评价成功');\n              this.showCommentDialog = false;\n              this.commentPageNum = 1;\n              this.getComments();\n              this.resetCommentForm();\n            }\n          }).finally(() => {\n            this.submitLoading = false;\n          });\n        }\n      });\n    },\n    resetCommentForm() {\n      this.commentForm = {\n        score: 5,\n        content: '',\n        images: ''\n      };\n    },\n    handleCommentPageChange(page) {\n      this.commentPageNum = page;\n      this.getComments();\n    },\n    getPicArray(picJson) {\n      try {\n        return JSON.parse(picJson || '[]');\n      } catch (e) {\n        return [];\n      }\n    }\n  }\n};","map":{"version":3,"names":["request","config","common","UploadImageMore","name","mixins","components","data","foodId","foodDetail","shopInfo","commentList","commentPageNum","commentPageSize","commentTotal","isFavorited","showCommentDialog","submitLoading","commentForm","score","content","images","commentRules","required","message","trigger","mounted","$route","query","id","getFoodDetail","getShopInfo","getComments","checkFavorite","methods","getPicUrl","pic","getPicUrlByJson","getPicArray","picJson","Array","isArray","trimmed","trim","startsWith","endsWith","JSON","parse","e","console","error","url","backHost","method","then","res","code","foodName","foodPic","categoryId","shopId","avgPrice","tags","status","isRecommend","introduction","description","tasteFeature","recommendReason","categoryName","shopName","foodShop","shopPic","address","phone","businessHours","params","pageBean","page","pageSize","records","map","item","userId","userName","userHeadPic","userHeadPicUrl","createTime","total","userInfo","favorites","includes","toggleFavorite","$message","warning","$router","push","success","shareFood","info","submitComment","$refs","validate","valid","resetCommentForm","finally","handleCommentPageChange"],"sources":["src/views/front/foodList/components/foodDetail.vue"],"sourcesContent":["<template>\n  <div class=\"food-detail-container\">\n    <!-- 顶部大图区 -->\n    <div class=\"hero-section\" v-if=\"foodDetail.foodPic\">\n      <el-carousel height=\"400px\" indicator-position=\"outside\" :autoplay=\"false\">\n        <el-carousel-item v-for=\"(pic, index) in getPicArray(foodDetail.foodPic)\" :key=\"index\">\n          <img :src=\"getPicUrl(pic)\" alt=\"food\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n        </el-carousel-item>\n      </el-carousel>\n    </div>\n\n    <!-- 主要内容区 -->\n    <div class=\"content-wrapper\">\n      <!-- 基本信息头部 -->\n      <div class=\"info-header\">\n        <div class=\"header-left\">\n          <h1 class=\"food-name\">{{ foodDetail.foodName }}</h1>\n          <div class=\"rating-box\">\n            <el-rate v-model=\"foodDetail.score\" disabled show-score text-color=\"#ff9900\"></el-rate>\n            <span class=\"score-text\">{{ foodDetail.score }}分</span>\n          </div>\n          <div class=\"meta-info\">\n            <span class=\"price-tag\">¥{{ foodDetail.avgPrice }}/人</span>\n            <el-tag v-if=\"foodDetail.isRecommend\" type=\"danger\" size=\"medium\" effect=\"dark\">必吃推荐</el-tag>\n            <el-tag v-for=\"(tag, idx) in (foodDetail.tags || '').split(',')\" :key=\"idx\" size=\"medium\">\n              {{ tag.trim() }}\n            </el-tag>\n          </div>\n        </div>\n        <div class=\"header-right\">\n          <el-button type=\"primary\" round @click=\"toggleFavorite\">\n            <i :class=\"isFavorited ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n            {{ isFavorited ? '已收藏' : '收藏' }}\n          </el-button>\n          <el-button round @click=\"shareFood\">\n            <i class=\"el-icon-share\"></i>\n            分享\n          </el-button>\n        </div>\n      </div>\n\n      <!-- 基础信息区 -->\n      <div class=\"section-card\">\n        <h2 class=\"section-title\">\n          <i class=\"el-icon-info\"></i>\n          小吃简介\n        </h2>\n        <div class=\"intro-content\">\n          <p>{{ foodDetail.introduction }}</p>\n        </div>\n        <div class=\"taste-feature\" v-if=\"foodDetail.tasteFeature\">\n          <h3 class=\"sub-title\">口味特色</h3>\n          <p>{{ foodDetail.tasteFeature }}</p>\n        </div>\n      </div>\n\n      <!-- 店铺信息区 -->\n      <div class=\"section-card\" v-if=\"shopInfo.id\">\n        <h2 class=\"section-title\">\n          <i class=\"el-icon-shop\"></i>\n          店铺信息\n        </h2>\n        <div class=\"shop-info-box\">\n          <div class=\"shop-image\" v-if=\"shopInfo.shopPic\">\n            <img :src=\"getPicUrlByJson(shopInfo.shopPic, 0)\" alt=\"shop\">\n          </div>\n          <div class=\"shop-details\">\n            <h3 class=\"shop-name\">{{ shopInfo.shopName }}</h3>\n            <div class=\"shop-item\">\n              <i class=\"el-icon-location-outline\"></i>\n              <span>{{ shopInfo.address }}</span>\n            </div>\n            <div class=\"shop-item\">\n              <i class=\"el-icon-time\"></i>\n              <span>营业时间：{{ shopInfo.businessHours }}</span>\n            </div>\n            <div class=\"shop-item\">\n              <i class=\"el-icon-phone\"></i>\n              <span>{{ shopInfo.phone }}</span>\n            </div>\n            <div class=\"shop-item\">\n              <i class=\"el-icon-wallet\"></i>\n              <span>人均：¥{{ shopInfo.avgPrice }}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 用户评价区 -->\n      <div class=\"section-card\">\n        <div class=\"section-title-row\">\n          <h2 class=\"section-title\">\n            <i class=\"el-icon-chat-dot-round\"></i>\n            用户评价\n          </h2>\n          <el-button \n            v-if=\"userInfo && userInfo.id\" \n            type=\"primary\" \n            size=\"small\" \n            round \n            @click=\"showCommentDialog = true\">\n            <i class=\"el-icon-edit\"></i>\n            发表评价\n          </el-button>\n        </div>\n\n        <div class=\"comment-list\" v-if=\"commentList.length > 0\">\n          <div v-for=\"comment in commentList\" :key=\"comment.id\" class=\"comment-item\">\n            <div class=\"comment-header\">\n              <el-avatar :size=\"40\" :src=\"getPicUrlByJson(comment.userHeadPic, 0)\"></el-avatar>\n              <div class=\"comment-user-info\">\n                <div class=\"user-name\">{{ comment.userName }}</div>\n                <el-rate v-model=\"comment.score\" disabled text-color=\"#ff9900\" :max=\"5\"></el-rate>\n              </div>\n              <div class=\"comment-time\">{{ comment.createTime }}</div>\n            </div>\n            <div class=\"comment-content\">{{ comment.content }}</div>\n            <div class=\"comment-images\" v-if=\"comment.images\">\n              <el-image\n                v-for=\"(img, idx) in getPicArray(comment.images)\"\n                :key=\"idx\"\n                :src=\"getPicUrl(img)\"\n                :preview-src-list=\"getPicArray(comment.images).map(i => getPicUrl(i))\"\n                fit=\"cover\"\n                class=\"comment-img\">\n              </el-image>\n            </div>\n          </div>\n        </div>\n\n        <div v-else class=\"empty-comment\">\n          <el-empty description=\"暂无评价，快来抢沙发吧~\"></el-empty>\n        </div>\n\n        <!-- 评论分页 -->\n        <div class=\"pagination-container\" v-if=\"commentList.length > 0\">\n          <el-pagination\n            background\n            @current-change=\"handleCommentPageChange\"\n            :current-page=\"commentPageNum\"\n            :page-size=\"commentPageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"commentTotal\">\n          </el-pagination>\n        </div>\n      </div>\n    </div>\n\n    <!-- 发表评论弹窗 -->\n    <el-dialog title=\"发表评价\" :visible.sync=\"showCommentDialog\" width=\"600px\">\n      <el-form :model=\"commentForm\" :rules=\"commentRules\" ref=\"commentForm\" label-width=\"80px\">\n        <el-form-item label=\"评分\" prop=\"score\">\n          <el-rate v-model=\"commentForm.score\" :max=\"5\" show-text></el-rate>\n        </el-form-item>\n        <el-form-item label=\"评价内容\" prop=\"content\">\n          <el-input\n            type=\"textarea\"\n            v-model=\"commentForm.content\"\n            :rows=\"4\"\n            placeholder=\"分享您的用餐体验...\">\n          </el-input>\n        </el-form-item>\n        <el-form-item label=\"上传图片\">\n          <UploadImageMore \n            v-model=\"commentForm.images\" \n            :limit=\"5\"\n            accept=\".jpg,.jpeg,.png\">\n          </UploadImageMore>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"showCommentDialog = false\">取 消</el-button>\n        <el-button type=\"primary\" @click=\"submitComment\" :loading=\"submitLoading\">确 定</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport common from \"@/utils/common\";\nimport UploadImageMore from \"@/components/UploadImageMore.vue\";\n\nexport default {\n  name: \"FoodDetail\",\n  mixins: [common],\n  components: {\n    UploadImageMore\n  },\n  data() {\n    return {\n      foodId: null,\n      foodDetail: {},\n      shopInfo: {},\n      commentList: [],\n      commentPageNum: 1,\n      commentPageSize: 10,\n      commentTotal: 0,\n      isFavorited: false,\n      showCommentDialog: false,\n      submitLoading: false,\n      commentForm: {\n        score: 5,\n        content: '',\n        images: ''\n      },\n      commentRules: {\n        score: [{ required: true, message: '请选择评分', trigger: 'change' }],\n        content: [{ required: true, message: '请输入评价内容', trigger: 'blur' }]\n      }\n    }\n  },\n  mounted() {\n    this.foodId = this.$route.query.id;\n    if (this.foodId) {\n      this.getFoodDetail();\n      this.getShopInfo();\n      this.getComments();\n      this.checkFavorite();\n    }\n  },\n  methods: {\n    // 添加 getPicUrl 方法\n    getPicUrl(pic) {\n      if (!pic) return '';\n      // 直接使用 getPicUrlByJson,它已经能处理 JSON 字符串\n      return this.getPicUrlByJson(pic, 0);\n    },\n    // 将图片 JSON 字符串转为数组\n    getPicArray(picJson) {\n      if (!picJson) return [];\n      try {\n        // 如果已经是数组,直接返回\n        if (Array.isArray(picJson)) {\n          return picJson;\n        }\n        // 如果是字符串且包含 JSON 数组格式,解析它\n        if (typeof picJson === 'string') {\n          const trimmed = picJson.trim();\n          if (trimmed.startsWith('[') && trimmed.endsWith(']')) {\n            return JSON.parse(trimmed);\n          }\n          // 单个 URL 字符串\n          return [picJson];\n        }\n        return [picJson];\n      } catch (e) {\n        console.error('解析图片数据失败:', e);\n        return [picJson];\n      }\n    },\n    getFoodDetail() {\n      request({\n        url: config.backHost + `/api/food/info/detail/${this.foodId}`,\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          const data = res.data;\n          // 映射后端字段\n          this.foodDetail = {\n            id: data.id,\n            foodName: data.name,\n            foodPic: data.images,\n            categoryId: data.categoryId,\n            shopId: data.shopId,\n            avgPrice: data.avgPrice,\n            score: data.score,\n            tags: data.tags,\n            status: data.status,\n            isRecommend: data.isRecommend,\n            introduction: data.description,\n            tasteFeature: data.tasteFeature,\n            recommendReason: data.recommendReason,\n            categoryName: data.categoryName,\n            shopName: data.shopName\n          };\n        }\n      });\n    },\n    \n    getShopInfo() {\n      if (!this.foodDetail.shopId) return;\n      request({\n        url: config.backHost + `/api/food/shop/detail/${this.foodDetail.shopId}`,\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          const data = res.data;\n          // 如果小吃详情中已经包含 foodShop，直接使用\n          if (this.foodDetail.foodShop) {\n            this.shopInfo = {\n              id: this.foodDetail.foodShop.id,\n              shopName: this.foodDetail.foodShop.name,\n              shopPic: this.foodDetail.foodShop.images || '',\n              address: this.foodDetail.foodShop.address,\n              phone: this.foodDetail.foodShop.phone,\n              avgPrice: this.foodDetail.foodShop.avgPrice,\n              businessHours: this.foodDetail.foodShop.businessHours\n            };\n          } else {\n            // 否则使用单独查询的结果\n            this.shopInfo = {\n              id: data.id,\n              shopName: data.name,\n              shopPic: data.images || '',\n              address: data.address,\n              phone: data.phone,\n              avgPrice: data.avgPrice,\n              businessHours: data.businessHours\n            };\n          }\n        }\n      });\n    },\n    \n    getComments() {\n      request({\n        url: config.backHost + \"/api/food/comment/listPage\",\n        method: 'POST',\n        data: {\n          params: {\n            foodId: this.foodId\n          },\n          pageBean: {\n            page: this.commentPageNum,\n            pageSize: this.commentPageSize\n          }\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          const data = res.data;\n          this.commentList = (data.records || []).map(item => ({\n            id: item.id,\n            foodId: item.foodId,\n            userId: item.userId,\n            userName: item.userName,\n            userHeadPic: item.userHeadPicUrl,\n            score: item.score,\n            content: item.content,\n            images: item.images,\n            createTime: item.createTime\n          }));\n          this.commentTotal = data.total || 0;\n        }\n      });\n    },\n    \n    checkFavorite() {\n      if (!this.userInfo || !this.userInfo.id) return;\n      request({\n        url: config.backHost + \"/api/food/favorite/listPage\",\n        method: 'POST',\n        data: {\n          pageBean: {\n            page: 1,\n            pageSize: 100\n          }\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          const favorites = (res.data.records || []).map(item => item.foodId);\n          this.isFavorited = favorites.includes(this.foodId);\n        }\n      });\n    },\n    \n    toggleFavorite() {\n      if (!this.userInfo || !this.userInfo.id) {\n        this.$message.warning('请先登录');\n        this.$router.push({name: 'login'});\n        return;\n      }\n      \n      request({\n        url: config.backHost + \"/api/food/favorite\",\n        method: 'POST',\n        data: {\n          foodId: this.foodId\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.isFavorited = !this.isFavorited;\n          this.$message.success(this.isFavorited ? '收藏成功' : '取消收藏成功');\n        }\n      });\n    },\n    \n    shareFood() {\n      this.$message.info('分享功能开发中...');\n    },\n    \n    submitComment() {\n      this.$refs.commentForm.validate((valid) => {\n        if (valid) {\n          this.submitLoading = true;\n          request({\n            url: config.backHost + \"/api/food/comment/add\",\n            method: 'POST',\n            data: {\n              foodId: this.foodId,\n              score: this.commentForm.score,\n              content: this.commentForm.content,\n              images: this.commentForm.images\n            }\n          }).then(res => {\n            if (res.code === 200) {\n              this.$message.success('评价成功');\n              this.showCommentDialog = false;\n              this.commentPageNum = 1;\n              this.getComments();\n              this.resetCommentForm();\n            }\n          }).finally(() => {\n            this.submitLoading = false;\n          });\n        }\n      });\n    },\n    \n    resetCommentForm() {\n      this.commentForm = {\n        score: 5,\n        content: '',\n        images: ''\n      };\n    },\n    \n    handleCommentPageChange(page) {\n      this.commentPageNum = page;\n      this.getComments();\n    },\n    \n    getPicArray(picJson) {\n      try {\n        return JSON.parse(picJson || '[]');\n      } catch (e) {\n        return [];\n      }\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n.food-detail-container {\n  min-height: 100%;\n  background: $pageBack;\n}\n\n.hero-section {\n  width: 100%;\n  \n  ::v-deep .el-carousel__container {\n    height: 400px;\n  }\n  \n  img {\n    display: block;\n  }\n}\n\n.content-wrapper {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 30px 20px;\n}\n\n.info-header {\n  background: #fff;\n  padding: 30px;\n  border-radius: 12px;\n  margin-bottom: 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  box-shadow: 0 2px 12px rgba(0,0,0,0.08);\n  \n  .header-left {\n    flex: 1;\n    \n    .f
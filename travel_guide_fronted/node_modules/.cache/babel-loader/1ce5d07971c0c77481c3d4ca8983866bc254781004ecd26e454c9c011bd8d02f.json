{"ast":null,"code":"import LoginComponent from \"./components/LoginComponent.vue\";\nimport RegisterComponent from \"./components/RegisterComponent.vue\";\nimport config from \"@/config/config\";\nexport default {\n  name: \"Login\",\n  computed: {\n    config() {\n      return config;\n    }\n  },\n  components: {\n    RegisterComponent,\n    LoginComponent\n  },\n  data() {\n    return {\n      action: 'login',\n      loading: false\n    };\n  },\n  created() {},\n  mounted() {\n    clearInterval('showNotice');\n\n    // 判断是不是注册\n    let query = this.$route.query;\n    if (query && query.action === 'register') {\n      // 跳转至注册\n      this.action = 'register';\n    }\n  },\n  methods: {}\n};","map":{"version":3,"names":["LoginComponent","RegisterComponent","config","name","computed","components","data","action","loading","created","mounted","clearInterval","query","$route","methods"],"sources":["src/views/login/Login.vue"],"sourcesContent":["<template>\n  <div class=\"container\">\n    <div class=\"main-container\">\n      <div class=\"login-box\">\n        <login-component  @toRegister=\"action = 'register'\" @toForget=\"action = 'forget'\" v-if=\"action == 'login'\"/>\n        <register-component @toLogin=\"action = 'login'\" @toForget=\"action = 'forget'\" v-if=\"action == 'register'\"/>\n      </div>\n      <!--      <div class=\"empty-box\"></div>-->\n    </div>\n    <div class=\"footer\">\n      Copyright 版权所有 {{ config.companyName }}\n    </div>\n  </div>\n\n</template>\n\n<script>\nimport LoginComponent from \"./components/LoginComponent.vue\";\nimport RegisterComponent from \"./components/RegisterComponent.vue\";\nimport config from \"@/config/config\";\n\nexport default {\n  name: \"Login\",\n  computed: {\n    config() {\n      return config\n    }\n  },\n  components: {RegisterComponent, LoginComponent},\n  data() {\n    return {\n      action: 'login',\n      loading: false,\n    }\n  },\n  created() {\n  },\n  mounted() {\n    clearInterval('showNotice')\n\n    // 判断是不是注册\n    let query= this.$route.query;\n    if(query && query.action === 'register'){\n      // 跳转至注册\n      this.action = 'register'\n    }\n  },\n  methods: {\n\n  }\n}\n\n</script>\n\n<style scoped lang=\"scss\">\n.container {\n  width: 100%;\n  height: 100vh;\n  box-sizing: border-box;\n\n}\n\n.main-container {\n  width: 100%;\n  height: 95vh;\n  background: url('~@/assets/imgs/login.png') center bottom fixed repeat;\n  background-size: 100%;\n  background-color: #fff;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.login-box{\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n//.empty-box, .login-box {\n//  width: 50%;\n//  height: 95vh;\n//  display: flex;\n//  justify-content: center;\n//  align-items: center;\n//  margin-left: 300px;\n//  margin-top: 50px;\n//}\n\n.footer {\n  text-align: center;\n  width: 100%;\n  height: 5vh;\n  line-height: 5vh;\n  display: flex;\n  justify-content: center;\n}\n\n</style>\n"],"mappings":"AAiBA,OAAAA,cAAA;AACA,OAAAC,iBAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,QAAA;IACAF,OAAA;MACA,OAAAA,MAAA;IACA;EACA;EACAG,UAAA;IAAAJ,iBAAA;IAAAD;EAAA;EACAM,KAAA;IACA;MACAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA,GACA;EACAC,QAAA;IACAC,aAAA;;IAEA;IACA,IAAAC,KAAA,QAAAC,MAAA,CAAAD,KAAA;IACA,IAAAA,KAAA,IAAAA,KAAA,CAAAL,MAAA;MACA;MACA,KAAAA,MAAA;IACA;EACA;EACAO,OAAA,GAEA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
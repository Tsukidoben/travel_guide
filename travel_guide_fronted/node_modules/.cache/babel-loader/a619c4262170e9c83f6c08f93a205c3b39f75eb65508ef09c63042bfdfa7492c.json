{"ast":null,"code":"import FormUtils from '@/utils/formUtils';\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport uploadImageMore from \"@/components/UploadImageMore.vue\";\nexport default {\n  name: \"FoodShopForm\",\n  mixins: [FormUtils],\n  components: {\n    uploadImageMore\n  },\n  data() {\n    return {\n      formData: {\n        id: null,\n        name: '',\n        images: '',\n        address: '',\n        phone: '',\n        avgPrice: 0,\n        businessHours: '',\n        longitude: '',\n        latitude: ''\n      },\n      addUrl: '/api/food/shop/saveOrUpdate',\n      editUrl: '/api/food/shop/saveOrUpdate',\n      newUploadImgKey: new Date().getTime(),\n      geoLoading: false // 经纬度获取loading状态\n    };\n  },\n  methods: {\n    initForm() {\n      this.newUploadImgKey = new Date().getTime();\n    },\n    clearData() {\n      this.formData = {\n        id: null,\n        name: '',\n        images: '',\n        address: '',\n        phone: '',\n        avgPrice: 0,\n        businessHours: '',\n        longitude: '',\n        latitude: ''\n      };\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.name) {\n        message += \"店铺名称不能为空<br>\";\n      }\n      if (!this.formData.address) {\n        message += \"店铺地址不能为空<br>\";\n      }\n      if (!this.formData.phone) {\n        message += \"联系电话不能为空<br>\";\n      } else if (!/^1[3-9]\\d{9}$/.test(this.formData.phone)) {\n        message += \"请输入正确的手机号码<br>\";\n      }\n      return message;\n    },\n    // 获取经纬度\n    async handleGetCoordinates(type) {\n      const address = this.formData.address;\n      if (!address || !address.trim()) {\n        this.$message.warning('请先输入地址');\n        return;\n      }\n      this.geoLoading = true;\n      try {\n        const res = await request({\n          url: config.backHost + '/api/common/geoCode',\n          method: 'POST',\n          data: {\n            address: address\n          }\n        });\n        if (res.code === 200 && res.data) {\n          this.formData.longitude = res.data.longitude || '';\n          this.formData.latitude = res.data.latitude || '';\n          this.$message.success('经纬度获取成功');\n        } else {\n          this.$message.error('地址解析失败，请检查地址格式或手动输入');\n        }\n      } catch (error) {\n        console.error('地址解析失败:', error);\n        this.$message.error('地址解析失败，请检查地址格式或手动输入');\n      } finally {\n        this.geoLoading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["FormUtils","request","config","uploadImageMore","name","mixins","components","data","formData","id","images","address","phone","avgPrice","businessHours","longitude","latitude","addUrl","editUrl","newUploadImgKey","Date","getTime","geoLoading","methods","initForm","clearData","beforeSave","message","test","handleGetCoordinates","type","trim","$message","warning","res","url","backHost","method","code","success","error","console"],"sources":["src/views/manage/foodInfo/FoodShopForm.vue"],"sourcesContent":["<template>\n  <div class=\"form-box\">\n    <el-dialog top=\"10vh\" width=\"600px\" :title=\"title\" :visible.sync=\"visible\" :before-close=\"closeDialog\" :modal=\"true\" :close-on-click-modal=\"false\">\n      <template #default>\n        <el-form :model=\"formData\" ref=\"form\" label-width=\"auto\" style=\"padding: 0 20px\">\n          <el-form-item prop=\"images\" label=\"店铺图片\">\n            <upload-image-more :key=\"newUploadImgKey\" v-model=\"formData.images\" :max=\"3\"/>\n            <p class=\"upload-tip\">最多可上传 3 张图片，支持 jpg、png 格式</p>\n          </el-form-item>\n          <el-form-item prop=\"name\" label=\"店铺名称\">\n            <el-input type=\"text\" v-model=\"formData.name\" style=\"width: 100%\"  placeholder=\"请输入店铺名称\"/>\n          </el-form-item>\n          <el-form-item prop=\"address\" label=\"店铺地址\">\n            <div style=\"display: flex; gap: 10px; align-items: flex-start;\">\n              <el-input type=\"textarea\" :rows=\"2\" v-model=\"formData.address\" style=\"flex: 1\" placeholder=\"请输入店铺地址\" @blur=\"handleGetCoordinates('shop')\" />\n              <el-button type=\"primary\" size=\"small\" :loading=\"geoLoading\" @click=\"handleGetCoordinates('shop')\" style=\"flex-shrink: 0;\">获取经纬度</el-button>\n            </div>\n            <!-- 隐藏字段存储经纬度 -->\n            <el-input type=\"hidden\" v-model=\"formData.longitude\" />\n            <el-input type=\"hidden\" v-model=\"formData.latitude\" />\n          </el-form-item>\n          <el-form-item prop=\"phone\" label=\"联系电话\">\n            <el-input type=\"text\" v-model=\"formData.phone\" style=\"width: 100%\"  placeholder=\"请输入联系电话\"/>\n          </el-form-item>\n          <el-form-item prop=\"avgPrice\" label=\"人均价格\">\n            <el-input-number v-model=\"formData.avgPrice\" :min=\"0\" :max=\"9999\" style=\"width: 100%\"></el-input-number>\n          </el-form-item>\n          <el-form-item prop=\"businessHours\" label=\"营业时间\">\n            <el-select v-model=\"formData.businessHours\" placeholder=\"请选择营业时间\" style=\"width: 100%\" clearable>\n              <el-option label=\"06:00-22:00\" value=\"06:00-22:00\"></el-option>\n              <el-option label=\"07:00-21:00\" value=\"07:00-21:00\"></el-option>\n              <el-option label=\"08:00-20:00\" value=\"08:00-20:00\"></el-option>\n              <el-option label=\"09:00-21:00\" value=\"09:00-21:00\"></el-option>\n              <el-option label=\"09:00-22:00\" value=\"09:00-22:00\"></el-option>\n              <el-option label=\"10:00-22:00\" value=\"10:00-22:00\"></el-option>\n              <el-option label=\"全天营业\" value=\"全天营业\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-form>\n      </template>\n      <template #footer>\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport FormUtils from '@/utils/formUtils'\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport uploadImageMore from \"@/components/UploadImageMore.vue\";\n\nexport default {\n  name: \"FoodShopForm\",\n  mixins: [FormUtils],\n  components: {uploadImageMore},\n  data() {\n    return {\n      formData: {\n        id: null,\n        name: '',\n        images: '',\n        address: '',\n        phone: '',\n        avgPrice: 0,\n        businessHours: '',\n        longitude: '',\n        latitude: ''\n      },\n      addUrl: '/api/food/shop/saveOrUpdate',\n      editUrl: '/api/food/shop/saveOrUpdate',\n      newUploadImgKey: new Date().getTime(),\n      geoLoading: false // 经纬度获取loading状态\n    };\n  },\n  methods: {\n    initForm(){\n      this.newUploadImgKey = new Date().getTime();\n    },\n    clearData(){\n      this.formData = {\n        id: null,\n        name: '',\n        images: '',\n        address: '',\n        phone: '',\n        avgPrice: 0,\n        businessHours: '',\n        longitude: '',\n        latitude: ''\n      };\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.name) {\n        message += \"店铺名称不能为空<br>\";\n      }\n      if (!this.formData.address) {\n        message += \"店铺地址不能为空<br>\";\n      }\n      if (!this.formData.phone) {\n        message += \"联系电话不能为空<br>\";\n      } else if (!/^1[3-9]\\d{9}$/.test(this.formData.phone)) {\n        message += \"请输入正确的手机号码<br>\";\n      }\n      return message;\n    },\n    // 获取经纬度\n    async handleGetCoordinates(type) {\n      const address = this.formData.address;\n      if (!address || !address.trim()) {\n        this.$message.warning('请先输入地址');\n        return;\n      }\n      \n      this.geoLoading = true;\n      try {\n        const res = await request({\n          url: config.backHost + '/api/common/geoCode',\n          method: 'POST',\n          data: { address: address }\n        });\n        \n        if (res.code === 200 && res.data) {\n          this.formData.longitude = res.data.longitude || '';\n          this.formData.latitude = res.data.latitude || '';\n          this.$message.success('经纬度获取成功');\n        } else {\n          this.$message.error('地址解析失败，请检查地址格式或手动输入');\n        }\n      } catch (error) {\n        console.error('地址解析失败:', error);\n        this.$message.error('地址解析失败，请检查地址格式或手动输入');\n      } finally {\n        this.geoLoading = false;\n      }\n    }\n  }\n};\n</script>\n\n<style scoped lang=\"scss\">\n::v-deep .el-dialog__body{\n  max-height: 60vh;\n  overflow-x: hidden;\n  overflow-y: auto;\n}\n.upload-tip {\n  font-size: 12px;\n  color: #999;\n  margin-top: 5px;\n}\n</style>\n"],"mappings":"AAiDA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,eAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAL,SAAA;EACAM,UAAA;IAAAH;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,EAAA;QACAL,IAAA;QACAM,MAAA;QACAC,OAAA;QACAC,KAAA;QACAC,QAAA;QACAC,aAAA;QACAC,SAAA;QACAC,QAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,eAAA,MAAAC,IAAA,GAAAC,OAAA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA;MACA,KAAAL,eAAA,OAAAC,IAAA,GAAAC,OAAA;IACA;IACAI,UAAA;MACA,KAAAjB,QAAA;QACAC,EAAA;QACAL,IAAA;QACAM,MAAA;QACAC,OAAA;QACAC,KAAA;QACAC,QAAA;QACAC,aAAA;QACAC,SAAA;QACAC,QAAA;MACA;IACA;IACAU,WAAA;MACA,IAAAC,OAAA;MACA,UAAAnB,QAAA,CAAAJ,IAAA;QACAuB,OAAA;MACA;MACA,UAAAnB,QAAA,CAAAG,OAAA;QACAgB,OAAA;MACA;MACA,UAAAnB,QAAA,CAAAI,KAAA;QACAe,OAAA;MACA,4BAAAC,IAAA,MAAApB,QAAA,CAAAI,KAAA;QACAe,OAAA;MACA;MACA,OAAAA,OAAA;IACA;IACA;IACA,MAAAE,qBAAAC,IAAA;MACA,MAAAnB,OAAA,QAAAH,QAAA,CAAAG,OAAA;MACA,KAAAA,OAAA,KAAAA,OAAA,CAAAoB,IAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA;MACA;MAEA,KAAAX,UAAA;MACA;QACA,MAAAY,GAAA,SAAAjC,OAAA;UACAkC,GAAA,EAAAjC,MAAA,CAAAkC,QAAA;UACAC,MAAA;UACA9B,IAAA;YAAAI,OAAA,EAAAA;UAAA;QACA;QAEA,IAAAuB,GAAA,CAAAI,IAAA,YAAAJ,GAAA,CAAA3B,IAAA;UACA,KAAAC,QAAA,CAAAO,SAAA,GAAAmB,GAAA,CAAA3B,IAAA,CAAAQ,SAAA;UACA,KAAAP,QAAA,CAAAQ,QAAA,GAAAkB,GAAA,CAAA3B,IAAA,CAAAS,QAAA;UACA,KAAAgB,QAAA,CAAAO,OA
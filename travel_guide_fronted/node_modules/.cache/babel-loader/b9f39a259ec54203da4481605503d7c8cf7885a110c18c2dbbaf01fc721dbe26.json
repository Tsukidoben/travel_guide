{"ast":null,"code":"import FormUtils from '@/utils/formUtils';\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\nimport uploadImageMore from \"@/components/UploadImageMore.vue\";\nexport default {\n  name: \"FoodInfoForm\",\n  mixins: [FormUtils],\n  components: {\n    OwnSidebarDialog,\n    uploadImageMore\n  },\n  data() {\n    return {\n      formData: {\n        id: null,\n        name: '',\n        images: '',\n        categoryId: '',\n        shopId: '',\n        avgPrice: 0,\n        score: 5,\n        tags: '',\n        status: 1,\n        isRecommend: false,\n        description: '',\n        tasteFeature: '',\n        recommendReason: ''\n      },\n      addUrl: '/api/food/info/saveOrUpdate',\n      editUrl: '/api/food/info/saveOrUpdate',\n      categoryOptions: [],\n      shopOptions: [],\n      newUploadImgKey: new Date().getTime()\n    };\n  },\n  methods: {\n    initForm() {\n      this.newUploadImgKey = new Date().getTime();\n\n      // 获取分类列表\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          this.categoryOptions = res.data;\n        }\n      });\n\n      // 获取店铺列表\n      request({\n        url: config.backHost + \"/api/food/shop/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          this.shopOptions = res.data;\n        }\n      });\n    },\n    clearData() {\n      this.formData = {\n        id: null,\n        name: '',\n        images: '',\n        categoryId: '',\n        shopId: '',\n        avgPrice: 0,\n        score: 5,\n        tags: '',\n        status: 1,\n        isRecommend: false,\n        description: '',\n        tasteFeature: '',\n        recommendReason: ''\n      };\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.images) {\n        message += \"小吃图片不能为空<br>\";\n      }\n      if (!this.formData.name) {\n        message += \"小吃名称不能为空<br>\";\n      }\n      if (!this.formData.categoryId) {\n        message += \"小吃分类不能为空<br>\";\n      }\n      if (!this.formData.shopId) {\n        message += \"所属店铺不能为空<br>\";\n      }\n      if (!this.formData.description) {\n        message += \"小吃简介不能为空<br>\";\n      }\n      return message;\n    }\n  }\n};","map":{"version":3,"names":["FormUtils","request","config","OwnSidebarDialog","uploadImageMore","name","mixins","components","data","formData","id","images","categoryId","shopId","avgPrice","score","tags","status","isRecommend","description","tasteFeature","recommendReason","addUrl","editUrl","categoryOptions","shopOptions","newUploadImgKey","Date","getTime","methods","initForm","url","backHost","method","then","res","code","clearData","beforeSave","message"],"sources":["src/views/manage/foodInfo/FoodInfoForm.vue"],"sourcesContent":["<template>\n  <div class=\"form-box\">\n    <own-sidebar-dialog width=\"1000px\" :title=\"title\" :visible.sync=\"visible\" :before-close=\"closeDialog\" :modal=\"true\" :close-on-click-modal=\"false\">\n      <template #default>\n        <el-form :model=\"formData\" ref=\"form\" label-width=\"auto\" style=\"padding: 0 20px\">\n          <div style=\"display: flex;gap: 20px\">\n            <div style=\"flex-shrink: 0;width: 40%\">\n              <el-form-item prop=\"images\" label=\"小吃图片\">\n                <upload-image-more :key=\"newUploadImgKey\" v-model=\"formData.images\" :max=\"5\"/>\n                <p class=\"upload-tip\">最多可上传 5 张图片，支持 jpg、png 格式</p>\n              </el-form-item>\n              <el-form-item prop=\"name\" label=\"小吃名称\">\n                <el-input type=\"text\" v-model=\"formData.name\" style=\"width: 100%\"  placeholder=\"请输入小吃名称\"/>\n              </el-form-item>\n              <el-form-item prop=\"categoryId\" label=\"小吃分类\">\n                <el-select style=\"width: 100%;\" clearable v-model=\"formData.categoryId\"  placeholder=\"请选择小吃分类\">\n                  <el-option v-for=\"item in categoryOptions\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\"></el-option>\n                </el-select>\n              </el-form-item>\n              <el-form-item prop=\"shopId\" label=\"所属店铺\">\n                <el-select style=\"width: 100%;\" clearable v-model=\"formData.shopId\"  placeholder=\"请选择店铺\">\n                  <el-option v-for=\"item in shopOptions\" :key=\"item.id\" :label=\"item.shopName\" :value=\"item.id\"></el-option>\n                </el-select>\n              </el-form-item>\n              <el-form-item prop=\"avgPrice\" label=\"人均价格\">\n                <el-input-number v-model=\"formData.avgPrice\" :min=\"0\" :max=\"9999\" style=\"width: 100%\"></el-input-number>\n              </el-form-item>\n              <el-form-item prop=\"score\" label=\"评分\">\n                <el-rate v-model=\"formData.score\" :max=\"5\" show-score></el-rate>\n              </el-form-item>\n              <el-form-item prop=\"tags\" label=\"推荐标签\">\n                <el-input type=\"text\" v-model=\"formData.tags\" style=\"width: 100%\"  placeholder=\"多个标签用逗号分隔，如：必吃,特色,网红\"/>\n              </el-form-item>\n              <el-form-item prop=\"status\" label=\"状态\">\n                <el-radio-group v-model=\"formData.status\">\n                  <el-radio :label=\"1\">上架</el-radio>\n                  <el-radio :label=\"0\">下架</el-radio>\n                </el-radio-group>\n              </el-form-item>\n              <el-form-item prop=\"isRecommend\" label=\"首页推荐\">\n                <el-switch v-model=\"formData.isRecommend\" active-text=\"是\" inactive-text=\"否\"></el-switch>\n              </el-form-item>\n            </div>\n            <div style=\"flex-shrink: 0;width: 60%\">\n              <el-form-item prop=\"description\" label=\"小吃简介\">\n                <el-input type=\"textarea\" :rows=\"4\" v-model=\"formData.description\" style=\"width: 100%\"  placeholder=\"请输入小吃简介\"/>\n              </el-form-item>\n              <el-form-item prop=\"tasteFeature\" label=\"口味特色\">\n                <el-input type=\"textarea\" :rows=\"4\" v-model=\"formData.tasteFeature\" style=\"width: 100%\"  placeholder=\"请输入口味特色介绍\"/>\n              </el-form-item>\n              <el-form-item prop=\"recommendReason\" label=\"推荐理由\">\n                <el-input type=\"textarea\" :rows=\"4\" v-model=\"formData.recommendReason\" style=\"width: 100%\"  placeholder=\"请输入推荐理由\"/>\n              </el-form-item>\n            </div>\n          </div>\n        </el-form>\n      </template>\n      <template #footer>\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\n      </template>\n    </own-sidebar-dialog>\n  </div>\n</template>\n\n<script>\nimport FormUtils from '@/utils/formUtils'\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\nimport uploadImageMore from \"@/components/UploadImageMore.vue\";\n\nexport default {\n  name: \"FoodInfoForm\",\n  mixins: [FormUtils],\n  components: {OwnSidebarDialog, uploadImageMore},\n  data() {\n    return {\n      formData: {\n        id: null,\n        name: '',\n        images: '',\n        categoryId: '',\n        shopId: '',\n        avgPrice: 0,\n        score: 5,\n        tags: '',\n        status: 1,\n        isRecommend: false,\n        description: '',\n        tasteFeature: '',\n        recommendReason: ''\n      },\n      addUrl: '/api/food/info/saveOrUpdate',\n      editUrl: '/api/food/info/saveOrUpdate',\n      categoryOptions: [],\n      shopOptions: [],\n      newUploadImgKey: new Date().getTime(),\n    };\n  },\n  methods: {\n    initForm(){\n      this.newUploadImgKey = new Date().getTime();\n      \n      // 获取分类列表\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          this.categoryOptions = res.data;\n        }\n      });\n      \n      // 获取店铺列表\n      request({\n        url: config.backHost + \"/api/food/shop/list\",\n        method: 'POST'\n      }).then(res => {\n        if (res.code === 200) {\n          this.shopOptions = res.data;\n        }\n      });\n    },\n    clearData(){\n      this.formData = {\n        id: null,\n        name: '',\n        images: '',\n        categoryId: '',\n        shopId: '',\n        avgPrice: 0,\n        score: 5,\n        tags: '',\n        status: 1,\n        isRecommend: false,\n        description: '',\n        tasteFeature: '',\n        recommendReason: ''\n      };\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.images) {\n        message += \"小吃图片不能为空<br>\";\n      }\n      if (!this.formData.name) {\n        message += \"小吃名称不能为空<br>\";\n      }\n      if (!this.formData.categoryId) {\n        message += \"小吃分类不能为空<br>\";\n      }\n      if (!this.formData.shopId) {\n        message += \"所属店铺不能为空<br>\";\n      }\n      if (!this.formData.description) {\n        message += \"小吃简介不能为空<br>\";\n      }\n      return message;\n    },\n  }\n};\n</script>\n\n<style scoped lang=\"scss\">\n::v-deep .el-dialog__body{\n  max-height: 70vh;\n  overflow-x: hidden;\n  overflow-y: auto;\n}\n.upload-tip {\n  font-size: 12px;\n  color: #999;\n  margin-top: 5px;\n}\n</style>\n"],"mappings":"AAkEA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AACA,OAAAC,eAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAN,SAAA;EACAO,UAAA;IAAAJ,gBAAA;IAAAC;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,EAAA;QACAL,IAAA;QACAM,MAAA;QACAC,UAAA;QACAC,MAAA;QACAC,QAAA;QACAC,KAAA;QACAC,IAAA;QACAC,MAAA;QACAC,WAAA;QACAC,WAAA;QACAC,YAAA;QACAC,eAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,eAAA;MACAC,WAAA;MACAC,eAAA,MAAAC,IAAA,GAAAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA;MACA,KAAAJ,eAAA,OAAAC,IAAA,
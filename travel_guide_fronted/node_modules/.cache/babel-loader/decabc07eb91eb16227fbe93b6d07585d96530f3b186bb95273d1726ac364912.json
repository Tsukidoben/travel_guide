{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodInfoForm from \"@/views/manage/foodInfo/FoodInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\nexport default {\n  name: \"FoodInfoList\",\n  components: {\n    FoodInfoForm,\n    SearchTop\n  },\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/info/delete/\",\n      delBatchUrl: \"/api/food/info/delBatch\",\n      searchList: [{\n        type: 'input',\n        name: '关键字',\n        placeholder: '小吃名称、店铺名',\n        value: 'keyword'\n      }, {\n        type: 'select',\n        name: '状态',\n        placeholder: '全部',\n        value: 'status',\n        options: [{\n          label: '全部',\n          value: ''\n        }, {\n          label: '上架',\n          value: 1\n        }, {\n          label: '下架',\n          value: 0\n        }]\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    query(searchForm, pageBean) {\n      // 构造查询参数\n      const params = {\n        ...searchForm\n      };\n\n      // 如果状态为空字符串或未定义，显式设置为 null，告诉后端查询所有状态\n      if (params.status === '' || params.status === undefined) {\n        params.status = null;\n      }\n      request({\n        url: config.backHost + \"/api/food/info/listPage\",\n        method: 'POST',\n        data: {\n          current: pageBean.page,\n          size: pageBean.pageSize,\n          params: params\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    toggleStatus(row) {\n      const newStatus = row.status === 1 ? 0 : 1;\n      const actionText = newStatus === 1 ? '上架' : '下架';\n      this.$confirm(`确认${actionText}该小吃吗？`, '温馨提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        request({\n          url: config.backHost + \"/api/food/info/updateStatus\",\n          method: 'POST',\n          data: {\n            id: row.id,\n            status: newStatus\n          }\n        }).then(res => {\n          if (res.code === 200) {\n            this.$message.success(actionText + '成功');\n            // 清除状态筛选条件，避免下架/上架后的数据被过滤掉\n            this.$set(this.searchForm, 'status', '');\n            // 重置到第一页\n            this.pageBean.page = 1;\n            this.query(this.searchForm, this.pageBean);\n          } else {\n            this.$message.error(res.msg || actionText + '失败');\n          }\n        }).catch(err => {\n          this.$message.error(actionText + '失败，请检查后端服务');\n        });\n      }).catch(() => {\n        this.$message.info('已取消操作');\n      });\n    },\n    toggleRecommend(row) {\n      const newRecommend = !row.isRecommend;\n      request({\n        url: config.backHost + \"/api/food/info/updateRecommend\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          isRecommend: newRecommend ? 1 : 0 // 将 Boolean 转换为 Integer\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newRecommend ? '已设为首页推荐' : '已取消推荐');\n          this.query(this.searchForm, this.pageBean);\n        } else {\n          this.$message.error(res.msg || '操作失败');\n        }\n      }).catch(err => {\n        this.$message.error('更新推荐状态失败，请检查后端服务');\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","FoodInfoForm","SearchTop","common","name","components","mixins","data","delUrl","delBatchUrl","searchList","type","placeholder","value","options","label","computed","userRole","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","params","status","undefined","url","backHost","method","current","page","size","pageSize","then","res","code","tableData","toggleStatus","row","newStatus","actionText","$confirm","confirmButtonText","cancelButtonText","id","$message","success","$set","error","msg","catch","err","info","toggleRecommend","newRecommend","isRecommend"],"sources":["src/views/manage/foodInfo/FoodInfoList.vue"],"sourcesContent":["<template>\n  <div class=\"own-mvue-list-box\">\n    <!--搜索区域-->\n    <div class=\"own-list-search-box\">\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\n    </div>\n    <div class=\"newTableStyle\">\n      <!--列表操作区域-->\n      <div v-if=\"userRole == '1'\" class=\"own-list-action-box\" style=\"display:block;\">\n        <el-button plain v-if=\"userRole == '1'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增小吃',null)\">新增</el-button>\n        <el-button plain v-if=\"userRole == '1'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\n      </div>\n      <!--列表数据区域-->\n      <div class=\"own-list-table-box\">\n        <!-- 表格内容 -->\n        <div class=\"own-list-table-data-box\">\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\n            <el-table-column type=\"selection\" width=\"55\" />\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\n            <el-table-column prop=\"images\" label=\"小吃图片\" width=\"120\">\n              <template #default=\"{row}\">\n                <el-image :src=\"getPicUrlByJson(row.images, 0)\" style=\"width: 80px; height: 60px\" fit=\"cover\"></el-image>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"name\" label=\"小吃名称\" width=\"150\"/>\n            <el-table-column prop=\"categoryName\" label=\"分类\" width=\"100\"/>\n            <el-table-column prop=\"shopName\" label=\"店铺\" width=\"150\"/>\n            <el-table-column prop=\"score\" label=\"评分\" width=\"100\">\n              <template #default=\"{row}\">\n                <el-rate v-model=\"row.score\" disabled show-score text-color=\"#ff9900\"></el-rate>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"avgPrice\" label=\"人均\" width=\"80\">\n              <template #default=\"{row}\">\n                ¥{{ row.avgPrice }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"isRecommend\" label=\"推荐\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-tag :type=\"row.isRecommend ? 'success' : 'info'\" size=\"mini\">\n                  {{ row.isRecommend ? '是' : '否' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"status\" label=\"状态\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-tag :type=\"row.status === 1 ? 'success' : 'danger'\" size=\"mini\">\n                  {{ row.status === 1 ? '上架' : '下架' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"250\">\n              <template #default=\"{ row }\">\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"openForm('edit', '编辑小吃', row)\">编辑</span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"toggleStatus(row)\">\n                  {{ row.status === 1 ? '下架' : '上架' }}\n                </span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"toggleRecommend(row)\">\n                  {{ row.isRecommend ? '取消推荐' : '设为首页推荐' }}\n                </span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;border-color: red\" @click=\"delById(row, delUrl)\">删除</span>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n\n        <!--分页区域-->\n        <el-pagination\n                :current-page=\"pageBean.page\"\n                :page-sizes=\"[10, 20, 50, 100]\"\n                :page-size=\"pageBean.pageSize\"\n                layout=\"total, sizes, prev, pager, next\"\n                :total=\"pageBean.total\"\n                @current-change=\"currPageChange\"\n                @size-change=\"handleSizeChange\" />\n      </div>\n    </div>\n    <!--表单-->\n    <FoodInfoForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\n  </div>\n</template>\n\n<script>\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodInfoForm from \"@/views/manage/foodInfo/FoodInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\n\nexport default {\n  name: \"FoodInfoList\",\n  components: { FoodInfoForm, SearchTop},\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/info/delete/\",\n      delBatchUrl: \"/api/food/info/delBatch\",\n      searchList: [\n        {type:'input',name:'关键字',placeholder:'小吃名称、店铺名',value:'keyword'},\n        {type:'select',name:'状态',placeholder:'全部',value:'status',options:[\n          {label:'全部',value:''},\n          {label:'上架',value:1},\n          {label:'下架',value:0}\n        ]}\n      ]\n    }\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    },\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData(){\n    },\n    query(searchForm, pageBean) {\n      // 构造查询参数\n      const params = {...searchForm};\n      \n      // 如果状态为空字符串或未定义，显式设置为 null，告诉后端查询所有状态\n      if (params.status === '' || params.status === undefined) {\n        params.status = null;\n      }\n      \n      request({\n        url: config.backHost + \"/api/food/info/listPage\",\n        method: 'POST',\n        data: { \n          current: pageBean.page,\n          size: pageBean.pageSize,\n          params: params\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    toggleStatus(row) {\n      const newStatus = row.status === 1 ? 0 : 1;\n      const actionText = newStatus === 1 ? '上架' : '下架';\n      \n      this.$confirm(`确认${actionText}该小吃吗？`, '温馨提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        request({\n          url: config.backHost + \"/api/food/info/updateStatus\",\n          method: 'POST',\n          data: {\n            id: row.id,\n            status: newStatus\n          }\n        }).then(res => {\n          if (res.code === 200) {\n            this.$message.success(actionText + '成功');\n            // 清除状态筛选条件，避免下架/上架后的数据被过滤掉\n            this.$set(this.searchForm, 'status', '');\n            // 重置到第一页\n            this.pageBean.page = 1;\n            this.query(this.searchForm, this.pageBean);\n          } else {\n            this.$message.error(res.msg || actionText + '失败');\n          }\n        }).catch(err => {\n          this.$message.error(actionText + '失败，请检查后端服务');\n        });\n      }).catch(() => {\n        this.$message.info('已取消操作');\n      });\n    },\n    toggleRecommend(row) {\n      const newRecommend = !row.isRecommend;\n      \n      request({\n        url: config.backHost + \"/api/food/info/updateRecommend\",\n        method: 'POST',\n        data: {\n          id: row.id,\n          isRecommend: newRecommend ? 1 : 0  // 将 Boolean 转换为 Integer\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success(newRecommend ? '已设为首页推荐' : '已取消推荐');\n          this.query(this.searchForm, this.pageBean);\n        } else {\n          this.$message.error(res.msg || '操作失败');\n        }\n      }).catch(err => {\n        this.$message.error('更新推荐状态失败，请检查后端服务');\n      });\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n@use \"@/assets/css/table.scss\";\n</style>\n"],"mappings":"AAmFA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,YAAA;AACA,OAAAC,SAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAJ,YAAA;IAAAC;EAAA;EACAI,MAAA,GAAAR,UAAA,EAAAK,MAAA;EACAI,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAP,IAAA;QAAAQ,WAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,IAAA;QAAAP,IAAA;QAAAQ,WAAA;QAAAC,KAAA;QAAAC,OAAA,GACA;UAAAC,KAAA;UAAAF,KAAA;QAAA,GACA;UAAAE,KAAA;UAAAF,KAAA;QAAA,GACA;UAAAE,KAAA;UAAAF,KAAA;QAAA;MACA;IAEA;EACA;EACAG,QAAA;IACAC,SAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA,CAAAH,QAAA;IACA;EACA;EACAI,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAJ,SAAA,GACA;IACAC,MAAAC,UAAA,EAAAC,QAAA;MACA;MACA,MAAAE,MAAA;QAAA,GAAAH;MAAA;;MAEA;MACA,IAAAG,MAAA,CAAAC,MAAA,WAAAD,MAAA,CAAAC,MAAA,KAAAC,SAAA;QACAF,MAAA,CAAAC,MAAA;MACA;MAEA7B,OAAA;QACA+B,GAAA,EAAA9B,MAAA,CAAA+B,QAAA;QACAC,MAAA;QACAzB,IAAA;UACA0B,OAAA,EAAAR,QAAA,CAAAS,IAAA;UACAC,IAAA,EAAAV,QAAA,CAAAW,QAAA;UACAT,MAAA,EAAAA;QACA;MACA,GAAAU,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAA/B,IAAA;UACA,KAAAkB,QAAA,GAAAa,GAAA,CAAAb,QAAA;QACA;MACA;IACA;IACAgB,aAAAC,GAAA;MACA,MAAAC,SAAA,GAAAD,GAAA,CAAAd,MAAA;MACA,MAAAgB,UAAA,GAAAD,SAAA;MAEA,KAAAE,QAAA,MAAAD,UAAA;QACAE,iBAAA;QACAC,gBAAA;QACApC,IAAA;MACA,GAAA0B,IAAA;QACAtC,OAAA;UACA+B,GAAA,EAAA9B,MAAA,CAAA+B,QAAA;UACAC,MAAA;UACAzB,IAAA;YACAyC,EAAA,EAAAN,GAAA,CAAAM,EAAA;YACApB,MAAA,EAAAe;UACA;QACA,GAAAN,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAU,QAAA,CAAAC,OAAA,CAAAN,UAAA;YACA;YACA,KAAAO,IAAA,MAAA3B,UAAA;YACA;YACA,KAAAC,QAAA,CAAAS,IAAA;YACA,KAAAX,KAAA,MAAAC,UAAA,OAAAC,QAAA;UACA;YACA,KAAAwB,QAAA,CAAAG,KAAA,CAAAd,GAAA,CAAAe,GAAA,IAAAT,UAAA;UACA;QACA,GAAAU,KAAA,CAAAC,GAAA;UACA,KAAAN,QAAA,CAAAG,KAAA,CAAAR,UAAA;QACA;MACA,GAAAU,KAAA;QACA,KAAAL,QAAA,CAAAO,IAAA;MACA;IACA;IACAC,gBAAAf,GAAA;MACA,MAAAgB,YAAA,IAAAhB,GAAA,CAAAiB,WAAA;MAEA5D,OAAA;QACA+B,GAAA,EAAA9B,MAAA,CAAA+B,QAAA;QACAC,MAAA;QACAzB,IAAA;UACAyC,EAAA,EAAAN,GAAA,CAAAM,EAAA;UACAW,WAAA,EAAAD,YAAA;QACA;MACA,GAAArB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAU,QAAA,CAAAC,OAAA,CAAAQ,YAAA;UACA,KAAAnC,KAAA,MAAAC,UAAA,OAAAC,QAAA;QACA;UACA,KAAAwB,QAAA,CAAAG,KAAA,CAAAd,GAAA,CAAAe,GAAA;QACA;MACA,GAAAC,KAAA,CAAAC,GAAA;QACA,KAAAN,QAAA,CAAAG,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
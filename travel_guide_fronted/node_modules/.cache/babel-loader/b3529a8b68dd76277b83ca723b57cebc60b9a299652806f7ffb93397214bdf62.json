{"ast":null,"code":"import FormUtils from '@/utils/formUtils';\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\nimport UploadImageSignel from \"@/components/UploadImageSignel.vue\";\nimport wangEditorComponent from \"@/components/WangEditorComponent.vue\";\nexport default {\n  name: \"HotelInfoForm\",\n  mixins: [FormUtils],\n  components: {\n    OwnSidebarDialog,\n    UploadImageSignel,\n    wangEditorComponent\n  },\n  data() {\n    return {\n      formData: {\n        htoelPic: '',\n        htoelName: '',\n        address: '',\n        hotelDesc: '',\n        hotelDetail: '',\n        hotelService: '',\n        longitude: '',\n        latitude: ''\n      },\n      addUrl: '/hotelInfo/saveOrUpdate',\n      editUrl: '/hotelInfo/saveOrUpdate',\n      geoLoading: false // 经纬度获取loading状态\n    };\n  },\n  methods: {\n    initForm() {},\n    clearData() {\n      this.formData = {\n        htoelPic: '',\n        htoelName: '',\n        address: '',\n        hotelDesc: '',\n        hotelDetail: '',\n        hotelService: '',\n        longitude: '',\n        latitude: ''\n      };\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.htoelPic) {\n        message += \"酒店图片不能为空<br>\";\n      }\n      if (!this.formData.htoelName) {\n        message += \"酒店名称不能为空<br>\";\n      }\n      if (!this.formData.address) {\n        message += \"酒店地址不能为空<br>\";\n      }\n      if (!this.formData.hotelService) {\n        message += \"酒店服务不能为空<br>\";\n      }\n      if (!this.formData.hotelDesc) {\n        message += \"酒店介绍不能为空<br>\";\n      }\n      if (!this.formData.hotelDetail) {\n        message += \"酒店描述不能为空<br>\";\n      }\n      return message;\n    },\n    // 获取经纬度\n    async handleGetCoordinates(type) {\n      const address = this.formData.address;\n      if (!address || !address.trim()) {\n        this.$message.warning('请先输入地址');\n        return;\n      }\n      this.geoLoading = true;\n      try {\n        const res = await request({\n          url: config.backHost + '/api/common/geoCode',\n          method: 'POST',\n          data: {\n            address: address\n          }\n        });\n        if (res.code === 200 && res.data) {\n          this.formData.longitude = res.data.longitude || '';\n          this.formData.latitude = res.data.latitude || '';\n          this.$message.success('经纬度获取成功');\n        } else {\n          this.$message.error('地址解析失败，请检查地址格式或手动输入');\n        }\n      } catch (error) {\n        console.error('地址解析失败:', error);\n        this.$message.error('地址解析失败，请检查地址格式或手动输入');\n      } finally {\n        this.geoLoading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["FormUtils","request","config","OwnSidebarDialog","UploadImageSignel","wangEditorComponent","name","mixins","components","data","formData","htoelPic","htoelName","address","hotelDesc","hotelDetail","hotelService","longitude","latitude","addUrl","editUrl","geoLoading","methods","initForm","clearData","beforeSave","message","handleGetCoordinates","type","trim","$message","warning","res","url","backHost","method","code","success","error","console"],"sources":["src/views/manage/hotelInfo/HotelInfoForm.vue"],"sourcesContent":["<template>\r\n  <div class=\"form-box\">\r\n    <own-sidebar-dialog width=\"1000px\" :title=\"title\" :visible.sync=\"visible\" :before-close=\"closeDialog\" :modal=\"true\" :close-on-click-modal=\"false\">\r\n      <template #default>\r\n        <el-form :model=\"formData\" ref=\"form\" label-width=\"auto\" style=\"padding: 0 20px\">\r\n          <div style=\"display: flex;gap: 20px\">\r\n            <div style=\"width: 40%\">\r\n              <el-form-item prop=\"htoelPic\" label=\"酒店图片\">\r\n                <upload-image-signel v-model=\"formData.htoelPic\"/>\r\n              </el-form-item>\r\n              <el-form-item prop=\"htoelName\" label=\"酒店名称\">\r\n                <el-input type=\"text\" v-model=\"formData.htoelName\" style=\"width: 100%\"  placeholder=\"请输入酒店名称\"/>\r\n              </el-form-item>\r\n              <el-form-item prop=\"address\" label=\"酒店地址\">\r\n                <div style=\"display: flex; gap: 10px; align-items: flex-start;\">\r\n                  <el-input type=\"textarea\" :rows=\"2\" v-model=\"formData.address\" style=\"flex: 1\" placeholder=\"请输入酒店地址\" @blur=\"handleGetCoordinates('hotel')\" />\r\n                  <el-button type=\"primary\" size=\"small\" :loading=\"geoLoading\" @click=\"handleGetCoordinates('hotel')\" style=\"flex-shrink: 0;\">获取经纬度</el-button>\r\n                </div>\r\n                <!-- 隐藏字段存储经纬度 -->\r\n                <el-input type=\"hidden\" v-model=\"formData.longitude\" />\r\n                <el-input type=\"hidden\" v-model=\"formData.latitude\" />\r\n              </el-form-item>\r\n              <el-form-item prop=\"hotelService\" label=\"酒店服务\">\r\n                <el-input type=\"textarea\" :row=\"3\" v-model=\"formData.hotelService\" style=\"width: 100%\"  placeholder=\"请输入酒店服务\"/>\r\n              </el-form-item>\r\n              <el-form-item prop=\"hotelDesc\" label=\"酒店介绍\">\r\n                <el-input type=\"textarea\" :row=\"3\" v-model=\"formData.hotelDesc\" style=\"width: 100%\"  placeholder=\"请输入酒店介绍\"/>\r\n              </el-form-item>\r\n            </div>\r\n            <div style=\"width: 60%\">\r\n              <el-form-item prop=\"hotelDetail\" label=\"酒店描述\">\r\n                <wangEditorComponent :height=\"500\" v-model=\"formData.hotelDetail\" />\r\n              </el-form-item>\r\n            </div>\r\n          </div>\r\n        </el-form>\r\n      </template>\r\n      <template #footer>\r\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\r\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\r\n      </template>\r\n    </own-sidebar-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport FormUtils from '@/utils/formUtils'\r\nimport request from \"@/utils/request\";\r\nimport config from \"@/config/config\";\r\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\r\nimport UploadImageSignel from \"@/components/UploadImageSignel.vue\";\r\nimport wangEditorComponent from \"@/components/WangEditorComponent.vue\";\r\n\r\nexport default {\r\n  name: \"HotelInfoForm\",\r\n  mixins: [FormUtils],\r\n  components: {OwnSidebarDialog  , UploadImageSignel  , wangEditorComponent },\r\n  data() {\r\n    return {\r\n      formData: {\r\n          htoelPic: '',\r\n          htoelName: '',\r\n          address: '',\r\n          hotelDesc: '',\r\n          hotelDetail: '',\r\n          hotelService: '',\r\n          longitude: '',\r\n          latitude: ''\r\n      },\r\n      addUrl: '/hotelInfo/saveOrUpdate',\r\n      editUrl: '/hotelInfo/saveOrUpdate',\r\n      geoLoading: false // 经纬度获取loading状态\r\n    };\r\n  },\r\n  methods: {\r\n    initForm(){\r\n    },\r\n    clearData(){\r\n      this.formData = {\r\n        htoelPic: '',\r\n        htoelName: '',\r\n        address: '',\r\n        hotelDesc: '',\r\n        hotelDetail: '',\r\n        hotelService: '',\r\n        longitude: '',\r\n        latitude: ''\r\n      };\r\n    },\r\n    beforeSave() {\r\n      let message = '';\r\n      if (!this.formData.htoelPic) {\r\n        message += \"酒店图片不能为空<br>\";\r\n      }\r\n      if (!this.formData.htoelName) {\r\n        message += \"酒店名称不能为空<br>\";\r\n      }\r\n      if (!this.formData.address) {\r\n        message += \"酒店地址不能为空<br>\";\r\n      }\r\n      if (!this.formData.hotelService) {\r\n        message += \"酒店服务不能为空<br>\";\r\n      }\r\n      if (!this.formData.hotelDesc) {\r\n        message += \"酒店介绍不能为空<br>\";\r\n      }\r\n      if (!this.formData.hotelDetail) {\r\n        message += \"酒店描述不能为空<br>\";\r\n      }\r\n      return message;\r\n    },\r\n    // 获取经纬度\r\n    async handleGetCoordinates(type) {\r\n      const address = this.formData.address;\r\n      if (!address || !address.trim()) {\r\n        this.$message.warning('请先输入地址');\r\n        return;\r\n      }\r\n      \r\n      this.geoLoading = true;\r\n      try {\r\n        const res = await request({\r\n          url: config.backHost + '/api/common/geoCode',\r\n          method: 'POST',\r\n          data: { address: address }\r\n        });\r\n        \r\n        if (res.code === 200 && res.data) {\r\n          this.formData.longitude = res.data.longitude || '';\r\n          this.formData.latitude = res.data.latitude || '';\r\n          this.$message.success('经纬度获取成功');\r\n        } else {\r\n          this.$message.error('地址解析失败，请检查地址格式或手动输入');\r\n        }\r\n      } catch (error) {\r\n        console.error('地址解析失败:', error);\r\n        this.$message.error('地址解析失败，请检查地址格式或手动输入');\r\n      } finally {\r\n        this.geoLoading = false;\r\n      }\r\n    },\r\n  }\r\n};\r\n</script>\r\n"],"mappings":"AA8CA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AACA,OAAAC,iBAAA;AACA,OAAAC,mBAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAP,SAAA;EACAQ,UAAA;IAAAL,gBAAA;IAAAC,iBAAA;IAAAC;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,QAAA;QACAC,SAAA;QACAC,OAAA;QACAC,SAAA;QACAC,WAAA;QACAC,YAAA;QACAC,SAAA;QACAC,QAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA,GACA;IACAC,UAAA;MACA,KAAAd,QAAA;QACAC,QAAA;QACAC,SAAA;QACAC,OAAA;QACAC,SAAA;QACAC,WAAA;QACAC,YAAA;QACAC,SAAA;QACAC,QAAA;MACA;IACA;IACAO,WAAA;MACA,IAAAC,OAAA;MACA,UAAAhB,QAAA,CAAAC,QAAA;QACAe,OAAA;MACA;MACA,UAAAhB,QAAA,CAAAE,SAAA;QACAc,OAAA;MACA;MACA,UAAAhB,QAAA,CAAAG,OAAA;QACAa,OAAA;MACA;MACA,UAAAhB,QAAA,CAAAM,YAAA;QACAU,OAAA;MACA;MACA,UAAAhB,QAAA,CAAAI,SAAA;QACAY,OAAA;MACA;MACA,UAAAhB,QAAA,CAAAK,WAAA;QACAW,OAAA;MACA;MACA,OAAAA,OAAA;IACA;IACA;IACA,MAAAC,qBAAAC,IAAA;MACA,MAAAf,OAAA,QAAAH,QAAA,CAAAG,OAAA;MACA,KAAAA,OAAA,KAAAA,OAAA,CAAAgB,IAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA;MACA;MAEA,KAAAV,UAAA;MACA;QACA,MAAAW,GAAA,SAAA/B,OAAA;UACAgC,GAAA,EAAA/B,MAAA,CA
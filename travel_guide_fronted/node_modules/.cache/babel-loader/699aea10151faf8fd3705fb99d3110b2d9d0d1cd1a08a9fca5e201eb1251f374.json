{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodCategoryForm from \"@/views/manage/foodInfo/FoodCategoryForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nexport default {\n  name: \"FoodCategoryList\",\n  components: {\n    FoodCategoryForm,\n    SearchTop\n  },\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/api/food/category/delete/\",\n      delBatchUrl: \"/api/food/category/delBatch\",\n      searchList: [{\n        type: 'input',\n        name: '关键字',\n        placeholder: '分类名称',\n        value: 'keyword'\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/category/listPage\",\n        method: 'POST',\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    updateSort(row) {\n      request({\n        url: config.backHost + \"/api/food/category/update\",\n        method: 'POST',\n        data: row\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success('排序更新成功');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","FoodCategoryForm","SearchTop","name","components","mixins","data","delUrl","delBatchUrl","searchList","type","placeholder","value","computed","userRole","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","url","backHost","method","params","then","res","code","tableData","updateSort","row","$message","success"],"sources":["src/views/manage/foodInfo/FoodCategoryList.vue"],"sourcesContent":["<template>\n  <div class=\"own-mvue-list-box\">\n    <!--搜索区域-->\n    <div class=\"own-list-search-box\">\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\n    </div>\n    <div class=\"newTableStyle\">\n      <!--列表操作区域-->\n      <div v-if=\"userRole == '1'\" class=\"own-list-action-box\" style=\"display:block;\">\n        <el-button plain v-if=\"userRole == '1'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增分类',null)\">新增</el-button>\n        <el-button plain v-if=\"userRole == '1'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\n      </div>\n      <!--列表数据区域-->\n      <div class=\"own-list-table-box\">\n        <!-- 表格内容 -->\n        <div class=\"own-list-table-data-box\">\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\n            <el-table-column type=\"selection\" width=\"55\" />\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\n            <el-table-column prop=\"categoryName\" label=\"分类名称\"/>\n            <el-table-column prop=\"sort\" label=\"排序\" width=\"100\">\n              <template #default=\"{row}\">\n                <el-input-number v-if=\"userRole == '1'\" v-model=\"row.sort\" :min=\"0\" :max=\"999\" size=\"mini\" @change=\"updateSort(row)\" />\n                <span v-else>{{ row.sort }}</span>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"createTime\" width=\"160\" label=\"创建时间\">\n              <template #default=\"{row,$index}\">\n                {{ timestampToYMDHMS(row.createTime) }}\n              </template>\n            </el-table-column>\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"150\">\n              <template #default=\"{ row }\">\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"openForm('edit', '编辑分类', row)\">编辑</span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;border-color: red\" @click=\"delById(row, delUrl)\">删除</span>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n\n        <!--分页区域-->\n        <el-pagination\n                :current-page=\"pageBean.page\"\n                :page-sizes=\"[10, 20, 50, 100]\"\n                :page-size=\"pageBean.pageSize\"\n                layout=\"total, sizes, prev, pager, next\"\n                :total=\"pageBean.total\"\n                @current-change=\"currPageChange\"\n                @size-change=\"handleSizeChange\" />\n      </div>\n    </div>\n    <!--表单-->\n    <FoodCategoryForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\n  </div>\n</template>\n\n<script>\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport FoodCategoryForm from \"@/views/manage/foodInfo/FoodCategoryForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\n\nexport default {\n  name: \"FoodCategoryList\",\n  components: { FoodCategoryForm, SearchTop},\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/api/food/category/delete/\",\n      delBatchUrl: \"/api/food/category/delBatch\",\n      searchList: [\n        {type:'input',name:'关键字',placeholder:'分类名称',value:'keyword'},\n      ]\n    }\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    },\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData(){\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/category/listPage\",\n        method: 'POST',\n        data: { params: searchForm, pageBean: pageBean }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    updateSort(row) {\n      request({\n        url: config.backHost + \"/api/food/category/update\",\n        method: 'POST',\n        data: row\n      }).then(res => {\n        if (res.code === 200) {\n          this.$message.success('排序更新成功');\n        }\n      });\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n@use \"@/assets/css/table.scss\";\n</style>\n"],"mappings":"AAyDA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AACA,OAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH,gBAAA;IAAAC;EAAA;EACAG,MAAA,GAAAP,UAAA;EACAQ,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAP,IAAA;QAAAQ,WAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA,CAAAH,QAAA;IACA;EACA;EACAI,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAJ,SAAA,GACA;IACAC,MAAAC,UAAA,EAAAC,QAAA;MACAvB,OAAA;QACAyB,GAAA,EAAAxB,MAAA,CAAAyB,QAAA;QACAC,MAAA;QACApB,IAAA;UAAAqB,MAAA,EAAAN,UAAA;UAAAC,QAAA,EAAAA;QAAA;MACA,GAAAM,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAAvB,IAAA;UACA,KAAAgB,QAAA,GAAAO,GAAA,CAAAP,QAAA;QACA;MACA;IACA;IACAU,WAAAC,GAAA;MACAlC,OAAA;QACAyB,GAAA,EAAAxB,MAAA,CAAAyB,QAAA;QACAC,MAAA;QACApB,IAAA,EAAA2B;MACA,GAAAL,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAI,QAAA,CAAAC,OAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport HotelInfoForm from \"@/views/manage/hotelInfo/HotelInfoForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nexport default {\n  name: \"HotelInfoList\",\n  components: {\n    HotelInfoForm,\n    SearchTop\n  },\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/hotelInfo/delById/\",\n      delBatchUrl: \"/hotelInfo/delBatch\",\n      searchList: [{\n        type: 'input',\n        name: '关键字',\n        placeholder: '酒店名称、酒店介绍',\n        value: 'keyword'\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      const user = this.$store.getters.getUser;\n      return user ? user.userRole : null;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/hotelInfo/listPage\",\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","HotelInfoForm","SearchTop","name","components","mixins","data","delUrl","delBatchUrl","searchList","type","placeholder","value","computed","userRole","user","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","url","backHost","params","then","res","code","tableData"],"sources":["src/views/manage/hotelInfo/HotelInfoList.vue"],"sourcesContent":["<template>\r\n  <div class=\"own-mvue-list-box\">\r\n    <!--搜索区域-->\r\n    <div class=\"own-list-search-box\">\r\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\r\n    </div>\r\n    <div class=\"newTableStyle\">\r\n      <!--列表操作区域-->\r\n      <div v-if=\"userRole == '3'\" class=\"own-list-action-box\" style=\"display:block;\">\r\n        <el-button plain v-if=\"userRole == '3'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增酒店',null)\">新增</el-button>\r\n        <el-button plain v-if=\"userRole == '3'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\r\n      </div>\r\n      <!--列表数据区域-->\r\n      <div class=\"own-list-table-box\">\r\n        <!-- 表格内容 -->\r\n        <div class=\"own-list-table-data-box\">\r\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\r\n            <el-table-column type=\"selection\" width=\"55\" />\r\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\r\n            <el-table-column prop=\"htoelPic\" width=\"100\" label=\"酒店图片\">\r\n              <template #default=\"{row,$index}\">\r\n                <el-image style=\"width: 60px;height: 60px\" :src=\"getPicUrlByJson(row.htoelPic,0)\" :preview-src-list=\"[getPicUrlByJson(row.htoelPic,0)]\"></el-image>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"htoelName\" min-width=\"150\" label=\"酒店名称\"/>\r\n            <el-table-column prop=\"hotelDesc\" min-width=\"180\" label=\"酒店介绍\"/>\r\n            <el-table-column prop=\"hotelDetail\" min-width=\"180\" label=\"酒店描述\">\r\n              <template #default=\"{row,$index}\">\r\n                <span class=\"two-line\">{{ getHtmlPlainText(row.hotelDetail) }}</span>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"hotelService\"  min-width=\"150\" label=\"酒店服务\"/>\r\n            <el-table-column fixed=\"right\" v-if=\"userRole == '3'\" label=\"操作\" width=\"150\">\r\n              <template #default=\"{ row }\">\r\n                <span v-if=\"userRole == '3'\" class=\"span-button\" @click=\"openForm('edit', '编辑酒店', row)\">编辑</span>\r\n                <span v-if=\"userRole == '3'\" class=\"span-button\" style=\"color:red;\" @click=\"delById(row, delUrl)\">删除</span>\r\n              </template>\r\n            </el-table-column>\r\n          </el-table>\r\n        </div>\r\n\r\n        <!--分页区域-->\r\n        <el-pagination\r\n                :current-page=\"pageBean.page\"\r\n                :page-sizes=\"[10, 20, 50, 100]\"\r\n                :page-size=\"pageBean.pageSize\"\r\n                layout=\"total, sizes, prev, pager, next\"\r\n                :total=\"pageBean.total\"\r\n                @current-change=\"currPageChange\"\r\n                @size-change=\"handleSizeChange\" />\r\n      </div>\r\n    </div>\r\n    <!--表单-->\r\n    <HotelInfoForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport TableUtils from \"@/utils/tableUtils\";\r\nimport request from \"@/utils/request\";\r\nimport config from \"@/config/config\";\r\nimport HotelInfoForm from \"@/views/manage/hotelInfo/HotelInfoForm.vue\";\r\nimport SearchTop from \"@/components/searchTop.vue\";\r\n\r\nexport default {\r\n  name: \"HotelInfoList\",\r\n  components: { HotelInfoForm ,SearchTop},\r\n  mixins: [TableUtils],\r\n  data() {\r\n    return {\r\n      delUrl: \"/hotelInfo/delById/\",\r\n      delBatchUrl: \"/hotelInfo/delBatch\",\r\n      searchList: [\r\n        {type:'input',name:'关键字',placeholder:'酒店名称、酒店介绍',value:'keyword'},\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    userRole() {\r\n      const user = this.$store.getters.getUser;\r\n      return user ? user.userRole : null;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.initData();\r\n    this.query(this.searchForm, this.pageBean);\r\n  },\r\n  methods: {\r\n    initData(){\r\n    },\r\n    query(searchForm, pageBean) {\r\n      request({\r\n        url: config.backHost + \"/hotelInfo/listPage\",\r\n        data: { params: searchForm, pageBean: pageBean }\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.tableData = res.data;\r\n          this.pageBean = res.pageBean;\r\n        }\r\n      });\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n@use \"@/assets/css/table.scss\";\r\n</style>\r\n"],"mappings":"AA0DA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,aAAA;AACA,OAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH,aAAA;IAAAC;EAAA;EACAG,MAAA,GAAAP,UAAA;EACAQ,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAP,IAAA;QAAAQ,WAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,MAAAC,IAAA,QAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA;MACA,OAAAH,IAAA,GAAAA,IAAA,CAAAD,QAAA;IACA;EACA;EACAK,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAJ,SAAA,GACA;IACAC,MAAAC,UAAA,EAAAC,QAAA;MACAxB,OAAA;QACA0B,GAAA,EAAAzB,MAAA,CAAA0B,QAAA;QACApB,IAAA;UAAAqB,MAAA,EAAAL,UAAA;UAAAC,QAAA,EAAAA;QAAA;MACA,GAAAK,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAAvB,IAAA;UACA,KAAAiB,QAAA,GAAAM,GAAA,CAAAN,QAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
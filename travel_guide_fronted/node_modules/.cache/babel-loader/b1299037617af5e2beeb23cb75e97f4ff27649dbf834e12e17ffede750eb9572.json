{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport request from '@/utils/request';\nimport config from '@/config/config';\nexport default {\n  name: 'RouteDetail',\n  data() {\n    return {\n      routeDetail: null,\n      loading: false,\n      loadError: false,\n      activeDay: '1'\n    };\n  },\n  mounted() {\n    this.loadRouteDetail();\n  },\n  methods: {\n    // 加载路线详情\n    async loadRouteDetail() {\n      const recommendationId = this.$route.params.id;\n      if (!recommendationId) {\n        this.$message.error('缺少路线ID');\n        this.goBack();\n        return;\n      }\n      this.loading = true;\n      this.loadError = false;\n      try {\n        const res = await request({\n          url: config.backHost + `/api/routeRecommendation/detail/${recommendationId}`,\n          method: 'POST'\n        });\n        if (res.code === 200 && res.data) {\n          this.routeDetail = res.data;\n          this.activeDay = '1';\n        } else {\n          this.$message.error(res.msg || '加载失败');\n          this.loadError = true;\n        }\n      } catch (error) {\n        console.error('加载路线详情失败:', error);\n        this.$message.error('加载路线详情失败');\n        this.loadError = true;\n      } finally {\n        this.loading = false;\n      }\n    },\n    // 返回\n    goBack() {\n      this.$router.go(-1);\n    },\n    // 收藏路线\n    // 已移除收藏功能，只保留删除\n\n    // 删除路线\n    deleteRoute() {\n      const recommendationId = this.$route.params.id;\n      this.$confirm('确定要删除这条行程记录吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await request({\n            url: config.backHost + `/api/routeRecommendation/delete/${recommendationId}`,\n            method: 'POST'\n          });\n          if (res.code === 200) {\n            this.$message.success('删除成功');\n            this.goBack();\n          } else {\n            this.$message.error(res.msg || '删除失败');\n          }\n        } catch (error) {\n          console.error('删除失败:', error);\n          this.$message.error('删除失败');\n        }\n      }).catch(() => {\n        this.$message.info('已取消删除');\n      });\n    },\n    // 获取图片数组\n    getImages(imagesStr) {\n      if (!imagesStr) return [];\n      try {\n        return JSON.parse(imagesStr);\n      } catch (e) {\n        return imagesStr.split(',').filter(img => img);\n      }\n    },\n    // 获取交通方式文本\n    getTransportText(type) {\n      const map = {\n        'drive': '自驾',\n        'bus': '公交',\n        'taxi': '打车',\n        'walking': '步行',\n        // 高德 API 返回 walking\n        'walk': '步行' // 兼容旧数据\n      };\n      return map[type] || type;\n    },\n    // 格式化时长\n    formatDuration(minutes) {\n      if (!minutes && minutes !== 0) return '暂无数据';\n      const hours = Math.floor(minutes / 60);\n      const mins = minutes % 60;\n      if (hours > 0 && mins > 0) {\n        return `${hours}小时${mins}分钟`;\n      } else if (hours > 0) {\n        return `${hours}小时`;\n      } else {\n        return `${mins}分钟`;\n      }\n    },\n    // 获取费用样式类\n    getCostClass(summary) {\n      if (summary.estimatedCost <= summary.budget) {\n        return 'cost under-budget'; // 预算内：绿色\n      } else {\n        return 'cost over-budget'; // 超预算：红色\n      }\n    },\n    // 跳转到景点详情\n    goToAttractionDetail(attractionId) {\n      if (attractionId) {\n        this.$router.push({\n          name: 'attractionDetail',\n          query: {\n            id: attractionId\n          }\n        });\n      }\n    },\n    // 跳转到酒店详情\n    goToHotelDetail(hotelId) {\n      if (hotelId) {\n        this.$router.push({\n          name: 'hotelDetail',\n          query: {\n            id: hotelId\n          }\n        });\n      }\n    },\n    // 打开地图导航\n    async openNavigation(item) {\n      console.log('导航数据:', item);\n\n      // 优先使用经纬度坐标，如果有的话\n      if (item.fromLongitude && item.fromLatitude && item.toLongitude && item.toLatitude) {\n        // 使用经纬度坐标导航（更精确）\n        const fromCoord = `${item.fromLongitude},${item.fromLatitude}`;\n        const toCoord = `${item.toLongitude},${item.toLatitude}`;\n\n        // 根据交通方式确定导航模式\n        let mode = 'drive'; // 默认驾车\n        if (item.transportType === 'bus') {\n          mode = 'bus'; // 公交\n        } else if (item.transportType === 'walk' || item.transportType === 'walking') {\n          mode = 'walk'; // 步行\n        }\n        console.log('使用坐标导航:', fromCoord, '->', toCoord, 'mode:', mode);\n        const amapUrl = `https://uri.amap.com/navigation?from=${fromCoord}&to=${toCoord}&mode=${mode}&src=贵阳旅游攻略系统`;\n        console.log('导航URL:', amapUrl);\n        window.open(amapUrl, '_blank');\n      } else if (item.fromLocation && item.toLocation) {\n        // 如果没有坐标，尝试调用逆地址解析接口获取坐标\n        try {\n          this.$message.info('正在获取位置信息...');\n\n          // 并行获取起点和终点的坐标\n          const [fromRes, toRes] = await Promise.all([request({\n            url: config.backHost + '/api/common/geoCode',\n            method: 'POST',\n            data: {\n              address: item.fromLocation\n            }\n          }), request({\n            url: config.backHost + '/api/common/geoCode',\n            method: 'POST',\n            data: {\n              address: item.toLocation\n            }\n          })]);\n          if (fromRes.code === 200 && fromRes.data && toRes.code === 200 && toRes.data) {\n            const fromCoord = `${fromRes.data.longitude},${fromRes.data.latitude}`;\n            const toCoord = `${toRes.data.longitude},${toRes.data.latitude}`;\n\n            // 根据交通方式确定导航模式\n            let mode = 'drive'; // 默认驾车\n            if (item.transportType === 'bus') {\n              mode = 'bus'; // 公交\n            } else if (item.transportType === 'walk' || item.transportType === 'walking') {\n              mode = 'walk'; // 步行\n            }\n            console.log('使用解析的坐标导航:', fromCoord, '->', toCoord, 'mode:', mode);\n            const amapUrl = `https://uri.amap.com/navigation?from=${fromCoord}&to=${toCoord}&mode=${mode}&src=贵阳旅游攻略系统`;\n            console.log('导航URL:', amapUrl);\n            window.open(amapUrl, '_blank');\n          } else {\n            // 如果解析失败，使用地址名称导航（精度较低）\n            console.warn('逆地址解析失败，使用地址名称导航');\n            this.$message.warning('无法获取精确坐标，将使用地址名称导航');\n            const amapUrl = `https://uri.amap.com/navigation?from=${encodeURIComponent(item.fromLocation)}&to=${encodeURIComponent(item.toLocation)}`;\n            window.open(amapUrl, '_blank');\n          }\n        } catch (error) {\n          console.error('获取坐标失败:', error);\n          this.$message.error('获取位置信息失败，请稍后重试');\n        }\n      } else {\n        this.$message.warning('路线信息不完整，无法导航');\n      }\n    }\n  }\n};","map":{"version":3,"names":["request","config","name","data","routeDetail","loading","loadError","activeDay","mounted","loadRouteDetail","methods","recommendationId","$route","params","id","$message","error","goBack","res","url","backHost","method","code","msg","console","$router","go","deleteRoute","$confirm","confirmButtonText","cancelButtonText","type","then","success","catch","info","getImages","imagesStr","JSON","parse","e","split","filter","img","getTransportText","map","formatDuration","minutes","hours","Math","floor","mins","getCostClass","summary","estimatedCost","budget","goToAttractionDetail","attractionId","push","query","goToHotelDetail","hotelId","openNavigation","item","log","fromLongitude","fromLatitude","toLongitude","toLatitude","fromCoord","toCoord","mode","transportType","amapUrl","window","open","fromLocation","toLocation","fromRes","toRes","Promise","all","address","longitude","latitude","warn","warning","encodeURIComponent"],"sources":["src/views/front/routeRecommend/RouteDetail.vue"],"sourcesContent":["<template>\n  <div class=\"route-detail-container\">\n    <!-- 顶部导航 -->\n    <div class=\"page-header\">\n      <el-button icon=\"el-icon-arrow-left\" @click=\"goBack\" class=\"back-btn\">返回</el-button>\n      <h2 class=\"page-title\">{{ routeDetail ? routeDetail.recommendationName : '行程详情' }}</h2>\n    </div>\n\n    <div v-loading=\"loading\">\n      <!-- 顶部行程概览卡片 -->\n      <div v-if=\"routeDetail\" class=\"overview-card\">\n        <div class=\"card-content\">\n          <div class=\"overview-grid\">\n            <div class=\"grid-item days\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-time\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">旅行天数</div>\n                <div class=\"value\">{{ routeDetail.summary.days }}天</div>\n              </div>\n            </div>\n            <div class=\"grid-item budget\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-wallet\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">预算</div>\n                <div class=\"value\">¥{{ routeDetail.summary.budget }}</div>\n              </div>\n            </div>\n            <div class=\"grid-item cost\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-money\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">预估费用</div>\n                <div :class=\"['value', getCostClass(routeDetail.summary)]\">¥{{ routeDetail.summary.estimatedCost }}</div>\n              </div>\n            </div>\n            <div class=\"grid-item distance\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-odometer\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">总距离</div>\n                <div class=\"value\">{{ routeDetail.summary.totalDistance }}km</div>\n              </div>\n            </div>\n            <div class=\"grid-item attractions\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-location-outline\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">景点数量</div>\n                <div class=\"value\">{{ routeDetail.summary.totalAttractions }}个</div>\n              </div>\n            </div>\n            <div class=\"grid-item hotels\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-office-building\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">酒店数量</div>\n                <div class=\"value\">{{ routeDetail.summary.totalHotels }}家</div>\n              </div>\n            </div>\n            <div class=\"grid-item duration\">\n              <div class=\"icon-wrapper\">\n                <i class=\"el-icon-timer\"></i>\n              </div>\n              <div class=\"info\">\n                <div class=\"label\">总时长</div>\n                <div class=\"value\">{{ formatDuration(routeDetail.summary.totalDuration) }}</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 日期切换Tab栏 - 固定滚动置顶 -->\n      <div v-if=\"routeDetail\" class=\"sticky-tabs-wrapper\">\n        <div class=\"day-tabs-container\">\n          <div \n            v-for=\"day in routeDetail.itinerary\" \n            :key=\"day.dayNum\"\n            :class=\"['day-tab', { 'active': activeDay === day.dayNum.toString() }]\"\n            @click=\"activeDay = day.dayNum.toString()\">\n            第{{ day.dayNum }}天\n          </div>\n        </div>\n      </div>\n\n      <!-- 每日行程内容 -->\n      <div v-if=\"routeDetail && currentDayItems\" class=\"itinerary-section\">\n        <div class=\"timeline-container\">\n          <div v-for=\"(item, index) in currentDayItems\" :key=\"index\" class=\"timeline-item\">\n            <!-- 时间线标记 -->\n            <div class=\"timeline-marker\">\n              <div :class=\"['marker-dot', getTypeClass(item.type)]\">\n                <i :class=\"getTypeIcon(item.type)\"></i>\n              </div>\n              <div class=\"marker-line\" v-if=\"index < currentDayItems.length - 1\"></div>\n            </div>\n            \n            <!-- 行程卡片内容 -->\n            <div class=\"timeline-content\">\n              <!-- 景点节点 -->\n              <div v-if=\"item.type === 'attraction'\" class=\"content-card attraction-card\" @click=\"goToAttractionDetail(item.attractionId)\">\n                <div class=\"card-category-tag attraction\">\n                  <i class=\"el-icon-location-outline\"></i>\n                  <span>景点</span>\n                </div>\n                <div class=\"card-main\">\n                  <div class=\"card-header\">\n                    <h3 class=\"card-title\">{{ item.attractionName || '暂无数据' }}</h3>\n                    <div class=\"card-actions\">\n                      <span class=\"action-icon\" title=\"收藏\">\n                        <i class=\"el-icon-star-off\"></i>\n                      </span>\n                    </div>\n                  </div>\n                  <div class=\"card-body\">\n                    <div class=\"info-tags\">\n                      <div class=\"info-tag\">\n                        <i class=\"el-icon-time\"></i>\n                        <span>{{ item.playDuration ? item.playDuration + '分钟' : '暂无数据' }}</span>\n                      </div>\n                      <div class=\"info-tag price\">\n                        <i class=\"el-icon-ticket\"></i>\n                        <span v-if=\"item.ticketPrice == 0\" class=\"free-badge\">免费</span>\n                        <span v-else>¥{{ item.ticketPrice || '暂无数据' }}</span>\n                      </div>\n                    </div>\n                    <div v-if=\"item.description\" class=\"description\" :class=\"{ 'collapsed': !item.showFull }\">\n                      {{ item.description }}\n                    </div>\n                    <div v-if=\"item.description && item.description.length > 100\" class=\"expand-btn\" @click.stop=\"toggleDescription(item)\">\n                      {{ item.showFull ? '收起' : '展开' }}\n                      <i :class=\"item.showFull ? 'el-icon-arrow-up' : 'el-icon-arrow-down'\"></i>\n                    </div>\n                    <div v-else-if=\"!item.description\" class=\"description empty-text\">暂无简介</div>\n                    <div v-if=\"item.images && getImages(item.images).length > 0\" class=\"images\">\n                      <el-carousel :interval=\"4000\" type=\"card\" height=\"200px\">\n                        <el-carousel-item v-for=\"(img, imgIndex) in getImages(item.images)\" :key=\"imgIndex\">\n                          <img :src=\"img\" class=\"carousel-image\" />\n                        </el-carousel-item>\n                      </el-carousel>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 美食节点 -->\n              <div v-else-if=\"item.type === 'food'\" class=\"content-card food-card\">\n                <div class=\"card-category-tag food\">\n                  <i class=\"el-icon-food\"></i>\n                  <span>美食</span>\n                </div>\n                <div class=\"card-main\">\n                  <div class=\"card-header\">\n                    <h3 class=\"card-title\">{{ item.foodName || '暂无数据' }}</h3>\n                    <div class=\"card-actions\">\n                      <span class=\"action-icon\" title=\"收藏\">\n                        <i class=\"el-icon-star-off\"></i>\n                      </span>\n                    </div>\n                  </div>\n                  <div class=\"card-body\">\n                    <div class=\"info-tags\">\n                      <div class=\"info-tag\">\n                        <i class=\"el-icon-shop\"></i>\n                        <span>{{ item.shopName || '暂无数据' }}</span>\n                      </div>\n                      <div class=\"info-tag price\">\n                        <i class=\"el-icon-money\"></i>\n                        <span>¥{{ item.foodPrice || '暂无数据' }}/人</span>\n                      </div>\n                    </div>\n                    <div v-if=\"item.description\" class=\"description\" :class=\"{ 'collapsed': !item.showFull }\">\n                      {{ item.description }}\n                    </div>\n                    <div v-if=\"item.description && item.description.length > 100\" class=\"expand-btn\" @click.stop=\"toggleDescription(item)\">\n                      {{ item.showFull ? '收起' : '展开' }}\n                      <i :class=\"item.showFull ? 'el-icon-arrow-up' : 'el-icon-arrow-down'\"></i>\n                    </div>\n                    <div v-else-if=\"!item.description\" class=\"description empty-text\">暂无简介</div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 酒店节点 -->\n              <div v-else-if=\"item.type === 'hotel'\" class=\"content-card hotel-card\" @click=\"goToHotelDetail(item.hotelId)\">\n                <div class=\"card-category-tag hotel\">\n                  <i class=\"el-icon-office-building\"></i>\n                  <span>住宿</span>\n                </div>\n                <div class=\"card-main\">\n                  <div class=\"card-header\">\n                    <h3 class=\"card-title\">{{ item.hotelName || '暂无数据' }}</h3>\n                    <div class=\"card-actions\">\n                      <span class=\"action-icon\" title=\"收藏\">\n                        <i class=\"el-icon-star-off\"></i>\n                      </span>\n                    </div>\n                  </div>\n                  <div class=\"card-body\">\n                    <div class=\"info-tags\">\n                      <div class=\"info-tag\">\n                        <i class=\"el-icon-s-home\"></i>\n                        <span>{{ item.roomName || '暂无数据' }}</span>\n                      </div>\n                      <div class=\"info-tag price\">\n                        <i class=\"el-icon-money\"></i>\n                        <span>¥{{ item.roomPrice || '暂无数据' }}/晚</span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <!-- 交通路线节点 -->\n              <div v-else-if=\"item.type === 'route'\" class=\"content-card route-card\">\n                <div class=\"card-category-tag route\">\n                  <i class=\"el-icon-direction\"></i>\n                  <span>交通</span>\n                </div>\n                <div class=\"card-main\">\n                  <div class=\"card-header\">\n                    <h3 class=\"card-title\">交通路线</h3>\n                    <div class=\"card-actions\">\n                      <el-button \n                        v-if=\"item.toLocation\"\n                        size=\"small\" \n                        type=\"primary\" \n                        icon=\"el-icon-position\"\n                        :loading=\"item.navLoading\"\n                        @click.stop=\"openNavigation(item)\">\n                        查看导航\n                      </el-button>\n                    </div>\n                  </div>\n                  <div class=\"card-body\">\n                    <div class=\"route-path\">\n                      <span class=\"from\">{{ item.fromLocation || '起点' }}</span>\n                      <i class=\"el-icon-right\"></i>\n                      <span class=\"to\">{{ item.toLocation || '终点' }}</span>\n                    </div>\n                    <div class=\"info-tags\">\n                      <div class=\"info-tag\">\n                        <i class=\"el-icon-truck\"></i>\n                        <el-tag size=\"mini\">{{ getTransportText(item.transportType) }}</el-tag>\n                      </div>\n                      <div class=\"info-tag\">\n                        <i class=\"el-icon-map-location\"></i>\n                        <span>{{ item.distance ? item.distance + 'km' : '暂无数据' }}</span>\n                      </div>\n                      <div class=\"info-tag\">\n                        <i class=\"el-icon-time\"></i>\n                        <span>{{ item.duration ? formatDuration(item.duration) : '暂无数据' }}</span>\n                      </div>\n                      <div class=\"info-tag price\">\n                        <i class=\"el-icon-money\"></i>\n                        <span>¥{{ item.cost || '0' }}</span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <el-empty v-else-if=\"!loading\" description=\"暂无数据\">\n        <el-button type=\"primary\" @click=\"goBack\">返回上一页</el-button>\n      </el-empty>\n      \n      <div v-else-if=\"loadError\" class=\"error-state\">\n        <i class=\"el-icon-warning-outline error-icon\"></i>\n        <p class=\"error-text\">加载失败，请稍后重试</p>\n        <el-button type=\"primary\" @click=\"loadRouteDetail\">重新加载</el-button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport request from '@/utils/request'\nimport config from '@/config/config'\n\nexport default {\n  name: 'RouteDetail',\n  data() {\n    return {\n      routeDetail: null,\n      loading: false,\n      loadError: false,\n      activeDay: '1'\n    }\n  },\n  mounted() {\n    this.loadRouteDetail()\n  },\n  methods: {\n    // 加载路线详情\n    async loadRouteDetail() {\n      const recommendationId = this.$route.params.id\n      if (!recommendationId) {\n        this.$message.error('缺少路线ID')\n        this.goBack()\n        return\n      }\n\n      this.loading = true\n      this.loadError = false\n      try {\n        const res = await request({\n          url: config.backHost + `/api/routeRecommendation/detail/${recommendationId}`,\n          method: 'POST'\n        })\n        if (res.code === 200 && res.data) {\n          this.routeDetail = res.data\n          this.activeDay = '1'\n        } else {\n          this.$message.error(res.msg || '加载失败')\n          this.loadError = true\n        }\n      } catch (error) {\n        console.error('加载路线详情失败:', error)\n        this.$message.error('加载路线详情失败')\n        this.loadError = true\n      } finally {\n        this.loading = false\n      }\n    },\n\n    // 返回\n    goBack() {\n      this.$router.go(-1)\n    },\n\n    // 收藏路线\n    // 已移除收藏功能，只保留删除\n\n    // 删除路线\n    deleteRoute() {\n      const recommendationId = this.$route.params.id\n      this.$confirm('确定要删除这条行程记录吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await request({\n            url: config.backHost + `/api/routeRecommendation/delete/${recommendationId}`,\n            method: 'POST'\n          })\n          if (res.code === 200) {\n            this.$message.success('删除成功')\n            this.goBack()\n          } else {\n            this.$message.error(res.msg || '删除失败')\n          }\n        } catch (error) {\n          console.error('删除失败:', error)\n          this.$message.error('删除失败')\n        }\n      }).catch(() => {\n        this.$message.info('已取消删除')\n      })\n    },\n\n    // 获取图片数组\n    getImages(imagesStr) {\n      if (!imagesStr) return []\n      try {\n        return JSON.parse(imagesStr)\n      } catch (e) {\n        return imagesStr.split(',').filter(img => img)\n      }\n    },\n\n    // 获取交通方式文本\n    getTransportText(type) {\n      const map = {\n        'drive': '自驾',\n        'bus': '公交',\n        'taxi': '打车',\n        'walking': '步行',  // 高德 API 返回 walking\n        'walk': '步行'      // 兼容旧数据\n      }\n      return map[type] || type\n    },\n\n    // 格式化时长\n    formatDuration(minutes) {\n      if (!minutes && minutes !== 0) return '暂无数据'\n      const hours = Math.floor(minutes / 60)\n      const mins = minutes % 60\n      if (hours > 0 && mins > 0) {\n        return `${hours}小时${mins}分钟`\n      } else if (hours > 0) {\n        return `${hours}小时`\n      } else {\n        return `${mins}分钟`\n      }\n    },\n\n    // 获取费用样式类\n    getCostClass(summary) {\n      if (summary.estimatedCost <= summary.budget) {\n        return 'cost under-budget'  // 预算内：绿色\n      } else {\n        return 'cost over-budget'   // 超预算：红色\n      }\n    },\n\n    // 跳转到景点详情\n    goToAttractionDetail(attractionId) {\n      if (attractionId) {\n        this.$router.push({\n          name: 'attractionDetail',\n          query: { id: attractionId }\n        })\n      }\n    },\n\n    // 跳转到酒店详情\n    goToHotelDetail(hotelId) {\n      if (hotelId) {\n        this.$router.push({\n          name: 'hotelDetail',\n          query: { id: hotelId }\n        })\n      }\n    },\n\n    // 打开地图导航\n    async openNavigation(item) {\n      console.log('导航数据:', item)\n      \n      // 优先使用经纬度坐标，如果有的话\n      if (item.fromLongitude && item.fromLatitude && item.toLongitude && item.toLatitude) {\n        // 使用经纬度坐标导航（更精确）\n        const fromCoord = `${item.fromLongitude},${item.fromLatitude}`\n        const toCoord = `${item.toLongitude},${item.toLatitude}`\n        \n        // 根据交通方式确定导航模式\n        let mode = 'drive' // 默认驾车\n        if (item.transportType === 'bus') {\n          mode = 'bus' // 公交\n        } else if (item.transportType === 'walk' || item.transportType === 'walking') {\n          mode = 'walk' // 步行\n        }\n        \n        console.log('使用坐标导航:', fromCoord, '->', toCoord, 'mode:', mode)\n        const amapUrl = `https://uri.amap.com/navigation?from=${fromCoord}&to=${toCoord}&mode=${mode}&src=贵阳旅游攻略系统`\n        console.log('导航URL:', amapUrl)\n        window.open(amapUrl, '_blank')\n      } else if (item.fromLocation && item.toLocation) {\n        // 如果没有坐标，尝试调用逆地址解析接口获取坐标\n        try {\n          this.$message.info('正在获取位置信息...')\n          \n          // 并行获取起点和终点的坐标\n          const [fromRes, toRes] = await Promise.all([\n            request({\n              url: config.backHost + '/api/common/geoCode',\n              method: 'POST',\n              data: { address: item.fromLocation }\n            }),\n            request({\n              url: config.backHost + '/api/common/geoCode',\n              method: 'POST',\n              data: { address: item.toLocation }\n            })\n          ])\n          \n          if (fromRes.code === 200 && fromRes.data && toRes.code === 200 && toRes.data) {\n            const fromCoord = `${fromRes.data.longitude},${fromRes.data.latitude}`\n            const toCoord = `${toRes.data.longitude},${toRes.data.latitude}`\n            \n            // 根据交通方式确定导航模式\n            let mode = 'drive' // 默认驾车\n            if (item.transportType === 'bus') {\n              mode = 'bus' // 公交\n            } else if (item.transportType === 'walk' || item.transportType === 'walking') {\n              mode = 'walk' // 步行\n            }\n            \n            console.log('使用解析的坐标导航:', fromCoord, '->', toCoord, 'mode:', mode)\n            const amapUrl = `https://uri.amap.com/navigation?from=${fromCoord}&to=${toCoord}&mode=${mode}&src=贵阳旅游攻略系统`\n            console.log('导航URL:', amapUrl)\n            window.open(amapUrl, '_blank')\n          } else {\n            // 如果解析失败，使用地址名称导航（精度较低）\n            console.warn('逆地址解析失败，使用地址名称导航')\n            this.$message.warning('无法获取精确坐标，将使用地址名称导航')\n            const amapUrl = `https://uri.amap.com/navigation?from=${encodeURIComponent(item.fromLocation)}&to=${encodeURIComponent(item.toLocation)}`\n            window.open(amapUrl, '_blank')\n          }\n        } catch (error) {\n          console.error('获取坐标失败:', error)\n          this.$message.error('获取位置信息失败，请稍后重试')\n        }\n      } else {\n        this.$message.warning('路线信息不完整，无法导航')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n.route-detail-container {\n  padding: 20px;\n  max-width: 1200px;\n  margin: 0 auto;\n\n  .page-header {\n    display: flex;\n    align-items: center;\n    margin-bottom: 20px;\n    \n    .el-button {\n      margin-right: 15px;\n    }\n    \n    h2 {\n      color: #333;\n      margin: 0;\n    }\n  }\n\n  .detail-card {\n    .route-title {\n      font-size: 18px;\n      font-weight: bold;\n      color: #333;\n    }\n\n    .header-actions {\n      float: right;\n      \n      .el-button {\n        margin-left: 10px;\n      }\n    }\n\n    .basic-info {\n      padding: 20px;\n      background-color: #f8f9fa;\n      border-radius: 8px;\n      margin-bottom: 30px;\n\n      .info-item {\n        text-align: center;\n        \n        .label {\n          font-size: 12px;\n          color: #666;\n          margin-bottom: 5px;\n        }\n        \n        .value {\n          font-size: 18px;\n          font-weight: bold;\n          color: #333;\n          \n          &.cost {\n            &.under-budget {\n              color: #27AE60;  // 预算内：绿色\n            }\n            \n            &.over-budget {\n              color: #E53E3E;  // 超预算：红色\n            }\n          }\n        }\n      }\n    }\n\n  // 行程内容区域\n  .itinerary-section {\n    .timeline-container {\n      .timeline-item {\n        display: flex;\n        margin-bottom: 24px;\n        position: relative;\n\n        // 时间线标记\n        .timeline-marker {\n          display: flex;\n          flex-direction: column;\n          align-items: center;\n          margin-right: 16px;\n          position: relative;\n\n          .marker-dot {\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            transition: all 0.3s;\n            box-shadow: $shadow-sm;\n            \n            i {\n              font-size: 18px;\n              color: $bg-white;\n            }\n            \n            &.attraction {\n              background-color: $attraction-color;\n              \n              &:hover {\n                transform: scale(1.1);\n                box-shadow: 0 4px 12px rgba($attraction-color, 0.3);\n              }\n            }\n            \n            &.food {\n              background-color: $food-color;\n              \n              &:hover {\n                transform: scale(1.1);\n                box-shadow: 0 4px 12px rgba($food-color, 0.3);\n              }\n            }\n            \n            &.hotel {\n              background-color: $hotel-color;\n              \n              &:hover {\n                transform: scale(1.1);\n                box-shadow: 0 4px 12px rgba($hotel-color, 0.3);\n              }\n            }\n            \n            &.route {\n              background-color: $route-color;\n              \n              &:hover {\n                transform: scale(1.1);\n                box-shadow: 0 4px 12px rgba($route-color, 0.3);\n              }\n            }\n          }\n\n          .marker-line {\n            width: 2px;\n            flex: 1;\n            background: linear-gradient(to bottom, $border-light, transparent);\n            margin-top: 8px;\n            min-height: 40px;\n          }\n        }\n\n        // 行程卡片内容\n        .timeline-content {\n          flex: 1;\n          min-width: 0;\n\n          .content-card {\n            border: 1px solid $border-color;\n            border-radius: 8px;\n            padding: 0;\n            background-color: $bg-white;\n            box-shadow: $shadow-sm;\n            transition: all 0.3s;\n            overflow: hidden;\n            \n            &:hover {\n              box-shadow: $shadow-md;\n              transform: translateY(-2px);\n            }\n            \n            // 分类标签\n            .card-category-tag {\n              display: flex;\n              align-items: center;\n              gap: 6px;\n              padding: 8px 16px;\n              font-size: 12px;\n              font-weight: bold;\n              color: $bg-white;\n              \n              i {\n                font-size: 14px;\n              }\n              \n              &.attraction {\n                background-color: $attraction-color;\n              }\n              \n              &.food {\n                background-color: $food-color;\n              }\n              \n              &.hotel {\n                background-color: $hotel-color;\n              }\n              \n              &.route {\n                background-color: $route-color;\n              }\n            }\n            \n            .card-main {\n              padding: 16px;\n              \n              .card-header {\n                display: flex;\n                align-items: center;\n                justify-content: space-between;\n                margin-bottom: 12px;\n                \n                .card-title {\n                  font-size: 16px;\n                  font-weight: bold;\n                  color: $text-primary;\n                  margin: 0;\n                  flex: 1;\n                }\n                \n                .card-actions {\n                  display: flex;\n                  align-items: center;\n                  gap: 8px;\n                  \n                  .action-icon {\n                    cursor: pointer;\n                    padding: 6px;\n                    border-radius: 50%;\n                    transition: all 0.3s;\n                    \n                    i {\n                      font-size: 18px;\n                      color: $text-tertiary;\n                    }\n                    \n                    &:hover {\n                      background-color: lighten($primary-color, 40%);\n                      \n                      i {\n                        color: $primary-color;\n                      }\n                    }\n                  }\n                  \n                  .el-button {\n                    background-color: $primary-color;\n                    border-color: $primary-color;\n                    border-radius: 8px;\n                    \n                    &:hover {\n                      background-color: $primary-hover;\n                      border-color: $primary-hover;\n                    }\n                  }\n                }\n              }\n\n              .card-body {\n                // 信息标签\n                .info-tags {\n                  display: flex;\n                  flex-wrap: wrap;\n                  gap: 10px;\n                  margin-bottom: 12px;\n                  \n                  .info-tag {\n                    display: flex;\n                    align-items: center;\n                    gap: 6px;\n                    padding: 6px 12px;\n                    background-color: $bg-light;\n                    border-radius: 6px;\n                    font-size: 13px;\n                    color: $text-secondary;\n                    transition: all 0.3s;\n                    \n                    i {\n                      font-size: 14px;\n                      color: $text-tertiary;\n                    }\n                    \n                    &:hover {\n                      background-color: lighten($primary-color, 45%);\n                      color: $primary-color;\n                      \n                      i {\n                        color: $primary-color;\n                      }\n                    }\n                    \n                    &.price {\n                      color: #f56c6c;\n                      font-weight: bold;\n                      \n                      i {\n                        color: #f56c6c;\n                      }\n                      \n                      .free-badge {\n                        color: $attraction-color;\n                        background-color: lighten($attraction-color, 40%);\n                        padding: 2px 8px;\n                        border-radius: 4px;\n                        font-size: 12px;\n                      }\n                    }\n                  }\n                }\n\n                // 描述文本\n                .description {\n                  margin: 12px 0;\n                  color: $text-secondary;\n                  line-height: 1.8;\n                  font-size: 14px;\n                  transition: all 0.3s;\n                  \n                  &.collapsed {\n                    display: -webkit-box;\n                    -webkit-line-clamp: 3;\n                    -webkit-box-orient: vertical;\n                    overflow: hidden;\n                  }\n                  \n                  &.empty-text {\n                    color: $text-placeholder;\n                    font-style: italic;\n                  }\n                }\n                \n                .expand-btn {\n                  display: inline-flex;\n                  align-items: center;\n                  gap: 4px;\n                  color: $primary-color;\n                  font-size: 13px;\n                  cursor: pointer;\n                  margin-top: 8px;\n                  transition: all 0.3s;\n                  user-select: none;\n                  \n                  &:hover {\n                    opacity: 0.8;\n                  }\n                  \n                  i {\n                    font-size: 12px;\n                  }\n                }\n\n                // 图片轮播\n                .images {\n                  margin-top: 12px;\n                  \n                  .carousel-image {\n                    width: 100%;\n                    height: 100%;\n                    object-fit: cover;\n                    border-radius: 6px;\n                  }\n                }\n\n                // 路线路径\n                .route-path {\n                  display: flex;\n                  align-items: center;\n                  margin-bottom: 16px;\n                  font-size: 15px;\n                  padding: 12px;\n                  background-color: lighten($primary-color, 45%);\n                  border-radius: 8px;\n                  border-left: 3px solid $primary-color;\n                  \n                  .from, .to {\n                    font-weight: bold;\n                    color: $text-primary;\n                  }\n                  \n                  i {\n                    margin: 0 12px;\n                    color: $primary-color;\n                    font-size: 18px;\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\n// 错误状态\n.error-state {\n  text-align: center;\n  padding: 80px 20px;\n  background: $bg-white;\n  border-radius: 8px;\n  box-shadow: $shadow-sm;\n  \n  .error-icon {\n    font-size: 64px;\n    color: #f56c6c;\n    margin-bottom: 20px;\n  }\n  \n  .error-text {\n    font-size: 16px;\n    color: $text-secondary;\n    margin-bottom: 24px;\n  }\n  \n  .el-button {\n    background-color: $primary-color;\n    border-color: $primary-color;\n    border-radius: 8px;\n    \n    &:hover {\n      background-color: $primary-hover;\n      border-color: $primary-hover;\n    }\n  }\n}\n\n// 移动端适配\n@media (max-width: 768px) {\n  .route-detail-container {\n    padding: 10px;\n    \n    .page-header {\n      .page-title {\n        font-size: 18px;\n      }\n    }\n    \n    // 概览卡片自适应\n    .overview-card {\n      .card-content {\n        padding: 16px;\n        \n        .overview-grid {\n          grid-template-columns: repeat(2, 1fr);\n          gap: 12px;\n          \n          .grid-item {\n            padding: 10px;\n            \n            .icon-wrapper {\n              width: 40px;\n              height: 40px;\n              margin-right: 8px;\n              \n              i {\n                font-size: 20px;\n              }\n            }\n            \n            .info {\n              .label {\n                font-size: 11px;\n              }\n              \n              .value {\n                font-size: 1
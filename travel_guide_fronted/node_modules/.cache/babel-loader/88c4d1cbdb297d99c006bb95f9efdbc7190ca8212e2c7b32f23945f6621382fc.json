{"ast":null,"code":"import FormUtils from '@/utils/formUtils';\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\nimport uploadImageMore from \"@/components/UploadImageMore.vue\";\nimport wangEditorComponent from \"@/components/WangEditorComponent.vue\";\nexport default {\n  name: \"AttractionInfoForm\",\n  mixins: [FormUtils],\n  components: {\n    OwnSidebarDialog,\n    uploadImageMore,\n    wangEditorComponent\n  },\n  data() {\n    return {\n      formData: {\n        attractionPic: '',\n        attractionName: '',\n        typeId: '',\n        attractionDesc: '',\n        attractionDetail: '',\n        attractionPlace: '',\n        playHour: null,\n        longitude: '',\n        latitude: ''\n      },\n      addUrl: '/attractionInfo/saveOrUpdate',\n      editUrl: '/attractionInfo/saveOrUpdate',\n      typeIdOptions: [],\n      newUploadImgKey: new Date().getTime(),\n      geoLoading: false // 经纬度获取loading状态\n    };\n  },\n  methods: {\n    initForm() {\n      this.newUploadImgKey = new Date().getTime();\n      request({\n        url: config.backHost + \"/attractionType/listPage\",\n        data: {}\n      }).then(res => {\n        this.typeIdOptions = res.data;\n      });\n    },\n    clearData() {\n      this.formData = {\n        attractionPic: '',\n        attractionName: '',\n        typeId: '',\n        attractionDesc: '',\n        attractionDetail: '',\n        attractionPlace: '',\n        playHour: null,\n        longitude: '',\n        latitude: ''\n      };\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.attractionPic) {\n        message += \"景点图片不能为空<br>\";\n      }\n      if (!this.formData.attractionName) {\n        message += \"景点名称不能为空<br>\";\n      }\n      if (!this.formData.typeId) {\n        message += \"景点分类不能为空<br>\";\n      }\n      if (!this.formData.attractionDesc) {\n        message += \"景点简介不能为空<br>\";\n      }\n      if (!this.formData.attractionDetail) {\n        message += \"景点描述不能为空<br>\";\n      }\n      if (!this.formData.attractionPlace) {\n        message += \"景点位置不能为空<br>\";\n      }\n      return message;\n    },\n    // 获取经纬度\n    async handleGetCoordinates(type) {\n      const address = this.formData.attractionPlace;\n      if (!address || !address.trim()) {\n        this.$message.warning('请先输入地址');\n        return;\n      }\n      this.geoLoading = true;\n      try {\n        const res = await request({\n          url: config.backHost + '/api/common/geoCode',\n          method: 'POST',\n          data: {\n            address: address\n          }\n        });\n        if (res.code === 200 && res.data) {\n          this.formData.longitude = res.data.longitude || '';\n          this.formData.latitude = res.data.latitude || '';\n          this.$message.success('经纬度获取成功');\n        } else {\n          this.$message.error('地址解析失败，请检查地址格式或手动输入');\n        }\n      } catch (error) {\n        console.error('地址解析失败:', error);\n        this.$message.error('地址解析失败，请检查地址格式或手动输入');\n      } finally {\n        this.geoLoading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["FormUtils","request","config","OwnSidebarDialog","uploadImageMore","wangEditorComponent","name","mixins","components","data","formData","attractionPic","attractionName","typeId","attractionDesc","attractionDetail","attractionPlace","playHour","longitude","latitude","addUrl","editUrl","typeIdOptions","newUploadImgKey","Date","getTime","geoLoading","methods","initForm","url","backHost","then","res","clearData","beforeSave","message","handleGetCoordinates","type","address","trim","$message","warning","method","code","success","error","console"],"sources":["src/views/manage/attractionInfo/AttractionInfoForm.vue"],"sourcesContent":["<template>\r\n  <div class=\"form-box\">\r\n    <own-sidebar-dialog width=\"1200px\" :title=\"title\" :visible.sync=\"visible\" :before-close=\"closeDialog\" :modal=\"true\" :close-on-click-modal=\"false\">\r\n      <template #default>\r\n        <el-form :model=\"formData\" ref=\"form\" label-width=\"auto\" style=\"padding: 0 20px\">\r\n          <div style=\"display: flex;gap: 20px\">\r\n            <div style=\"flex-shrink: 0;width: 40%\">\r\n              <el-form-item prop=\"attractionPic\" label=\"景点图片\">\r\n                <upload-image-more :key=\"newUploadImgKey\" v-model=\"formData.attractionPic\" :max=\"3\"/>\r\n                <p class=\"upload-tip\">最多可上传 3 张图片，支持 jpg、png 格式</p>\r\n              </el-form-item>\r\n              <el-form-item prop=\"attractionName\" label=\"景点名称\">\r\n                <el-input type=\"text\" v-model=\"formData.attractionName\" style=\"width: 100%\"  placeholder=\"请输入景点名称\"/>\r\n              </el-form-item>\r\n              <el-form-item prop=\"typeId\" label=\"景点分类\">\r\n                <el-select style=\"width: 100%;\" clearable v-model=\"formData.typeId\"  placeholder=\"请选择景点分类\">\r\n                  <el-option v-for=\"item in typeIdOptions\" :key=\"item.id\" :label=\"item.typeName\" :value=\"item.id\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n              <el-form-item prop=\"playHour\" label=\"游玩时长\">\r\n                <el-input-number v-model=\"formData.playHour\" :min=\"0\" :max=\"1440\" style=\"width: 100%\" placeholder=\"请输入游玩时长(分钟)\">\r\n                  <template slot=\"append\">分钟</template>\r\n                </el-input-number>\r\n              </el-form-item>\r\n              <el-form-item prop=\"attractionDesc\" label=\"景点简介\">\r\n                <el-input type=\"textarea\" :row=\"3\" v-model=\"formData.attractionDesc\" style=\"width: 100%\"  placeholder=\"请输入景点简介\"/>\r\n              </el-form-item>\r\n              <el-form-item prop=\"attractionPlace\" label=\"景点位置\">\r\n                <div style=\"display: flex; gap: 10px; align-items: flex-start;\">\r\n                  <el-input type=\"textarea\" :rows=\"3\" v-model=\"formData.attractionPlace\" style=\"flex: 1\" placeholder=\"请输入景点位置\" @blur=\"handleGetCoordinates('attraction')\" />\r\n                  <el-button type=\"primary\" size=\"small\" :loading=\"geoLoading\" @click=\"handleGetCoordinates('attraction')\" style=\"flex-shrink: 0;\">获取经纬度</el-button>\r\n                </div>\r\n                <!-- 隐藏字段存储经纬度 -->\r\n                <el-input type=\"hidden\" v-model=\"formData.longitude\" />\r\n                <el-input type=\"hidden\" v-model=\"formData.latitude\" />\r\n              </el-form-item>\r\n            </div>\r\n            <div style=\"flex-shrink: 0;width: 60%\">\r\n              <el-form-item prop=\"attractionDetail\" label=\"景点描述\">\r\n                <wangEditorComponent :height=\"500\" v-model=\"formData.attractionDetail\" />\r\n              </el-form-item>\r\n            </div>\r\n          </div>\r\n        </el-form>\r\n      </template>\r\n      <template #footer>\r\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\r\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\r\n      </template>\r\n    </own-sidebar-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport FormUtils from '@/utils/formUtils'\r\nimport request from \"@/utils/request\";\r\nimport config from \"@/config/config\";\r\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\r\nimport uploadImageMore from \"@/components/UploadImageMore.vue\";\r\nimport wangEditorComponent from \"@/components/WangEditorComponent.vue\";\r\n\r\nexport default {\r\n  name: \"AttractionInfoForm\",\r\n  mixins: [FormUtils],\r\n  components: {OwnSidebarDialog  , uploadImageMore  , wangEditorComponent },\r\n  data() {\r\n    return {\r\n      formData: {\r\n          attractionPic: '',\r\n          attractionName: '',\r\n          typeId: '',\r\n          attractionDesc: '',\r\n          attractionDetail: '',\r\n          attractionPlace: '',\r\n          playHour: null,\r\n          longitude: '',\r\n          latitude: ''\r\n      },\r\n      addUrl: '/attractionInfo/saveOrUpdate',\r\n      editUrl: '/attractionInfo/saveOrUpdate',\r\n      typeIdOptions: [],\r\n      newUploadImgKey:new Date().getTime(),\r\n      geoLoading: false // 经纬度获取loading状态\r\n    };\r\n  },\r\n  methods: {\r\n    initForm(){\r\n      this.newUploadImgKey = new Date().getTime()\r\n        request({\r\n          url: config.backHost + \"/attractionType/listPage\",\r\n          data: {}\r\n        }).then(res => {\r\n          this.typeIdOptions = res.data;\r\n        });\r\n\r\n    },\r\n    clearData(){\r\n      this.formData = {\r\n        attractionPic: '',\r\n        attractionName: '',\r\n        typeId: '',\r\n        attractionDesc: '',\r\n        attractionDetail: '',\r\n        attractionPlace: '',\r\n        playHour: null,\r\n        longitude: '',\r\n        latitude: ''\r\n      };\r\n    },\r\n    beforeSave() {\r\n      let message = '';\r\n      if (!this.formData.attractionPic) {\r\n        message += \"景点图片不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionName) {\r\n        message += \"景点名称不能为空<br>\";\r\n      }\r\n      if (!this.formData.typeId) {\r\n        message += \"景点分类不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionDesc) {\r\n        message += \"景点简介不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionDetail) {\r\n        message += \"景点描述不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionPlace) {\r\n        message += \"景点位置不能为空<br>\";\r\n      }\r\n      return message;\r\n    },\r\n    // 获取经纬度\r\n    async handleGetCoordinates(type) {\r\n      const address = this.formData.attractionPlace;\r\n      if (!address || !address.trim()) {\r\n        this.$message.warning('请先输入地址');\r\n        return;\r\n      }\r\n      \r\n      this.geoLoading = true;\r\n      try {\r\n        const res = await request({\r\n          url: config.backHost + '/api/common/geoCode',\r\n          method: 'POST',\r\n          data: { address: address }\r\n        });\r\n        \r\n        if (res.code === 200 && res.data) {\r\n          this.formData.longitude = res.data.longitude || '';\r\n          this.formData.latitude = res.data.latitude || '';\r\n          this.$message.success('经纬度获取成功');\r\n        } else {\r\n          this.$message.error('地址解析失败，请检查地址格式或手动输入');\r\n        }\r\n      } catch (error) {\r\n        console.error('地址解析失败:', error);\r\n        this.$message.error('地址解析失败，请检查地址格式或手动输入');\r\n      } finally {\r\n        this.geoLoading = false;\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n"],"mappings":"AAsDA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AACA,OAAAC,eAAA;AACA,OAAAC,mBAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAP,SAAA;EACAQ,UAAA;IAAAL,gBAAA;IAAAC,eAAA;IAAAC;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,aAAA;QACAC,cAAA;QACAC,MAAA;QACAC,cAAA;QACAC,gBAAA;QACAC,eAAA;QACAC,QAAA;QACAC,SAAA;QACAC,QAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,aAAA;MACAC,eAAA,MAAAC,IAAA,GAAAC,OAAA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA;MACA,KAAAL,eAAA,OAAAC,IAAA,GAAAC,OAAA;MACAxB,OAAA;QACA4B,GAAA,EAAA3B,MAAA,CAAA4B,QAAA;QACArB,IAAA;MACA,GAAAsB,IAAA,CAAAC,GAAA;QACA,KAAAV,aAAA,GAAAU,GAAA,CAAAvB,IAAA;MACA;IAEA;IACAwB,UAAA;MACA,KAAAvB,QAAA;QACAC,aAAA;QACAC,cAAA;QACAC,MAAA;QACAC,cAAA;QACAC,gBAAA;QACAC,eAAA;QACAC,QAAA;QACAC,SAAA;QACAC,QAAA;MACA;IACA;IACAe,WAAA;MACA,IAAAC,OAAA;MACA,UAAAzB,QAAA,CAAAC,aAAA;QACAwB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAE,cAAA;QACAuB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAG,MAAA;QACAsB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAI,cAAA;QACAqB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAK,gBAAA;QACAoB,OAAA;MACA;MACA,UAAAzB,QAAA,CAAAM,eAAA;QACAmB,OAAA;MACA;MACA,OAAAA,OAAA;IACA;IACA;IACA,MAAAC,qBAAAC,IAAA;MACA,MAAAC,OAAA,QAAA5B,QAAA,CAAAM,eAAA;MACA,KAAAsB,OAAA,KAAAA,OAAA,CAAAC,IAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA;MACA;MAEA,KAAAf,UAAA;MACA;QACA,MAAAM,GAAA,SAAA/B,OAAA;UACA4B,GAAA,EAAA3B,MAAA,CAAA4B,QAAA;UACAY,MAAA;UACAjC,IAAA;YAAA6B,OAAA,EAAAA;UAAA;QACA;Q
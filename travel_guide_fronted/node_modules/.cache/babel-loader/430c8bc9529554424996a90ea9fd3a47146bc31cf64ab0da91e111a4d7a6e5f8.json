{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\nexport default {\n  name: \"FoodCommentList\",\n  components: {\n    SearchTop\n  },\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/comment/delete/\",\n      searchList: [{\n        type: 'input',\n        name: '关键字',\n        placeholder: '小吃名称、用户名、评论内容',\n        value: 'keyword'\n      }],\n      detailDialog: false,\n      currentComment: null\n    };\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/comment/listPage\",\n        method: 'POST',\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    viewDetail(row) {\n      this.currentComment = row;\n      this.detailDialog = true;\n    },\n    getPicArray(picJson) {\n      try {\n        return JSON.parse(picJson || '[]');\n      } catch (e) {\n        return [];\n      }\n    },\n    getPicUrl(pic) {\n      if (!pic) return '';\n      // 如果 pic 是对象(已解析的 JSON),直接取 id 拼接下载 URL\n      if (typeof pic === 'object' && pic.id) {\n        return config.downloadUrl + pic.id;\n      }\n      // 如果 pic 是字符串,直接返回\n      return pic;\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","SearchTop","common","name","components","mixins","data","delUrl","searchList","type","placeholder","value","detailDialog","currentComment","computed","userRole","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","url","backHost","method","params","then","res","code","tableData","viewDetail","row","getPicArray","picJson","JSON","parse","e","getPicUrl","pic","id","downloadUrl"],"sources":["src/views/manage/foodInfo/FoodCommentList.vue"],"sourcesContent":["<template>\n  <div class=\"own-mvue-list-box\">\n    <!--搜索区域-->\n    <div class=\"own-list-search-box\">\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\n    </div>\n    <div class=\"newTableStyle\">\n      <!--列表数据区域-->\n      <div class=\"own-list-table-box\">\n        <!-- 表格内容 -->\n        <div class=\"own-list-table-data-box\">\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\n            <el-table-column prop=\"foodName\" label=\"小吃名称\" width=\"150\"/>\n            <el-table-column prop=\"userName\" label=\"用户\" width=\"120\"/>\n            <el-table-column prop=\"userHeadPic\" label=\"用户头像\" width=\"80\">\n              <template #default=\"{row}\">\n                <el-avatar :size=\"40\" :src=\"getPicUrlByJson(row.userHeadPic, 0)\"></el-avatar>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"score\" label=\"评分\" width=\"150\">\n              <template #default=\"{row}\">\n                <el-rate v-model=\"row.score\" disabled text-color=\"#ff9900\"></el-rate>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"content\" label=\"评论内容\" show-overflow-tooltip/>\n            <el-table-column prop=\"images\" label=\"配图\" width=\"150\">\n              <template #default=\"{row}\">\n                <div v-if=\"row.images\" style=\"display: flex; gap: 5px; justify-content: center;\">\n                  <el-image \n                    v-for=\"(img, idx) in getPicArray(row.images).slice(0, 3)\" \n                    :key=\"idx\"\n                    :src=\"getPicUrl(img)\"\n                    :preview-src-list=\"getPicArray(row.images).map(i => getPicUrl(i))\"\n                    style=\"width: 40px; height: 40px\"\n                    fit=\"cover\">\n                  </el-image>\n                  <span v-if=\"getPicArray(row.images).length > 3\" style=\"font-size: 12px; color: #999;\">\n                    +{{ getPicArray(row.images).length - 3 }}\n                  </span>\n                </div>\n                <span v-else>-</span>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"createTime\" width=\"160\" label=\"评论时间\">\n              <template #default=\"{row}\">\n                {{ timestampToYMDHMS(row.createTime) }}\n              </template>\n            </el-table-column>\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"150\">\n              <template #default=\"{ row }\">\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"viewDetail(row)\">查看详情</span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;border-color: red\" @click=\"delById(row, delUrl)\">删除</span>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n\n        <!--分页区域-->\n        <el-pagination\n                :current-page=\"pageBean.page\"\n                :page-sizes=\"[10, 20, 50, 100]\"\n                :page-size=\"pageBean.pageSize\"\n                layout=\"total, sizes, prev, pager, next\"\n                :total=\"pageBean.total\"\n                @current-change=\"currPageChange\"\n                @size-change=\"handleSizeChange\" />\n      </div>\n    </div>\n\n    <!-- 查看详情弹窗 -->\n    <el-dialog title=\"评论详情\" :visible.sync=\"detailDialog\" width=\"700px\">\n      <div v-if=\"currentComment\" class=\"comment-detail\">\n        <div class=\"detail-item\">\n          <label>小吃名称：</label>\n          <span>{{ currentComment.foodName }}</span>\n        </div>\n        <div class=\"detail-item\">\n          <label>用户：</label>\n          <div style=\"display: flex; align-items: center; gap: 10px;\">\n            <el-avatar :size=\"40\" :src=\"getPicUrlByJson(currentComment.userHeadPic, 0)\"></el-avatar>\n            <span>{{ currentComment.userName }}</span>\n          </div>\n        </div>\n        <div class=\"detail-item\">\n          <label>评分：</label>\n          <el-rate v-model=\"currentComment.score\" disabled text-color=\"#ff9900\"></el-rate>\n        </div>\n        <div class=\"detail-item\">\n          <label>评论内容：</label>\n          <div class=\"comment-text\">{{ currentComment.content }}</div>\n        </div>\n        <div class=\"detail-item\" v-if=\"currentComment.images\">\n          <label>配图：</label>\n          <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n            <el-image \n              v-for=\"(img, idx) in getPicArray(currentComment.images)\" \n              :key=\"idx\"\n              :src=\"getPicUrl(img)\"\n              :preview-src-list=\"getPicArray(currentComment.images).map(i => getPicUrl(i))\"\n              style=\"width: 100px; height: 100px\"\n              fit=\"cover\">\n            </el-image>\n          </div>\n        </div>\n        <div class=\"detail-item\">\n          <label>评论时间：</label>\n          <span>{{ timestampToYMDHMS(currentComment.createTime) }}</span>\n        </div>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"detailDialog = false\">关 闭</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport SearchTop from \"@/components/searchTop.vue\";\nimport common from \"@/utils/common\";\n\nexport default {\n  name: \"FoodCommentList\",\n  components: { SearchTop},\n  mixins: [TableUtils, common],\n  data() {\n    return {\n      delUrl: \"/api/food/comment/delete/\",\n      searchList: [\n        {type:'input',name:'关键字',placeholder:'小吃名称、用户名、评论内容',value:'keyword'},\n      ],\n      detailDialog: false,\n      currentComment: null\n    }\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    },\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData(){\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/api/food/comment/listPage\",\n        method: 'POST',\n        data: { params: searchForm, pageBean: pageBean }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    },\n    viewDetail(row) {\n      this.currentComment = row;\n      this.detailDialog = true;\n    },\n    getPicArray(picJson) {\n      try {\n        return JSON.parse(picJson || '[]');\n      } catch (e) {\n        return [];\n      }\n    },\n    getPicUrl(pic) {\n      if (!pic) return '';\n      // 如果 pic 是对象(已解析的 JSON),直接取 id 拼接下载 URL\n      if (typeof pic === 'object' && pic.id) {\n        return config.downloadUrl + pic.id;\n      }\n      // 如果 pic 是字符串,直接返回\n      return pic;\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n@use \"@/assets/css/table.scss\";\n\n.comment-detail {\n  .detail-item {\n    margin-bottom: 20px;\n    display: flex;\n    align-items: flex-start;\n    \n    label {\n      font-weight: bold;\n      color: #606266;\n      min-width: 100px;\n      flex-shrink: 0;\n    }\n    \n    span {\n      color: #303133;\n    }\n    \n    .comment-text {\n      flex: 1;\n      line-height: 1.8;\n      color: #303133;\n      white-space: pre-wrap;\n    }\n  }\n}\n</style>\n"],"mappings":"AAsHA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,SAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH;EAAA;EACAI,MAAA,GAAAP,UAAA,EAAAI,MAAA;EACAI,KAAA;IACA;MACAC,MAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAN,IAAA;QAAAO,WAAA;QAAAC,KAAA;MAAA,EACA;MACAC,YAAA;MACAC,cAAA;IACA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA,CAAAH,QAAA;IACA;EACA;EACAI,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAJ,SAAA,GACA;IACAC,MAAAC,UAAA,EAAAC,QAAA;MACAxB,OAAA;QACA0B,GAAA,EAAAzB,MAAA,CAAA0B,QAAA;QACAC,MAAA;QACArB,IAAA;UAAAsB,MAAA,EAAAN,UAAA;UAAAC,QAAA,EAAAA;QAAA;MACA,GAAAM,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAAxB,IAAA;UACA,KAAAiB,QAAA,GAAAO,GAAA,CAAAP,QAAA;QACA;MACA;IACA;IACAU,WAAAC,GAAA;MACA,KAAArB,cAAA,GAAAqB,GAAA;MACA,KAAAtB,YAAA;IACA;IACAuB,YAAAC,OAAA;MACA;QACA,OAAAC,IAAA,CAAAC,KAAA,CAAAF,OAAA;MACA,SAAAG,CAAA;QACA;MACA;IACA;IACAC,UAAAC,GAAA;MACA,KAAAA,GAAA;MACA;MACA,WAAAA,GAAA,iBAAAA,GAAA,CAAAC,EAAA;QACA,OAAA1C,MAAA,CAAA2C,WAAA,GAAAF,GAAA,CAAAC,EAAA;MACA;MACA;MACA,OAAAD,GAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
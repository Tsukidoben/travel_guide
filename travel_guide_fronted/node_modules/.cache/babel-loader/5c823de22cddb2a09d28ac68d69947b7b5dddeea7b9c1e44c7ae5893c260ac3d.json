Fields();\n    },\n    submitForm(formName){\n      this.$refs.ruleForm.validate((valid) => {\n        if (valid) {\n          request({\n            url:config.backHost + \"/user/changePwd\",\n            data:this.ruleForm\n          }).then(res=>{\n            if(res.code===200){\n              this.$message.success(\"密码修改成功,请重新登录\");\n              localStorage.clear();\n              this.$router.replace({name: 'login'});\n            }else{\n              this.$message.error(res.msg);\n            }\n          })\n        }\n      });\n    }\n  }\n}\n</script>\n\n<style scoped>\n.password-dialog ::v-deep .el-dialog__body{\n  padding: 20px 10px 0 10px !important;\n}\n\n.password-dialog ::v-deep .el-dialog__footer{\n  padding: 10px !important;\n  border-top: 1px solid RGB(211,211,211) !important;\n}\n\n.password-dialog ::v-deep .el-dialog__header{\n  padding: 10px !important;\n  border-bottom: 1px solid RGB(211,211,211) !important;\n}\n</style>\n\n"],"mappings":"AAqCA,OAAAA,OAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA,IAAAC,YAAA,GAAAA,CAAAC,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,IAAAD,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACA,SAAAC,QAAA,CAAAC,SAAA;UACA,KAAAC,KAAA,CAAAF,QAAA,CAAAG,aAAA;QACA;QACAL,QAAA;MACA;IACA;IACA,IAAAM,aAAA,GAAAA,CAAAR,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,IAAAD,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA,WAAAF,KAAA,UAAAG,QAAA,CAAAK,MAAA;QACAP,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA;MACAE,QAAA;QACAM,MAAA;QACAD,MAAA;QACAJ,SAAA;MACA;MACAM,KAAA;QACAD,MAAA,GACA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAL,MAAA,GACA;UAAAG,QAAA;UAAAG,SAAA,EAAAhB,YAAA;UAAAe,OAAA;QAAA,GACA;UAAAE,GAAA;UAAAC,GAAA;UAAAJ,OAAA;UAAAC,OAAA;QAAA,EACA;QACAT,SAAA,GACA;UAAAO,QAAA;UAAAG,SAAA,EAAAP,aAAA;UAAAM,OAAA;QAAA,GACA;UAAAE,GAAA;UAAAC,GAAA;UAAAJ,OAAA;UAAAC,OAAA;QAAA;MAEA;IACA;EACA;EACAI,KAAA;IACAC,eAAA;MACAC,IAAA,EAAAC,OAAA;MACAC,OAAA,EAAAA,CAAA;IACA;EACA;EACAC,QAAA,GACA;EACAC,OAAA;IACAC,YAAA;MACA,KAAAC,KAAA;IACA;IACAC,UAAA;MACA,KAAArB,KAAA,CAAAF,QAAA,CAAAwB,WAAA;IACA;IACAC,WAAAC,QAAA;
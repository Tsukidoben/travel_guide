dImgKey:new Date().getTime(),\r\n    };\r\n  },\r\n  methods: {\r\n    initForm(){\r\n      this.newUploadImgKey = new Date().getTime()\r\n        request({\r\n          url: config.backHost + \"/attractionType/listPage\",\r\n          data: {}\r\n        }).then(res => {\r\n          this.typeIdOptions = res.data;\r\n        });\r\n\r\n    },\r\n    clearData(){\r\n      this.formData = {\r\n        attractionPic: '',\r\n        attractionName: '',\r\n        typeId: '',\r\n        attractionDesc: '',\r\n        attractionDetail: '',\r\n        attractionPlace: '',\r\n      };\r\n    },\r\n    beforeSave() {\r\n      let message = '';\r\n      if (!this.formData.attractionPic) {\r\n        message += \"景点图片不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionName) {\r\n        message += \"景点名称不能为空<br>\";\r\n      }\r\n      if (!this.formData.typeId) {\r\n        message += \"景点分类不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionDesc) {\r\n        message += \"景点简介不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionDetail) {\r\n        message += \"景点描述不能为空<br>\";\r\n      }\r\n      if (!this.formData.attractionPlace) {\r\n        message += \"景点位置不能为空<br>\";\r\n      }\r\n      return message;\r\n    },\r\n  }\r\n};\r\n</script>\r\n"],"mappings":"AA2CA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AACA,OAAAC,eAAA;AACA,OAAAC,mBAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAP,SAAA;EACAQ,UAAA;IAAAL,gBAAA;IAAAC,eAAA;IAAAC;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,aAAA;QACAC,cAAA;QACAC,MAAA;QACAC,cAAA;QACAC,gBAAA;QACAC,eAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,aAAA;MACAC,eAAA,MAAAC,IAAA,GAAAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA;MACA,KAAAJ,eAAA,OAAAC,IAAA,GAAAC,OAAA;MACArB,OAAA;QACAwB,GAAA,EAAAvB,MAAA,CAAAwB,QAAA;QACAjB,IAAA;MACA,GAAAkB,IAAA,CAAAC,GAAA;QACA,KAAAT,aAAA,GAAAS,GAAA,CAAAnB,IAAA;MACA;IAEA;IACAoB,UAAA;MACA,KAAAnB,QAAA;QACAC,aAAA;QACAC,cAAA;QACAC,MAAA;QACAC,cAAA;QACAC,gBAAA;QACAC,eAAA;MACA;IACA;IACAc,WAAA;MACA,IAAAC,OAAA;MACA,UAAArB,QA
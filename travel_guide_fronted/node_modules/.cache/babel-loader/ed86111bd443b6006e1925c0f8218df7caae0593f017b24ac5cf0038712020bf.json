{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport CarouselImageForm from \"@/views/manage/carouselImage/CarouselImageForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nexport default {\n  name: \"CarouselImageList\",\n  components: {\n    CarouselImageForm,\n    SearchTop\n  },\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/carouselImage/delById/\",\n      delBatchUrl: \"/carouselImage/delBatch\",\n      statusOptions: [{\n        \"value\": \"1\",\n        \"label\": \"正常\"\n      }, {\n        \"value\": \"2\",\n        \"label\": \"不生效\"\n      }],\n      searchList: [{\n        type: 'input',\n        name: '轮播图标题',\n        placeholder: '轮播图标题',\n        value: 'imgTitle'\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      const user = this.$store.getters.getUser;\n      return user ? user.userRole : null;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData() {},\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/carouselImage/listPage\",\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","CarouselImageForm","SearchTop","name","components","mixins","data","delUrl","delBatchUrl","statusOptions","searchList","type","placeholder","value","computed","userRole","user","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","url","backHost","params","then","res","code","tableData"],"sources":["src/views/manage/carouselImage/CarouselImageList.vue"],"sourcesContent":["<template>\n  <div class=\"own-mvue-list-box\">\n    <!--搜索区域-->\n    <div class=\"own-list-search-box\">\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\n    </div>\n    <div class=\"newTableStyle\">\n      <!--列表操作区域-->\n      <div v-if=\"userRole == '1'\" class=\"own-list-action-box\" style=\"display:block;\">\n        <el-button plain v-if=\"userRole == '1'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增数据',null)\">新增</el-button>\n        <el-button plain v-if=\"userRole == '1'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\n      </div>\n      <!--列表数据区域-->\n      <div class=\"own-list-table-box\">\n        <!-- 表格内容 -->\n        <div class=\"own-list-table-data-box\">\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\n            <el-table-column type=\"selection\" width=\"55\" />\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\n            <el-table-column prop=\"imgTitle\" label=\"轮播图标题\"/>\n            <el-table-column prop=\"imgUrl\" width=\"100\" label=\"轮播图图片\">\n              <template #default=\"{row,$index}\">\n                <el-image style=\"width: 60px;height: 60px\" :src=\"getPicUrlByJson(row.imgUrl,0)\" :preview-src-list=\"[getPicUrlByJson(row.imgUrl,0)]\"></el-image>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"sortNum\" label=\"排序\"/>\n            <el-table-column prop=\"status\" label=\"状态\">\n              <template #default=\"{row,$index}\">\n                <span>{{ statusOptions?.find(i=>i.value == row.status)?.label }}</span>\n              </template>\n            </el-table-column>\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"150\">\n              <template #default=\"{ row }\">\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"openForm('edit', '编辑数据', row)\">编辑</span>\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;\" @click=\"delById(row, delUrl)\">删除</span>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n\n        <!--分页区域-->\n        <el-pagination\n                :current-page=\"pageBean.page\"\n                :page-sizes=\"[10, 20, 50, 100]\"\n                :page-size=\"pageBean.pageSize\"\n                layout=\"total, sizes, prev, pager, next\"\n                :total=\"pageBean.total\"\n                @current-change=\"currPageChange\"\n                @size-change=\"handleSizeChange\" />\n      </div>\n    </div>\n    <!--表单-->\n    <CarouselImageForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\n  </div>\n</template>\n\n<script>\nimport TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport CarouselImageForm from \"@/views/manage/carouselImage/CarouselImageForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\n\nexport default {\n  name: \"CarouselImageList\",\n  components: { CarouselImageForm ,SearchTop},\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/carouselImage/delById/\",\n      delBatchUrl: \"/carouselImage/delBatch\",\n      statusOptions: [{\"value\":\"1\",\"label\":\"正常\"},{\"value\":\"2\",\"label\":\"不生效\"}],\n      searchList: [\n        {type:'input',name:'轮播图标题',placeholder:'轮播图标题',value:'imgTitle'},\n      ]\n    }\n  },\n  computed: {\n    userRole() {\n      const user = this.$store.getters.getUser;\n      return user ? user.userRole : null;\n    },\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    initData(){\n    },\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/carouselImage/listPage\",\n        data: { params: searchForm, pageBean: pageBean }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n@use \"@/assets/css/table.scss\";\n</style>\n"],"mappings":"AAyDA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,iBAAA;AACA,OAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH,iBAAA;IAAAC;EAAA;EACAG,MAAA,GAAAP,UAAA;EACAQ,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,aAAA;QAAA;QAAA;MAAA;QAAA;QAAA;MAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAR,IAAA;QAAAS,WAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,MAAAC,IAAA,QAAAC,MAAA,CAAAC,OAAA,CAAAC,OAAA;MACA,OAAAH,IAAA,GAAAA,IAAA,CAAAD,QAAA;IACA;EACA;EACAK,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,KAAA,MAAAC,UAAA,OAAAC,QAAA;EACA;EACAC,OAAA;IACAJ,SAAA,GACA;IACAC,MAAAC,UAAA,EAAAC,QAAA;MACAzB,OAAA;QACA2B,GAAA,EAAA1B,MAAA,CAAA2B,QAAA;QACArB,IAAA;UAAAsB,MAAA,EAAAL,UAAA;UAAAC,QAAA,EAAAA;QAAA;MACA,GAAAK,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAAxB,IAAA;UACA,KAAAkB,QAAA,GAAAM,GAAA,CAAAN,QAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
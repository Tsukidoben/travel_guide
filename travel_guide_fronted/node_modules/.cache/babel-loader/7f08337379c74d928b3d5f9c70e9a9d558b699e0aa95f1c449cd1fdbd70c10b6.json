{"ast":null,"code":"import TableUtils from \"@/utils/tableUtils\";\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport UserManageForm from \"@/views/manage/userManage/UserManageForm.vue\";\nimport SearchTop from \"@/components/searchTop.vue\";\nexport default {\n  name: \"UserManageList\",\n  components: {\n    UserManageForm,\n    SearchTop\n  },\n  mixins: [TableUtils],\n  data() {\n    return {\n      delUrl: \"/user/delById/\",\n      delBatchUrl: \"/user/delBatch\",\n      userSexOptions: [{\n        \"value\": \"1\",\n        \"label\": \"男\"\n      }, {\n        \"value\": \"0\",\n        \"label\": \"女\"\n      }],\n      userRoleOptions: [{\n        \"value\": \"1\",\n        \"label\": \"管理员\"\n      }, {\n        \"value\": \"3\",\n        \"label\": \"商家\"\n      }, {\n        \"value\": \"2\",\n        \"label\": \"用户\"\n      }],\n      searchList: [{\n        type: 'input',\n        name: '用户名',\n        placeholder: '用户名',\n        value: 'userName'\n      }, {\n        type: 'input',\n        name: '用户账号',\n        placeholder: '用户账号',\n        value: 'userAccount'\n      }, {\n        type: 'select',\n        name: '角色',\n        placeholder: '角色',\n        value: 'userRole',\n        data: [{\n          \"value\": \"1\",\n          \"label\": \"管理员\"\n        }, {\n          \"value\": \"3\",\n          \"label\": \"商家\"\n        }, {\n          \"value\": \"2\",\n          \"label\": \"用户\"\n        }],\n        key: 'value',\n        label: 'label'\n      }, {\n        type: 'input',\n        name: '联系电话',\n        placeholder: '联系电话',\n        value: 'userPhone'\n      }]\n    };\n  },\n  computed: {\n    userRole() {\n      return this.$store.getters.getUser.userRole;\n    }\n  },\n  mounted() {\n    this.initData();\n    this.query(this.searchForm, this.pageBean);\n  },\n  methods: {\n    resetPwd(row) {\n      this.$confirm('确定重置？', '温馨提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        request({\n          url: config.backHost + \"/user/resetPwd\",\n          data: {\n            userId: row.id\n          }\n        }).then(res => {\n          if (res.code == 200) {\n            this.$message({\n              type: 'success',\n              message: '重置密码成功!'\n            });\n          }\n        });\n      }).catch(err => {\n        this.$message({\n          type: 'info',\n          message: '已取消重置密码'\n        });\n      });\n    },\n    resetLoginStatus(row) {\n      this.$confirm(`确定重置【${row.userName}】登录次数？`, '温馨提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        request({\n          url: config.backHost + \"/user/resetLoginStatus/\" + row.id\n        }).then(res => {\n          if (res.code == 200) {\n            this.$message({\n              type: 'success',\n              message: '重置登录次数成功!'\n            });\n          }\n        });\n      }).catch(err => {\n        this.$message({\n          type: 'info',\n          message: '已取消重置登录次数'\n        });\n      });\n    },\n    initData() {},\n    query(searchForm, pageBean) {\n      request({\n        url: config.backHost + \"/user/listPage\",\n        data: {\n          params: searchForm,\n          pageBean: pageBean\n        }\n      }).then(res => {\n        if (res.code === 200) {\n          this.tableData = res.data;\n          this.pageBean = res.pageBean;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["TableUtils","request","config","UserManageForm","SearchTop","name","components","mixins","data","delUrl","delBatchUrl","userSexOptions","userRoleOptions","searchList","type","placeholder","value","key","label","computed","userRole","$store","getters","getUser","mounted","initData","query","searchForm","pageBean","methods","resetPwd","row","$confirm","confirmButtonText","cancelButtonText","then","url","backHost","userId","id","res","code","$message","message","catch","err","resetLoginStatus","userName","params","tableData"],"sources":["src/views/manage/userManage/UserManageList.vue"],"sourcesContent":["<template>\r\n  <div class=\"own-mvue-list-box\">\r\n    <!--搜索区域-->\r\n    <div class=\"own-list-search-box\">\r\n      <search-top ref=\"searchTop\" :searchForm.sync=\"searchForm\" :list.sync=\"searchList\" @searchData=\"searchData\" @clearSearch=\"clearSearch\"/>\r\n    </div>\r\n    <div class=\"newTableStyle\">\r\n      <!--列表操作区域-->\r\n      <div v-if=\"userRole == '1'\" class=\"own-list-action-box\" style=\"display:block;\">\r\n        <el-button plain v-if=\"userRole == '1'\" type=\"primary\" size=\"small\" @click=\"openForm('add','新增用户',null)\">新增用户</el-button>\r\n        <el-button plain v-if=\"userRole == '1'\" type=\"danger\" size=\"small\" @click=\"delBatch($refs.table.selection, delBatchUrl)\">批量删除</el-button>\r\n      </div>\r\n      <!--列表数据区域-->\r\n      <div class=\"own-list-table-box\">\r\n        <!-- 表格内容 -->\r\n        <div class=\"own-list-table-data-box\">\r\n          <el-table ref=\"table\" height=\"100%\" :data=\"tableData\" style=\"width: 100%\" :cell-style=\"{ textAlign: 'center' }\" :header-cell-style=\"{ textAlign: 'center' }\">\r\n            <el-table-column type=\"selection\" width=\"55\" />\r\n            <el-table-column type=\"index\" width=\"55\" label=\"序号\" />\r\n            <el-table-column prop=\"headPicUrl\" width=\"100\" label=\"头像\">\r\n              <template #default=\"{row,$index}\">\r\n                <el-image style=\"width: 60px;height: 60px\" :src=\"getPicUrlByJson(row.headPicUrl,0)\" :preview-src-list=\"[getPicUrlByJson(row.headPicUrl,0)]\"></el-image>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"userName\" min-width=\"150\" label=\"用户名\"/>\r\n            <el-table-column prop=\"userAccount\" label=\"用户账号\"/>\r\n            <el-table-column prop=\"userSex\" label=\"性别\">\r\n              <template #default=\"{row,$index}\">\r\n                <span>{{ userSexOptions?.find(i=>i.value == row.userSex)?.label }}</span>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"userPhone\"  min-width=\"150\" label=\"联系电话\"/>\r\n            <el-table-column prop=\"userRole\" label=\"角色\">\r\n              <template #default=\"{row,$index}\">\r\n                <span>{{ userRoleOptions?.find(i=>i.value == row.userRole)?.label }}</span>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column fixed=\"right\" v-if=\"userRole == '1'\" label=\"操作\" width=\"270\">\r\n              <template #default=\"{ row }\">\r\n                <span class=\"span-button\" style=\"color: #FFA200;border-color: #FFA200\" @click=\"resetPwd(row)\">重置密码</span>\r\n                <span class=\"span-button\" style=\"color: #FFA200;border-color: #FFA200\" @click=\"resetLoginStatus(row)\">重置登录</span>\r\n                <span v-if=\"userRole == '1'\" class=\"span-button\" @click=\"openForm('edit', '编辑用户信息', row)\">编辑</span>\r\n                <span v-if=\"userRole == '1'\" class=\"span-button\" style=\"color:red;border-color: red;\" @click=\"delById(row, delUrl)\">删除</span>\r\n              </template>\r\n            </el-table-column>\r\n          </el-table>\r\n        </div>\r\n\r\n        <!--分页区域-->\r\n        <el-pagination\r\n                :current-page=\"pageBean.page\"\r\n                :page-sizes=\"[10, 20, 50, 100]\"\r\n                :page-size=\"pageBean.pageSize\"\r\n                layout=\"total, sizes, prev, pager, next\"\r\n                :total=\"pageBean.total\"\r\n                @current-change=\"currPageChange\"\r\n                @size-change=\"handleSizeChange\" />\r\n      </div>\r\n    </div>\r\n    <!--表单-->\r\n    <UserManageForm ref=\"form\" @reload=\"query(searchForm,pageBean)\" :dialog-visible.sync=\"formDialog\" :title.sync=\"formTitle\" :action.sync=\"formAction\" />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport TableUtils from \"@/utils/tableUtils\";\r\nimport request from \"@/utils/request\";\r\nimport config from \"@/config/config\";\r\nimport UserManageForm from \"@/views/manage/userManage/UserManageForm.vue\";\r\nimport SearchTop from \"@/components/searchTop.vue\";\r\n\r\nexport default {\r\n  name: \"UserManageList\",\r\n  components: { UserManageForm ,SearchTop},\r\n  mixins: [TableUtils],\r\n  data() {\r\n    return {\r\n      delUrl: \"/user/delById/\",\r\n      delBatchUrl: \"/user/delBatch\",\r\n      userSexOptions: [{\"value\":\"1\",\"label\":\"男\"},{\"value\":\"0\",\"label\":\"女\"}],\r\n      userRoleOptions: [{\"value\":\"1\",\"label\":\"管理员\"},{\"value\":\"3\",\"label\":\"商家\"},{\"value\":\"2\",\"label\":\"用户\"}],\r\n      searchList: [\r\n        {type:'input',name:'用户名',placeholder:'用户名',value:'userName'},\r\n        {type:'input',name:'用户账号',placeholder:'用户账号',value:'userAccount'},\r\n        {type:'select',name:'角色',placeholder:'角色',value:'userRole',data: [{\"value\":\"1\",\"label\":\"管理员\"},{\"value\":\"3\",\"label\":\"商家\"},{\"value\":\"2\",\"label\":\"用户\"}] , key: 'value' ,label: 'label'},\r\n        {type:'input',name:'联系电话',placeholder:'联系电话',value:'userPhone'},\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    userRole() {\r\n      return this.$store.getters.getUser.userRole;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.initData();\r\n    this.query(this.searchForm, this.pageBean);\r\n  },\r\n  methods: {\r\n    resetPwd(row){\r\n      this.$confirm('确定重置？', '温馨提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        request({\r\n          url: config.backHost + \"/user/resetPwd\",\r\n          data: {userId: row.id}\r\n        }).then(res => {\r\n          if (res.code == 200) {\r\n            this.$message({\r\n              type: 'success',\r\n              message: '重置密码成功!'\r\n            });\r\n          }\r\n        })\r\n      }).catch(err=>{\r\n        this.$message({\r\n          type: 'info',\r\n          message: '已取消重置密码'\r\n        });\r\n      })\r\n    },\r\n    resetLoginStatus(row){\r\n      this.$confirm(`确定重置【${row.userName}】登录次数？`, '温馨提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        request({\r\n          url: config.backHost + \"/user/resetLoginStatus/\" + row.id,\r\n        }).then(res => {\r\n          if (res.code == 200) {\r\n            this.$message({\r\n              type: 'success',\r\n              message: '重置登录次数成功!'\r\n            });\r\n          }\r\n        })\r\n      }).catch(err=>{\r\n        this.$message({\r\n          type: 'info',\r\n          message: '已取消重置登录次数'\r\n        });\r\n      })\r\n    },\r\n    initData(){\r\n    },\r\n    query(searchForm, pageBean) {\r\n      request({\r\n        url: config.backHost + \"/user/listPage\",\r\n        data: { params: searchForm, pageBean: pageBean }\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.tableData = res.data;\r\n          this.pageBean = res.pageBean;\r\n        }\r\n      });\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n@use \"@/assets/css/table.scss\";\r\n</style>\r\n"],"mappings":"AAiEA,OAAAA,UAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,cAAA;AACA,OAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH,cAAA;IAAAC;EAAA;EACAG,MAAA,GAAAP,UAAA;EACAQ,KAAA;IACA;MACAC,MAAA;MACAC,WAAA;MACAC,cAAA;QAAA;QAAA;MAAA;QAAA;QAAA;MAAA;MACAC,eAAA;QAAA;QAAA;MAAA;QAAA;QAAA;MAAA;QAAA;QAAA;MAAA;MACAC,UAAA,GACA;QAAAC,IAAA;QAAAT,IAAA;QAAAU,WAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,IAAA;QAAAT,IAAA;QAAAU,WAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,IAAA;QAAAT,IAAA;QAAAU,WAAA;QAAAC,KAAA;QAAAR,IAAA;UAAA;UAAA;QAAA;UAAA;UAAA;QAAA;UAAA;UAAA;QAAA;QAAAS,GAAA;QAAAC,KAAA;MAAA,GACA;QAAAJ,IAAA;QAAAT,IAAA;QAAAU,WAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAG,QAAA;IACAC,SAAA;MACA,YAAAC,MAAA,C
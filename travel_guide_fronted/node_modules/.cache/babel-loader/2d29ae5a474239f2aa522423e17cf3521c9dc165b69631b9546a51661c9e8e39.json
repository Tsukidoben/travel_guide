{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport FormUtils from '@/utils/formUtils';\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\nexport default {\n  name: \"FoodCategoryForm\",\n  mixins: [FormUtils],\n  components: {\n    OwnSidebarDialog\n  },\n  data() {\n    return {\n      formData: {\n        id: null,\n        name: '',\n        parentId: 0,\n        sort: 0\n      },\n      addUrl: '/api/food/category/saveOrUpdate',\n      editUrl: '/api/food/category/saveOrUpdate',\n      parentCategoryList: [] // 父级分类列表\n    };\n  },\n  methods: {\n    initForm() {\n      // 获取所有一级分类作为父级选项\n      this.getParentCategories();\n    },\n    getParentCategories() {\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'GET'\n      }).then(res => {\n        if (res.code === 200) {\n          // 只显示一级分类(parentId为0的)\n          this.parentCategoryList = (res.data || []).filter(item => item.parentId === 0);\n        }\n      });\n    },\n    clearData() {\n      this.formData = {\n        id: null,\n        name: '',\n        parentId: 0,\n        sort: 0\n      };\n      this.getParentCategories(); // 重新加载父级分类列表\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.name) {\n        message += \"分类名称不能为空<br>\";\n      }\n      return message;\n    }\n  }\n};","map":{"version":3,"names":["FormUtils","request","config","OwnSidebarDialog","name","mixins","components","data","formData","id","parentId","sort","addUrl","editUrl","parentCategoryList","methods","initForm","getParentCategories","url","backHost","method","then","res","code","filter","item","clearData","beforeSave","message"],"sources":["src/views/manage/foodInfo/FoodCategoryForm.vue"],"sourcesContent":["<template>\n  <div class=\"form-box\">\n    <el-dialog top=\"10vh\" width=\"500px\" :title=\"title\" :visible.sync=\"visible\" :before-close=\"closeDialog\" :modal=\"true\" :close-on-click-modal=\"false\">\n      <template #default>\n        <el-form :model=\"formData\" ref=\"form\" label-width=\"auto\" style=\"padding: 0 20px\">\n          <el-form-item prop=\"name\" label=\"分类名称\">\n            <el-input type=\"text\" v-model=\"formData.name\" style=\"width: 100%\"  placeholder=\"请输入分类名称,如:地方特色、甜点饮品\"/>\n          </el-form-item>\n          <el-form-item prop=\"parentId\" label=\"父级分类\">\n            <el-select v-model=\"formData.parentId\" placeholder=\"请选择父级分类(不选则为一级分类)\" style=\"width: 100%\" clearable>\n              <el-option label=\"无(一级分类)\" :value=\"0\"></el-option>\n              <el-option \n                v-for=\"item in parentCategoryList\" \n                :key=\"item.id\" \n                :label=\"item.name\" \n                :value=\"item.id\">\n              </el-option>\n            </el-select>\n            <div style=\"font-size: 12px; color: #909399; margin-top: 5px;\">\n              💡 选择\"无\"表示创建一级分类;选择其他分类则作为其子分类\n            </div>\n          </el-form-item>\n          <el-form-item prop=\"sort\" label=\"排序\">\n            <el-input-number v-model=\"formData.sort\" :min=\"0\" :max=\"999\" style=\"width: 100%\"></el-input-number>\n            <div style=\"font-size: 12px; color: #909399; margin-top: 5px;\">\n              💡 数字越小越靠前,建议从 0 开始设置\n            </div>\n          </el-form-item>\n        </el-form>\n      </template>\n      <template #footer>\n        <el-button type=\"primary\" size=\"small\" @click=\"confirmSubmit(action,formData)\">确认</el-button>\n        <el-button type=\"warning\" size=\"small\" @click=\"closeDialog\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport FormUtils from '@/utils/formUtils'\nimport request from \"@/utils/request\";\nimport config from \"@/config/config\";\nimport OwnSidebarDialog from \"@/components/OwnSidebarDialog.vue\";\n\nexport default {\n  name: \"FoodCategoryForm\",\n  mixins: [FormUtils],\n  components: {OwnSidebarDialog },\n  data() {\n    return {\n      formData: {\n          id: null,\n          name: '',\n          parentId: 0,\n          sort: 0,\n      },\n      addUrl: '/api/food/category/saveOrUpdate',\n      editUrl: '/api/food/category/saveOrUpdate',\n      parentCategoryList: [], // 父级分类列表\n\n    };\n  },\n  methods: {\n    initForm(){\n      // 获取所有一级分类作为父级选项\n      this.getParentCategories();\n    },\n    getParentCategories() {\n      request({\n        url: config.backHost + \"/api/food/category/list\",\n        method: 'GET'\n      }).then(res => {\n        if (res.code === 200) {\n          // 只显示一级分类(parentId为0的)\n          this.parentCategoryList = (res.data || []).filter(item => item.parentId === 0);\n        }\n      });\n    },\n    clearData(){\n      this.formData = {\n        id: null,\n        name: '',\n        parentId: 0,\n        sort: 0,\n      };\n      this.getParentCategories(); // 重新加载父级分类列表\n    },\n    beforeSave() {\n      let message = '';\n      if (!this.formData.name) {\n        message += \"分类名称不能为空<br>\";\n      }\n      return message;\n    },\n  }\n};\n</script>\n<style scoped lang=\"scss\">\n  ::v-deep .el-dialog__body{\n    max-height: 60vh;\n    overflow-x: hidden;\n    overflow-y: auto;\n  }\n</style>\n"],"mappings":";;AAuCA,OAAAA,SAAA;AACA,OAAAC,OAAA;AACA,OAAAC,MAAA;AACA,OAAAC,gBAAA;AAEA;EACAC,IAAA;EACAC,MAAA,GAAAL,SAAA;EACAM,UAAA;IAAAH;EAAA;EACAI,KAAA;IACA;MACAC,QAAA;QACAC,EAAA;QACAL,IAAA;QACAM,QAAA;QACAC,IAAA;MACA;MACAC,MAAA;MACAC,OAAA;MACAC,kBAAA;IAEA;EACA;EACAC,OAAA;IACAC,SAAA;MACA;MACA,KAAAC,mBAAA;IACA;IACAA,oBAAA;MACAhB,OAAA;QACAiB,GAAA,EAAAhB,MAAA,CAAAiB,QAAA;QACAC,MAAA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA;UACA,KAAAT,kBAAA,IAAAQ,GAAA,CAAAf,IAAA,QAAAiB,MAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAf,QAAA;QACA;MACA;IACA;IACAgB,UAAA;MACA,KAAAlB,QAAA;QACAC,EAAA;QACAL,IAAA;QACAM,QAAA;QACAC,IAAA;MACA;MACA,KAAAM,mBAAA;IACA;IACAU,WAAA;MACA,IAAAC,OAAA;MACA,UAAApB,QAAA,CAAAJ,IAAA;QACAwB,OAAA;MACA;MACA,OAAAA,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}
{"ast":null,"code":"import E from 'wangeditor';\nimport axios from 'axios';\nimport config from \"@/config/config\";\nexport default {\n  name: 'WangEditorComponent',\n  props: {\n    value: {\n      type: String,\n      default: ''\n    },\n    height: {\n      type: Number,\n      default: 300\n    },\n    disabled: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      editor: null,\n      uploadImgServer: config.uploadUrl\n    };\n  },\n  mounted() {\n    this.editor = new E(this.$refs.toolbar, this.$refs.editor);\n    this.editor.config.onchange = html => {\n      this.$emit('input', html);\n    };\n\n    // V4 配置方式如下\n    this.editor.config.uploadImgServer = this.uploadImgServer;\n    this.editor.config.uploadFileName = 'file';\n    this.editor.config.uploadImgHeaders = {\n      Authorization: localStorage.getItem('token')\n    };\n    this.editor.config.uploadImgMaxSize = 5 * 1024 * 1024;\n    this.editor.config.uploadImgMaxLength = 10;\n    this.editor.config.uploadImgAccept = [];\n    this.editor.config.withCredentials = true;\n    this.editor.config.uploadImgHooks = {\n      customInsert: (insertImgFn, result, editor) => {\n        if (result && result.code === 200 && Array.isArray(result.data) && result.data.length > 0) {\n          const imgId = result.data[0].id;\n          const realUrl = config.downloadUrl + imgId;\n          const html = `<img src=\"${realUrl}\" data-img-id=\"${imgId}\" style=\"max-width:100%;\" />`;\n          editor.txt.append(html);\n        } else {\n          this.$message.error('图片上传失败');\n        }\n      }\n    };\n    this.editor.create();\n    this.editor.txt.html(this.value);\n    if (this.disabled) {\n      this.editor.disable();\n    }\n  },\n  watch: {\n    value(newVal) {\n      if (this.editor && this.editor.txt.html() !== newVal) {\n        this.editor.txt.html(newVal);\n      }\n    },\n    disabled(newVal) {\n      if (!this.editor) return;\n      newVal ? this.editor.disable() : this.editor.enable();\n    }\n  },\n  beforeDestroy() {\n    if (this.editor) {\n      this.editor.destroy();\n      this.editor = null;\n    }\n  }\n};","map":{"version":3,"names":["E","axios","config","name","props","value","type","String","default","height","Number","disabled","Boolean","data","editor","uploadImgServer","uploadUrl","mounted","$refs","toolbar","onchange","html","$emit","uploadFileName","uploadImgHeaders","Authorization","localStorage","getItem","uploadImgMaxSize","uploadImgMaxLength","uploadImgAccept","withCredentials","uploadImgHooks","customInsert","insertImgFn","result","code","Array","isArray","length","imgId","id","realUrl","downloadUrl","txt","append","$message","error","create","disable","watch","newVal","enable","beforeDestroy","destroy"],"sources":["src/components/WangEditorComponent.vue"],"sourcesContent":["<template>\n  <div>\n    <div ref=\"toolbar\"></div>\n    <div\n        ref=\"editor\"\n        :style=\"{\n        border: '1px solid #ccc',\n        height: height + 'px',\n        overflowY: 'auto'\n      }\"\n    ></div>\n  </div>\n</template>\n\n<script>\nimport E from 'wangeditor'\nimport axios from 'axios'\nimport config from \"@/config/config\";\n\nexport default {\n  name: 'WangEditorComponent',\n  props: {\n    value: {\n      type: String,\n      default: '',\n    },\n    height: {\n      type: Number,\n      default: 300,\n    },\n    disabled: { type: Boolean, default: false }\n  },\n  data() {\n    return {\n      editor: null,\n      uploadImgServer: config.uploadUrl\n    }\n  },\n  mounted() {\n    this.editor = new E(this.$refs.toolbar, this.$refs.editor)\n\n    this.editor.config.onchange = (html) => {\n      this.$emit('input', html)\n    }\n\n    // V4 配置方式如下\n    this.editor.config.uploadImgServer = this.uploadImgServer\n    this.editor.config.uploadFileName = 'file'\n    this.editor.config.uploadImgHeaders = {\n      Authorization: localStorage.getItem('token'),\n    }\n    this.editor.config.uploadImgMaxSize = 5 * 1024 * 1024\n    this.editor.config.uploadImgMaxLength = 10\n    this.editor.config.uploadImgAccept = []\n    this.editor.config.withCredentials = true\n\n    this.editor.config.uploadImgHooks = {\n      customInsert: (insertImgFn, result, editor) => {\n        if (\n            result &&\n            result.code === 200 &&\n            Array.isArray(result.data) &&\n            result.data.length > 0\n        ) {\n          const imgId = result.data[0].id\n          const realUrl = config.downloadUrl + imgId\n          const html = `<img src=\"${realUrl}\" data-img-id=\"${imgId}\" style=\"max-width:100%;\" />`\n          editor.txt.append(html)\n        } else {\n          this.$message.error('图片上传失败')\n        }\n      }\n    }\n\n    this.editor.create()\n    this.editor.txt.html(this.value)\n\n    if (this.disabled) {\n      this.editor.disable()\n    }\n\n  },\n  watch: {\n    value(newVal) {\n      if (this.editor && this.editor.txt.html() !== newVal) {\n        this.editor.txt.html(newVal)\n      }\n    },\n    disabled(newVal) {\n      if (!this.editor) return\n      newVal ? this.editor.disable() : this.editor.enable()\n    },\n  },\n  beforeDestroy() {\n    if (this.editor) {\n      this.editor.destroy()\n      this.editor = null\n    }\n  },\n}\n</script>\n\n<style scoped>\n</style>\n"],"mappings":"AAeA,OAAAA,CAAA;AACA,OAAAC,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,KAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,MAAA;MACAH,IAAA,EAAAI,MAAA;MACAF,OAAA;IACA;IACAG,QAAA;MAAAL,IAAA,EAAAM,OAAA;MAAAJ,OAAA;IAAA;EACA;EACAK,KAAA;IACA;MACAC,MAAA;MACAC,eAAA,EAAAb,MAAA,CAAAc;IACA;EACA;EACAC,QAAA;IACA,KAAAH,MAAA,OAAAd,CAAA,MAAAkB,KAAA,CAAAC,OAAA,OAAAD,KAAA,CAAAJ,MAAA;IAEA,KAAAA,MAAA,CAAAZ,MAAA,CAAAkB,QAAA,GAAAC,IAAA;MACA,KAAAC,KAAA,UAAAD,IAAA;IACA;;IAEA;IACA,KAAAP,MAAA,CAAAZ,MAAA,CAAAa,eAAA,QAAAA,eAAA;IACA,KAAAD,MAAA,CAAAZ,MAAA,CAAAqB,cAAA;IACA,KAAAT,MAAA,CAAAZ,MAAA,CAAAsB,gBAAA;MACAC,aAAA,EAAAC,YAAA,CAAAC,OAAA;IACA;IACA,KAAAb,MAAA,CAAAZ,MAAA,CAAA0B,g
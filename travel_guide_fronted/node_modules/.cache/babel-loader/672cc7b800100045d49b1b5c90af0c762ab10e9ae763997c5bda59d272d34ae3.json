{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport request from '@/utils/request';\nimport config from '@/config/config';\nexport default {\n  name: 'MyRoutes',\n  data() {\n    return {\n      routeList: [],\n      loading: false,\n      pageNum: 1,\n      pageSize: 10,\n      total: 0\n    };\n  },\n  mounted() {\n    this.loadRoutes();\n  },\n  methods: {\n    // 加载路线列表\n    async loadRoutes() {\n      this.loading = true;\n      try {\n        const res = await request({\n          url: config.backHost + '/api/routeRecommendation/history',\n          method: 'POST',\n          data: {\n            pageBean: {\n              page: this.pageNum,\n              pageSize: this.pageSize\n            }\n          }\n        });\n        if (res.code === 200) {\n          if (res.data && Array.isArray(res.data)) {\n            this.routeList = res.data;\n            this.total = res.pageBean ? res.pageBean.total : res.data.length;\n          } else if (res.pageBean) {\n            this.routeList = res.pageBean.data || res.pageBean.list || [];\n            this.total = res.pageBean.total || 0;\n          }\n        } else {\n          this.$message.error(res.msg || '加载失败');\n        }\n      } catch (error) {\n        console.error('加载路线列表失败:', error);\n        this.$message.error('加载失败，请稍后重试');\n      } finally {\n        this.loading = false;\n      }\n    },\n    // 表格行样式\n    tableRowClassName({\n      row,\n      rowIndex\n    }) {\n      return 'table-row';\n    },\n    // 行点击事件\n    handleRowClick(row) {\n      this.viewDetail(row.id);\n    },\n    // 获取天数标签类型\n    getDaysTagType(days) {\n      if (days <= 3) return 'success'; // 1-3天：绿色\n      if (days <= 7) return 'warning'; // 4-7天：橙色\n      return 'danger'; // 7天以上：红色\n    },\n    // 获取费用样式类\n    getCostClass(row) {\n      if (row.estimatedCost <= row.budget) {\n        return 'cost under-budget'; // 预算内：绿色\n      } else {\n        return 'cost over-budget'; // 超预算：红色\n      }\n    },\n    // 查看详情\n    viewDetail(recommendationId) {\n      this.$router.push({\n        name: 'routeDetail',\n        params: {\n          id: recommendationId\n        }\n      });\n    },\n    // 切换收藏状态\n    async toggleFavorite(row) {\n      try {\n        const isFavorite = !row.isFavorite;\n        const res = await request({\n          url: config.backHost + `/api/routeRecommendation/favorite/${row.id}`,\n          method: 'POST'\n        });\n        if (res.code === 200) {\n          row.isFavorite = isFavorite;\n          this.$message.success(isFavorite ? '收藏成功' : '已取消收藏');\n        } else {\n          this.$message.error(res.msg || '操作失败');\n        }\n      } catch (error) {\n        console.error('收藏操作失败:', error);\n        this.$message.error('操作失败');\n      }\n    },\n    // 删除路线\n    deleteRoute(recommendationId) {\n      this.$confirm('确定要删除这条行程吗？删除后将无法恢复', '提示', {\n        confirmButtonText: '确定删除',\n        cancelButtonText: '取消',\n        type: 'warning',\n        confirmButtonClass: 'el-button--danger'\n      }).then(async () => {\n        try {\n          const res = await request({\n            url: config.backHost + `/api/routeRecommendation/delete/${recommendationId}`,\n            method: 'POST'\n          });\n          if (res.code === 200) {\n            this.$message.success('删除成功');\n            this.loadRoutes();\n          } else {\n            this.$message.error(res.msg || '删除失败');\n          }\n        } catch (error) {\n          console.error('删除失败:', error);\n          this.$message.error('删除失败');\n        }\n      }).catch(() => {\n        this.$message.info('已取消删除');\n      });\n    },\n    // 分页大小改变\n    handleSizeChange(val) {\n      this.pageSize = val;\n      this.pageNum = 1;\n      this.loadRoutes();\n    },\n    // 页码改变\n    handleCurrentChange(val) {\n      this.pageNum = val;\n      this.loadRoutes();\n    }\n  }\n};","map":{"version":3,"names":["request","config","name","data","routeList","loading","pageNum","pageSize","total","mounted","loadRoutes","methods","res","url","backHost","method","pageBean","page","code","Array","isArray","length","list","$message","error","msg","console","tableRowClassName","row","rowIndex","handleRowClick","viewDetail","id","getDaysTagType","days","getCostClass","estimatedCost","budget","recommendationId","$router","push","params","toggleFavorite","isFavorite","success","deleteRoute","$confirm","confirmButtonText","cancelButtonText","type","confirmButtonClass","then","catch","info","handleSizeChange","val","handleCurrentChange"],"sources":["src/views/front/routeRecommend/MyRoutes.vue"],"sourcesContent":["<template>\n  <div class=\"my-routes-container\">\n    <!-- 页面头部 -->\n    <div class=\"page-header\">\n      <h2>我的行程记录</h2>\n      <p>查看和管理您的历史行程推荐</p>\n      <div class=\"header-divider\"></div>\n    </div>\n\n    <!-- 新建行程按钮 -->\n    <div class=\"action-bar\">\n      <el-button type=\"primary\" @click=\"$router.push({name: 'routeGenerate'})\">\n        <i class=\"el-icon-plus\"></i> 新建行程\n      </el-button>\n    </div>\n\n    <!-- 行程列表 -->\n    <el-card v-loading=\"loading\">\n      <!-- 空状态 -->\n      <div v-if=\"!loading && routeList.length === 0\" class=\"empty-state\">\n        <i class=\"el-icon-notebook-2 empty-icon\"></i>\n        <p class=\"empty-text\">您还没有保存过行程，快去生成一条专属路线吧~</p>\n        <el-button type=\"primary\" @click=\"$router.push({name: 'routeGenerate'})\">\n          <i class=\"el-icon-magic-stick\"></i> 去生成行程\n        </el-button>\n      </div>\n\n      <!-- 表格 -->\n      <el-table \n        v-else\n        :data=\"routeList\" \n        style=\"width: 100%\"\n        :row-class-name=\"tableRowClassName\"\n        @row-click=\"handleRowClick\">\n        \n        <!-- 行程名称 -->\n        <el-table-column prop=\"recommendationName\" label=\" 行程名称\" min-width=\"180\">\n          <template slot-scope=\"scope\">\n            <span class=\"route-name\" @click.stop=\"viewDetail(scope.row.id)\">{{ scope.row.recommendationName }}</span>\n          </template>\n        </el-table-column>\n\n        <!-- 天数 -->\n        <el-table-column prop=\"days\" label=\" 天数\" width=\"100\" align=\"right\">\n          <template slot-scope=\"scope\">\n            <el-tag \n              :type=\"getDaysTagType(scope.row.days)\" \n              size=\"small\"\n              class=\"days-tag\">\n              {{ scope.row.days }}天\n            </el-tag>\n          </template>\n        </el-table-column>\n\n        <!-- 预算 -->\n        <el-table-column prop=\"budget\" label=\" 预算\" width=\"120\" align=\"right\">\n          <template slot-scope=\"scope\">\n            <span class=\"budget\">¥{{ scope.row.budget }}</span>\n          </template>\n        </el-table-column>\n\n        <!-- 预估费用 -->\n        <el-table-column prop=\"estimatedCost\" label=\" 预估费用\" width=\"120\" align=\"right\">\n          <template slot-scope=\"scope\">\n            <span :class=\"getCostClass(scope.row)\">¥{{ scope.row.estimatedCost }}</span>\n          </template>\n        </el-table-column>\n\n        <!-- 景点数 -->\n        <el-table-column prop=\"totalAttractions\" label=\"️ 景点数\" width=\"100\" align=\"right\">\n          <template slot-scope=\"scope\">\n            {{ scope.row.totalAttractions }}个\n          </template>\n        </el-table-column>\n\n        <!-- 酒店数 -->\n        <el-table-column prop=\"totalHotels\" label=\" 酒店数\" width=\"100\" align=\"right\">\n          <template slot-scope=\"scope\">\n            {{ scope.row.totalHotels }}家\n          </template>\n        </el-table-column>\n\n        <!-- 总距离 -->\n        <el-table-column prop=\"totalDistance\" label=\" 总距离\" width=\"110\" align=\"right\">\n          <template slot-scope=\"scope\">\n            {{ scope.row.totalDistance }}km\n          </template>\n        </el-table-column>\n\n        <!-- 创建时间 -->\n        <el-table-column prop=\"createTime\" label=\" 创建时间\" width=\"170\" align=\"left\">\n          <template slot-scope=\"scope\">\n            {{ scope.row.createTime }}\n          </template>\n        </el-table-column>\n\n        <!-- 操作 -->\n        <el-table-column label=\"️ 操作\" width=\"280\" fixed=\"right\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button \n              size=\"mini\" \n              type=\"primary\"\n              icon=\"el-icon-view\"\n              @click.stop=\"viewDetail(scope.row.id)\">\n              查看详情\n            </el-button>\n            <el-button \n              size=\"mini\" \n              :type=\"scope.row.isFavorite ? 'warning' : 'success'\"\n              :icon=\"scope.row.isFavorite ? 'el-icon-star-on' : 'el-icon-star-off'\"\n              @click.stop=\"toggleFavorite(scope.row)\">\n              {{ scope.row.isFavorite ? '已收藏' : '收藏' }}\n            </el-button>\n            <el-button \n              size=\"mini\" \n              type=\"danger\"\n              icon=\"el-icon-delete\"\n              class=\"delete-btn\"\n              @click.stop=\"deleteRoute(scope.row.id)\">\n              删除\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <!-- 分页 -->\n      <div v-if=\"total > 0\" class=\"pagination-container\">\n        <span class=\"pagination-info\">共 {{ total }} 条，每页 {{ pageSize }} 条</span>\n        <el-pagination\n          @size-change=\"handleSizeChange\"\n          @current-change=\"handleCurrentChange\"\n          :current-page=\"pageNum\"\n          :page-sizes=\"[10, 20, 50, 100]\"\n          :page-size=\"pageSize\"\n          layout=\"sizes, prev, pager, next, jumper\"\n          :total=\"total\">\n        </el-pagination>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport request from '@/utils/request'\nimport config from '@/config/config'\n\nexport default {\n  name: 'MyRoutes',\n  data() {\n    return {\n      routeList: [],\n      loading: false,\n      pageNum: 1,\n      pageSize: 10,\n      total: 0\n    }\n  },\n  mounted() {\n    this.loadRoutes()\n  },\n  methods: {\n    // 加载路线列表\n    async loadRoutes() {\n      this.loading = true\n      try {\n        const res = await request({\n          url: config.backHost + '/api/routeRecommendation/history',\n          method: 'POST',\n          data: {\n            pageBean: {\n              page: this.pageNum,\n              pageSize: this.pageSize\n            }\n          }\n        })\n        \n        if (res.code === 200) {\n          if (res.data && Array.isArray(res.data)) {\n            this.routeList = res.data\n            this.total = res.pageBean ? res.pageBean.total : res.data.length\n          } else if (res.pageBean) {\n            this.routeList = res.pageBean.data || res.pageBean.list || []\n            this.total = res.pageBean.total || 0\n          }\n        } else {\n          this.$message.error(res.msg || '加载失败')\n        }\n      } catch (error) {\n        console.error('加载路线列表失败:', error)\n        this.$message.error('加载失败，请稍后重试')\n      } finally {\n        this.loading = false\n      }\n    },\n\n    // 表格行样式\n    tableRowClassName({row, rowIndex}) {\n      return 'table-row'\n    },\n\n    // 行点击事件\n    handleRowClick(row) {\n      this.viewDetail(row.id)\n    },\n\n    // 获取天数标签类型\n    getDaysTagType(days) {\n      if (days <= 3) return 'success'  // 1-3天：绿色\n      if (days <= 7) return 'warning'  // 4-7天：橙色\n      return 'danger'                   // 7天以上：红色\n    },\n\n    // 获取费用样式类\n    getCostClass(row) {\n      if (row.estimatedCost <= row.budget) {\n        return 'cost under-budget'  // 预算内：绿色\n      } else {\n        return 'cost over-budget'   // 超预算：红色\n      }\n    },\n\n    // 查看详情\n    viewDetail(recommendationId) {\n      this.$router.push({\n        name: 'routeDetail',\n        params: { id: recommendationId }\n      })\n    },\n\n    // 切换收藏状态\n    async toggleFavorite(row) {\n      try {\n        const isFavorite = !row.isFavorite\n        const res = await request({\n          url: config.backHost + `/api/routeRecommendation/favorite/${row.id}`,\n          method: 'POST'\n        })\n        if (res.code === 200) {\n          row.isFavorite = isFavorite\n          this.$message.success(isFavorite ? '收藏成功' : '已取消收藏')\n        } else {\n          this.$message.error(res.msg || '操作失败')\n        }\n      } catch (error) {\n        console.error('收藏操作失败:', error)\n        this.$message.error('操作失败')\n      }\n    },\n\n    // 删除路线\n    deleteRoute(recommendationId) {\n      this.$confirm('确定要删除这条行程吗？删除后将无法恢复', '提示', {\n        confirmButtonText: '确定删除',\n        cancelButtonText: '取消',\n        type: 'warning',\n        confirmButtonClass: 'el-button--danger'\n      }).then(async () => {\n        try {\n          const res = await request({\n            url: config.backHost + `/api/routeRecommendation/delete/${recommendationId}`,\n            method: 'POST'\n          })\n          if (res.code === 200) {\n            this.$message.success('删除成功')\n            this.loadRoutes()\n          } else {\n            this.$message.error(res.msg || '删除失败')\n          }\n        } catch (error) {\n          console.error('删除失败:', error)\n          this.$message.error('删除失败')\n        }\n      }).catch(() => {\n        this.$message.info('已取消删除')\n      })\n    },\n\n    // 分页大小改变\n    handleSizeChange(val) {\n      this.pageSize = val\n      this.pageNum = 1\n      this.loadRoutes()\n    },\n\n    // 页码改变\n    handleCurrentChange(val) {\n      this.pageNum = val\n      this.loadRoutes()\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"scss\">\n.my-routes-container {\n  padding: 20px;\n  max-width: 1400px;\n  margin: 0 auto;\n\n  .page-header {\n    text-align: center;\n    margin-bottom: 30px;\n    \n    h2 {\n      color: #333;\n      margin-bottom: 10px;\n    }\n    \n    p {\n      color: #666;\n      font-size: 14px;\n    }\n  }\n\n  .route-name {\n    color: #409eff;\n    font-weight: 500;\n  }\n\n  .cost {\n    color: #f56c6c;\n    font-weight: bold;\n  }\n\n  .pagination-container {\n    margin-top: 20px;\n    text-align: right;\n  }\n}\n\n@media (max-width: 768px) {\n  .my-routes-container {\n    padding: 10px;\n    \n    ::v-deep .el-table {\n      font-size: 12px;\n      \n      .el-button--mini {\n        padding: 5px 8px;\n        font-size: 12px;\n      }\n    }\n  }\n}\n</style>"],"mappings":";AA+IA,OAAAA,OAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,UAAA;EACA;EACAC,OAAA;IACA;IACA,MAAAD,WAAA;MACA,KAAAL,OAAA;MACA;QACA,MAAAO,GAAA,SAAAZ,OAAA;UACAa,GAAA,EAAAZ,MAAA,CAAAa,QAAA;UACAC,MAAA;UACAZ,IAAA;YACAa,QAAA;cACAC,IAAA,OAAAX,OAAA;cACAC,QAAA,OAAAA;YACA;UACA;QACA;QAEA,IAAAK,GAAA,CAAAM,IAAA;UACA,IAAAN,GAAA,CAAAT,IAAA,IAAAgB,KAAA,CAAAC,OAAA,CAAAR,GAAA,CAAAT,IAAA;YACA,KAAAC,SAAA,GAAAQ,GAAA,CAAAT,IAAA;YACA,KAAAK,KAAA,GAAAI,GAAA,CAAAI,QAAA,GAAAJ,GAAA,CAAAI,QAAA,CAAAR,KAAA,GAAAI,GAAA,CAAAT,IAAA,CAAAkB,MAAA;UACA,WAAAT,GAAA,CAAAI,QAAA;YACA,KAAAZ,SAAA,GAAAQ,GAAA,CAAAI,QAAA,CAAAb,IAAA,IAAAS,GAAA,CAAAI,QAAA,CAAAM,IAAA;YACA,KAAAd,KAAA,GAAAI,GAAA,CAAAI,QAAA,CAAAR,KAAA;UACA;QACA;UACA,KAAAe,QAAA,CAAAC,KAAA,CAAAZ,GAAA,CAAAa,GAAA;QACA;MACA,SAAAD,KAAA;QACAE,OAAA,CAAAF,KAAA,cAAAA,KAAA;QACA,KAAAD,QAAA,CAAAC,KAAA;MACA;QACA,KAAAnB,OAAA;MACA;IACA;IAEA;IACAsB,kBAAA;MAAAC,GAAA;MAAAC;IAAA;MACA;IACA;IAEA;IACAC,eAAAF,GAAA;MACA,KAAAG,UAAA,CAAAH,GAAA,CAAAI,EAAA;IACA;IAEA;IACAC,eAAAC,IAAA;MACA,IAAAA,IAAA;MACA,IAAAA,IAAA;MACA;IACA;IAEA;IACAC,aAAAP,GAAA;MACA,IAAAA,GAAA,CAAAQ,aAAA,IAAAR,GAAA,CAAAS,MAAA;QACA;MACA;QACA;MACA;IACA;IAEA;IACAN,WAAAO,gBAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;QACAtC,IAAA;QACAuC,MAAA;UAAAT,EAAA,EAAAM;QAAA;MACA;IACA;IAEA;IACA,MAAAI,eAAAd,GAAA;MACA;QACA,MAAAe,UAAA,IAAAf,GAAA,CAAAe,UAAA;QACA,MAAA/B,GAAA,SAAAZ,OAAA;UACAa,GAAA,EAAAZ,MAAA,CAAAa,QAAA,wCAAAc,GAAA,CAAAI,EAAA;UACAjB,MAAA;QACA;QACA,IAAAH,GAAA,CAAAM,IAAA;UACAU,GAAA,CAAAe,UAAA,GAAAA,UAAA;UACA,KAAApB,QAAA,CAAAqB,OAAA,CAAAD,UAAA;QACA;UACA,KAAApB,QAAA,CAAAC,KAAA,CAAAZ,GAAA,CAAAa,GAAA;QACA;MACA,SAAAD,KAAA;QACAE,OAAA,CAAAF,KAAA,YAAAA,KAAA;QACA,KAAAD,QAAA,CAAAC,KAAA;MACA;IACA;IAEA;IACAqB,YAAAP,gBAAA;MACA,KAAAQ,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;QACAC,kBAAA;MACA,GAAAC,IAAA;QACA;UACA,MAAAvC,GAAA,SAAAZ,OAAA;YACAa,GAAA,EAAAZ,MAAA,CAAAa,QAAA,sCAAAwB,gBAAA;YACAvB,MAAA;UACA;UACA,IAAAH,GAAA,CAAAM,IAAA;YACA,KAAAK,QAAA,CAAAqB,OAAA;YACA,KAAAlC,UAAA;UACA;YACA,KAAAa,QAAA,CAAAC,KAAA,CAAAZ,GAAA,CAAAa,GAAA;UACA;QACA,SAAAD,KAAA;UACAE,OAAA,CAAAF,KAAA,UAAAA,KAAA;UACA,KAAAD,QAAA,CAAAC,KAAA;QACA;MACA,GAAA4B,KAAA;QACA,KAAA7B,QAAA,CAAA8B,IAAA;MACA;IACA;IAEA;IACAC,iBAAAC,GAAA;MACA,KAAAhD,QAAA,GAAAgD,GAAA;MACA,KAAAjD,OAAA;MACA,KAAAI,UAAA;IACA;IAEA;IACA8C,oBAAAD,GAAA;MACA,KAAAjD,OAAA,GAAAiD,GAAA;MACA,KAAA7C,UAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}